---
// B4 — The method, restaged 27 Aug 2026 to the owner-supplied dark mock:
// headline block with CTAs beside a drawn brief→direction panel, the four
// method steps as chained chevrons under HOW WE DO IT DIFFERENTLY, the
// unfair-advantage banner, and the BUILT DIFFERENTLY close with its stat
// pills. The mock's THE PROBLEM block was dropped at the owner's
// instruction (duplicate of the fault board). The desk scene is the mock's
// OWN artwork, cropped from the supplied design at the owner's direction
// ("copied exactly") — owner-supplied art, not stock. Icons are lucide
// geometry inlined as SVG.
// The prose visit story this replaces is in git history; P2/Q1 remain
// owner-held slots for a future block.

const steps = [
  { n: "01", title: "On site", body: "Time where you work, at your events, with your customers.", icon: "binoculars" },
  { n: "02", title: "The word survey", body: "The phrases your customers use that nobody’s competing for.", icon: "chat" },
  { n: "03", title: "Directions first", body: "Real options before any code — chosen by you.", icon: "pin" },
  { n: "04", title: "Open line", body: "Message me during the build; ideas fold in as they come.", icon: "mail" },
];
---

<section class="method" id="method">
  <div class="wrap method-wrap">
    <div class="m-top">
      <div class="m-copy" data-rv>
        <p class="t-micro m-eyebrow"><i></i>TURN INSIGHTS INTO GROWTH<i></i></p>
        <h2 class="m-h">
          A brief tells you what a business does.
          Not <em>why</em> anyone chooses&nbsp;them.
        </h2>
        <p class="m-sub">We find the difference. Then we turn it into direction.</p>
        <div class="m-ctas">
          <a class="m-btn m-btn-solid" href="#book">Book a discovery call
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7" /><path d="M8 7h9v9" /></svg>
          </a>
          <a class="m-btn m-btn-ghost" href="#process">See how we work
            <svg viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" /></svg>
          </a>
        </div>
      </div>

      <!-- the mock's own desk scene (owner-supplied artwork, cropped from
           the design itself): the laptop showing brief-to-direction, the
           marked mug, the lamp. Masked so it melts into the ink exactly as
           the mock's scene does. -->
      <div class="m-scene" data-rv aria-hidden="true">
        <img src="/images/method-scene.webp" alt="" width="479" height="436" loading="lazy" decoding="async" />
      </div>
    </div>

    <p class="t-micro m-steps-eyebrow" data-rv>HOW WE DO IT DIFFERENTLY</p>

    <ol class="m-steps" data-rv>
      {steps.map((step) => (
        <li class="m-hex">
          <div class="m-hex-in">
            <p class="t-micro m-hex-n">{step.n}</p>
            <div class="m-hex-icon">
              {step.icon === "binoculars" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="7" cy="15" r="3.5" /><circle cx="17" cy="15" r="3.5" /><path d="M10.5 15v-4.5a1.5 1.5 0 0 1 3 0V15" /><path d="M5 12.5 6.5 7a1.8 1.8 0 0 1 1.8-1.3h.4" /><path d="M19 12.5 17.5 7a1.8 1.8 0 0 0-1.8-1.3h-.4" /></svg>
              )}
              {step.icon === "chat" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /><path d="M8 9h8" /><path d="M8 12.5h5" /></svg>
              )}
              {step.icon === "pin" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0" /><circle cx="12" cy="10" r="3" /></svg>
              )}
              {step.icon === "mail" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" /></svg>
              )}
            </div>
            <h3 class="m-hex-title">{step.title}</h3>
            <p class="m-hex-body">{step.body}</p>
          </div>
        </li>
      ))}
    </ol>

    <div class="m-banner" data-rv>
      <p>It’s not just research. It’s your <em>unfair advantage.</em></p>
    </div>

    <div class="m-built" data-rv>
      <div class="m-built-copy">
        <p class="t-micro m-built-eyebrow">BUILT DIFFERENTLY</p>
        <h3 class="m-built-h">From conversations to <em>competitive&nbsp;edge.</em></h3>
        <p class="m-built-sub">For businesses that want more than “just a website”.</p>
      </div>
      <div class="m-stats">
        <div class="m-stat">
          <p class="m-stat-big">100%</p>
          <p class="m-stat-label">Independent</p>
        </div>
        <div class="m-stat">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M5 20v-6" /><path d="M10 20V10" /><path d="M15 20v-7" /><path d="M20 20V4" /></svg>
          <p class="m-stat-label">Insight-led</p>
        </div>
        <div class="m-stat">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.5" /><path d="M3 20c.9-3 3.2-4.5 6-4.5s5.1 1.5 6 4.5" /><circle cx="17" cy="7" r="2.5" /><path d="M17.5 12.5c2.2.3 3.7 1.6 4.3 3.9" /></svg>
          <p class="m-stat-label">Built around you</p>
        </div>
      </div>
    </div>

    <div class="m-close" data-rv>
      <a class="m-btn m-btn-solid" href="#book">Book a visit
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7" /><path d="M8 7h9v9" /></svg>
      </a>
      <p class="m-close-line">Let’s find what makes you different.</p>
    </div>
  </div>
</section>

<style>
  .method-wrap { max-width: 1560px; }
  .method {
    padding-block: 110px 96px;
    background:
      radial-gradient(900px 520px at 82% 8%, rgb(29 78 216 / 0.22), transparent 68%),
      radial-gradient(700px 380px at 50% 58%, rgb(29 78 216 / 0.08), transparent 72%),
      radial-gradient(1000px 560px at 14% 96%, rgb(29 78 216 / 0.14), transparent 72%),
      var(--color-ink-deep);
    color: var(--on-ink-body);
  }

  /* ---------- top: copy + drawn panel ---------- */
  .m-top {
    display: grid;
    grid-template-columns: minmax(380px, 7fr) 5fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }

  .m-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--color-cobalt-lift);
    letter-spacing: 0.4em;
  }
  .m-eyebrow i {
    width: 7px; height: 7px;
    rotate: 45deg;
    background: rgb(77 124 255 / 0.55);
  }

  .m-h {
    margin-top: 20px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.125rem, 3.4vw, 3.25rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--color-sheet);
    max-width: 15em;
  }
  .m-h em {
    font-style: italic;
    color: var(--color-cobalt-lift);
  }
  .m-sub {
    margin-top: 18px;
    font-size: 1.125rem;
    color: rgb(245 247 249 / 0.68);
  }

  .m-ctas { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 30px; }
  .m-btn {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 13px 26px;
    border-radius: 999px;
    font-size: 0.9688rem;
    font-weight: 500;
    text-decoration: none;
    transition: box-shadow 200ms var(--ease), background-color 200ms var(--ease), border-color 200ms var(--ease);
  }
  .m-btn svg { width: 15px; height: 15px; }
  .m-btn-solid {
    background: var(--color-cobalt);
    color: #fff;
    border: 1px solid rgb(77 124 255 / 0.7);
    box-shadow: 0 0 26px -8px rgb(77 124 255 / 0.7);
  }
  .m-btn-solid:hover { box-shadow: 0 0 42px -8px rgb(77 124 255 / 0.9); }
  .m-btn-ghost {
    background: rgb(245 247 249 / 0.04);
    color: var(--color-sheet);
    border: 1px solid rgb(245 247 249 / 0.22);
  }
  .m-btn-ghost:hover { border-color: rgb(77 124 255 / 0.7); }

  /* the mock's scene: no card, no border — the photograph's own glow is
     the lighting, and mask fades melt its cut edges into the ink the way
     the mock's scene sits in its ground */
  .m-scene { position: relative; }
  .m-scene img {
    display: block;
    width: 100%;
    height: auto;
    -webkit-mask-image:
      linear-gradient(90deg, transparent 0%, #000 14%),
      linear-gradient(180deg, #000 78%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(90deg, transparent 0%, #000 14%),
      linear-gradient(180deg, #000 78%, transparent 100%);
    mask-composite: intersect;
  }
  /* the lamp's spill, extended past the crop */
  .m-scene::after {
    content: "";
    position: absolute;
    inset: -20% -30% -20% 30%;
    background: radial-gradient(50% 45% at 78% 18%, rgb(77 124 255 / 0.16), transparent 70%);
    pointer-events: none;
  }

  /* ---------- the four steps ---------- */
  .m-steps-eyebrow {
    margin-top: 84px;
    text-align: center;
    color: rgb(245 247 249 / 0.55);
    letter-spacing: 0.42em;
  }
  .m-steps {
    list-style: none;
    padding: 0;
    margin: 36px 0 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    position: relative;
  }
  /* the glints in the joints between chevrons */
  .m-hex { position: relative; }
  .m-hex:not(:last-child)::after {
    content: "";
    position: absolute;
    top: 50%;
    right: -13px;
    width: 8px; height: 8px;
    translate: 0 -50%;
    rotate: 45deg;
    background: var(--color-cobalt-lift);
    box-shadow: 0 0 14px 2px rgb(77 124 255 / 0.8);
    z-index: 1;
  }
  /* chained chevrons: pointed both ends, drawn as a 1px cobalt shell with
     the panel inset inside the same clip */
  .m-hex {
    --notch: 26px;
    clip-path: polygon(var(--notch) 0, calc(100% - var(--notch)) 0, 100% 50%, calc(100% - var(--notch)) 100%, var(--notch) 100%, 0 50%);
    background: linear-gradient(180deg, rgb(77 124 255 / 0.35), rgb(77 124 255 / 0.75));
    padding: 1px;
    filter: drop-shadow(0 6px 22px rgb(29 78 216 / 0.3));
    transition: background-color 200ms var(--ease), filter 200ms var(--ease);
  }
  .m-hex:hover {
    background: rgb(77 124 255 / 0.9);
    filter: drop-shadow(0 6px 30px rgb(77 124 255 / 0.5));
  }
  .m-hex-in {
    clip-path: polygon(var(--notch) 0, calc(100% - var(--notch)) 0, calc(100% - 1px) 50%, calc(100% - var(--notch)) 100%, var(--notch) 100%, 1px 50%);
    background:
      radial-gradient(85% 70% at 50% 115%, rgb(29 78 216 / 0.28), transparent 72%),
      radial-gradient(80% 60% at 50% 0%, rgb(29 78 216 / 0.1), transparent 75%),
      var(--color-ink-deep);
    height: 100%;
    padding: 26px 34px 30px;
    text-align: center;
  }
  .m-hex-n { color: var(--color-cobalt-lift); }
  .m-hex-icon {
    margin: 14px auto 0;
    width: 52px; height: 52px;
    display: grid; place-items: center;
    border: 1px solid rgb(77 124 255 / 0.5);
    border-radius: 50%;
    color: var(--color-cobalt-lift);
  }
  .m-hex-icon svg { width: 26px; height: 26px; }
  .m-hex-title {
    margin-top: 14px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1875rem;
    color: var(--color-sheet);
  }
  .m-hex-body {
    margin-top: 10px;
    font-size: 0.875rem;
    line-height: 1.55;
    color: rgb(245 247 249 / 0.62);
  }

  /* ---------- banner ---------- */
  .m-banner {
    margin-top: 56px;
    border: 1px solid rgb(77 124 255 / 0.4);
    border-radius: 14px;
    background: rgb(29 78 216 / 0.07);
    box-shadow: 0 0 60px -24px rgb(77 124 255 / 0.5);
    padding: 26px 32px;
    text-align: center;
  }
  .m-banner p {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.25rem, 1.9vw, 1.75rem);
    color: var(--color-sheet);
  }
  .m-banner em { font-style: italic; color: var(--color-cobalt-lift); }

  /* ---------- built differently ---------- */
  .m-built {
    margin-top: 84px;
    display: grid;
    grid-template-columns: minmax(340px, 7fr) 5fr;
    gap: clamp(28px, 4vw, 64px);
    align-items: center;
  }
  .m-built-eyebrow { color: var(--color-cobalt-lift); letter-spacing: 0.4em; }
  .m-built-h {
    margin-top: 16px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.75rem, 2.8vw, 2.625rem);
    line-height: 1.1;
    color: var(--color-sheet);
  }
  .m-built-h em { font-style: italic; color: var(--color-cobalt-lift); }
  .m-built-sub { margin-top: 14px; font-size: 1.0625rem; }

  .m-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 1px solid rgb(245 247 249 / 0.14);
    border-radius: 16px;
    background: rgb(245 247 249 / 0.03);
    padding: 26px 8px;
  }
  .m-stat {
    text-align: center;
    padding-inline: 12px;
  }
  .m-stat + .m-stat { border-left: 1px solid rgb(245 247 249 / 0.12); }
  .m-stat-big {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 2rem;
    line-height: 1.1;
    color: var(--color-sheet);
  }
  .m-stat svg {
    width: 30px; height: 30px;
    margin-bottom: 4px;
    color: var(--color-cobalt-lift);
  }
  .m-stat-label {
    margin-top: 6px;
    font-size: 0.875rem;
    color: rgb(245 247 249 / 0.65);
  }

  .m-close {
    margin-top: 44px;
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }
  .m-close-line { color: rgb(245 247 249 / 0.65); }

  /* ---------- responsive ---------- */
  @media (max-width: 1080px) {
    .m-steps { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 860px) {
    .m-top, .m-built { grid-template-columns: 1fr; }
    .m-panel { max-width: 520px; }
  }
  @media (max-width: 620px) {
    .method { padding-block: 88px 80px; }
    .m-steps { grid-template-columns: 1fr; }
    .m-hex { --notch: 20px; }
  }
</style>
