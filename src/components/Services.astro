---
// B5 — Services, restaged 27 Aug 2026 (owner's directive): the separate
// WHAT I DO light section is gone — its information now lives on the
// Directions stage itself, arranged around the folder. The folder stays
// central; the flagship websites story flanks it (the offer on the left,
// the word survey and outcome on the right), and the three subordinate
// services run as a strip along the band's foot. One dark stage, one
// story: what I do, demonstrated live in the middle of it.
import FolderGallery from "./directions/FolderGallery";

const strip = [
  { num: "02", name: "CUSTOM SOFTWARE", body: "Internal tools built round how you actually run the job.", price: "From £6,000" },
  { num: "03", name: "LOCAL SEO", body: "Found by people nearby who are ready to buy.", price: "From £450/mo" },
  { num: "04", name: "RESEARCH & STRATEGY", body: "Analysis you can act on — and defend.", price: "Per engagement" },
];
---

<section class="services g-ink dband" id="services">
  <div class="wrap services-wrap">
    <header class="sv-head" data-rv>
      <h2 class="sv-h">Your judgement, my&nbsp;execution.</h2>
      <p class="sv-subhead">
        Every job starts as real, working directions — not mockups. Open the folder,
        try three, and the one that feels right gets&nbsp;built.
      </p>
    </header>

    <div class="sv-stage">
      <div class="sv-side sv-side-left" data-rv>
        <div class="sv-kicker">
          <span class="t-mono">01 / WEBSITES</span>
          <span class="t-mono sv-price">FROM £3,000</span>
        </div>
        <h3 class="sv-h3">Designed with you, not presented to&nbsp;you.</h3>
        <p class="sv-body">
          You see two or three real directions before a line of code is written — not one
          mockup to approve at the end. You tell me what’s wrong with them. That’s where the
          site starts to become yours. Then it gets built, and the line stays open the whole
          way: if you have a better idea in week three, I want to hear it.
        </p>
      </div>

      <div class="sv-folder">
        <FolderGallery client:idle />
      </div>

      <div class="sv-side sv-side-right" data-rv>
        <p class="t-micro sv-label">INCLUDED — THE WORD SURVEY</p>
        <p class="sv-body">
          Every site is built from the words your customers actually use — including the
          ones nobody in your area is competing for. Found on the visits, listed in your
          written scope, and built into the page from day one.
        </p>
        <div class="sv-outcome">
          <span class="t-micro">OUTCOME</span>
          <strong>A site nobody else could have</strong>
        </div>
        <a class="sv-link" href="#work">See the work →</a>
      </div>
    </div>

    <div class="demo-captions">
      <p class="t-micro">SAME FORGE. THREE DIFFERENT COMPANIES. NONE OF THEM WRONG.</p>
      <p class="t-micro">THE ONE THAT FEELS RIGHT IS THE ONE THAT GETS BUILT.</p>
      <p class="t-micro">
        <a class="caption-link" href="#work">WREKIN FORGE IS A DEMONSTRATION — DAVID JACKSON &amp; SON GOT THE REAL THING ↓</a>
      </p>
    </div>

    <div class="strip" data-rv>
      {strip.map((s) => (
        <div class="strip-item">
          <p class="t-mono strip-name">{s.num} / {s.name}</p>
          <p class="strip-body">{s.body}</p>
          <p class="t-mono strip-price">{s.price}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .services {
    padding-block: 96px;
    background: var(--color-ink-deep);
    /* dragged cards may travel past the viewport edge */
    overflow-x: clip;
  }
  .services-wrap { max-width: 1560px; }

  /* ---------- head ---------- */
  .sv-head { text-align: center; }
  .sv-subhead {
    margin: 16px auto 0;
    max-width: 44em;
    font-size: clamp(1rem, 0.95vw, 1.375rem);
    line-height: 1.6;
    color: rgb(245 247 249 / 0.62);
  }
  .sv-h {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2rem, 2.6vw, 3.25rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--color-sheet);
  }

  /* ---------- the stage: info flanking the central folder ---------- */
  .sv-stage {
    margin-top: 40px;
    display: grid;
    grid-template-columns: minmax(280px, 1fr) minmax(520px, 640px) minmax(280px, 1fr);
    gap: clamp(24px, 3vw, 56px);
    align-items: center;
  }
  /* the folder keeps the centre; its fan and enlargement pass over the
     side columns by their own z-order */
  .sv-folder { min-width: 0; }

  .sv-side { color: rgb(245 247 249 / 0.68); }

  .sv-kicker {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    color: var(--color-sheet);
  }
  .sv-price { color: rgb(245 247 249 / 0.55); }
  .sv-h3 {
    margin-top: 14px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.25rem, 1.35vw, 1.75rem);
    line-height: 1.25;
    color: var(--color-sheet);
  }
  .sv-body {
    margin-top: 12px;
    font-size: clamp(0.9375rem, 0.85vw, 1.125rem);
    line-height: 1.65;
  }
  .sv-label { color: var(--color-cobalt-lift); margin-bottom: 10px; }
  .sv-outcome {
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid rgb(245 247 249 / 0.16);
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }
  .sv-outcome .t-micro { color: rgb(245 247 249 / 0.55); }
  .sv-outcome strong { font-weight: 500; color: var(--color-sheet); }
  .sv-link {
    display: inline-block;
    margin-top: 14px;
    color: var(--color-cobalt-lift);
    text-decoration: none;
    transition: color 180ms var(--ease);
  }
  .sv-link:hover { color: var(--color-sheet); }

  .demo-captions {
    margin-top: 40px;
    display: grid;
    gap: 8px;
    text-align: center;
    padding-inline: 24px;
  }
  .demo-captions .t-micro { color: rgb(245 247 249 / 0.6); }
  .caption-link {
    color: rgb(245 247 249 / 0.6);
    text-decoration: none;
    transition: color 180ms var(--ease);
  }
  .caption-link:hover { color: var(--color-amber); }

  /* ---------- subordinate strip on the band's foot ---------- */
  .strip {
    margin-top: 56px;
    padding-top: 40px;
    border-top: 1px solid rgb(245 247 249 / 0.14);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }
  .strip-item { padding: 8px 32px; }
  .strip-item:first-child { padding-left: 0; }
  .strip-item + .strip-item { border-left: 1px solid rgb(245 247 249 / 0.14); }
  .strip-name { color: var(--color-sheet); }
  .strip-body { color: rgb(245 247 249 / 0.62); font-size: 0.9375rem; margin-top: 8px; max-width: 26em; }
  .strip-price { color: rgb(245 247 249 / 0.55); margin-top: 12px; }

  /* ---------- responsive ---------- */
  @media (max-width: 1100px) {
    .sv-stage { grid-template-columns: 1fr; }
    .sv-folder { order: -1; }
    .sv-side { max-width: 560px; margin-inline: auto; }
  }
  @media (max-width: 767.98px) {
    .services { padding-block: 64px; }
    .strip { grid-template-columns: 1fr; margin-top: 48px; }
    .strip-item { padding: 20px 0; }
    .strip-item + .strip-item { border-left: 0; border-top: 1px solid rgb(245 247 249 / 0.14); }
  }
</style>
