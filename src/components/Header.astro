---
// Header (§6) — sticky, 68px. Every nav target lives on this page, so below
// 820px the nav simply hides and the button carries on: no hamburger.
---

<header class="site-head">
  <div class="wrap head-row">
    <a class="brand" href="/" aria-label="Talon Insights — home">
      <img src="/images/mark.webp" alt="" width="158" height="132" />
      <span class="wordmark">Talon<i>Insights</i></span>
    </a>
    <nav class="nav" aria-label="Primary">
      <a href="#work">Work</a>
      <a href="#method">Approach</a>
      <a href="#pricing">Pricing</a>
      <a href="#about">About</a>
    </nav>
    <a class="btn btn-primary" href="#book">Book a visit</a>
  </div>
</header>

<style>
  .site-head {
    position: sticky;
    top: 0;
    z-index: 100;
    height: 68px;
    background: rgb(245 247 249 / 0.85);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-bottom: var(--hairline);
  }
  .head-row {
    height: 68px;
    display: flex;
    align-items: center;
    gap: 32px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--color-ink);
  }
  .brand img {
    width: 26px;
    height: auto;
    display: block;
    /* mark.webp is white-with-cobalt for dark grounds (it stands as-is in
       the ink Close section); this flips it ink-dark for the light header
       while the hue-rotate returns the feather sweep to blue. */
    filter: invert(1) hue-rotate(180deg);
  }
  .wordmark { font-size: 1.125rem; font-weight: 500; letter-spacing: -0.01em; }
  .wordmark i { font-style: italic; font-weight: 500; }

  .nav {
    margin-left: auto;
    display: flex;
    gap: 32px;
  }
  .nav a {
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--color-ink);
    transition: color 180ms var(--ease);
  }
  .nav a:hover { color: var(--color-cobalt); }

  @media (max-width: 819.98px) {
    .nav { display: none; }
    .site-head .btn { margin-left: auto; }
  }
</style>
