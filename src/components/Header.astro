---
// Header (§6) — sticky, 68px, and dark (27 Aug: the owner wants the site's
// undertone darker, starting here). It floats its ink-black surface over
// every section as the page scrolls. 28 Aug (owner: "no dropdown visible
// on mobile"): now that the nav targets are real pages, below 820px a
// hamburger opens a dropdown of the same links — the old nav-just-hides
// rule died with the single-page era.
---

<header class="site-head" id="top">
  <div class="wrap head-row">
    <a class="brand" href="/" aria-label="Talon Insights — home">
      <img src="/images/mark.webp" alt="" width="158" height="132" />
      <span class="wordmark">Talon<i>Insights</i></span>
    </a>
    <nav class="nav" aria-label="Primary">
      <a href="/">Home</a>
      <a href="/work">Work</a>
      <a href="/pricing">Pricing</a>
      <a href="/about">About</a>
    </nav>
    <a class="btn btn-primary" href="/booking">Book a visit</a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-menu" aria-label="Open the menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
        <path class="nt-bars" d="M4 7h16M4 12h16M4 17h16" />
        <path class="nt-x" d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </div>
  <nav class="nav-drop" id="site-menu" aria-label="Primary, mobile">
    <a href="/">Home</a>
    <a href="/work">Work</a>
    <a href="/pricing">Pricing</a>
    <a href="/about">About</a>
  </nav>
</header>

<script>
  /* Over the hero the header sheds its surface (owner's directive, 27 Aug
     pm): transparent until the hero has passed all the way under it, then
     the ink surface returns. Failsafe orientation, per the house rule:
     the SOLID header is the default — readable over every section — and
     transparency is applied by script only while the hero is actually in
     view, so environments where IO never fires simply keep the safe
     surface. The observer's top inset is the header's own 68px, so
     "past" means past the header's bottom edge, not the viewport's top. */
  const head = document.querySelector(".site-head");
  const hero = document.querySelector(".hero");
  if (head && hero && "IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      ([entry]) => head.classList.toggle("site-head--clear", entry.isIntersecting),
      { rootMargin: "-68px 0px 0px 0px" }
    );
    io.observe(hero);
  }

  /* The mobile menu. Same failsafe stance: closed is the default pose and
     only this script opens it, so a script-dead environment shows the bar
     it always showed. Closes on link choice, Escape (focus returned),
     any press outside the header, and on growing past the breakpoint. */
  const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
  if (head && toggle) {
    const setOpen = (open: boolean) => {
      head.classList.toggle("menu-open", open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close the menu" : "Open the menu");
    };
    toggle.addEventListener("click", () => setOpen(!head.classList.contains("menu-open")));
    document.querySelectorAll(".nav-drop a").forEach((a) =>
      a.addEventListener("click", () => setOpen(false))
    );
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && head.classList.contains("menu-open")) {
        setOpen(false);
        toggle.focus();
      }
    });
    document.addEventListener("pointerdown", (e) => {
      if (head.classList.contains("menu-open") && !head.contains(e.target as Node)) setOpen(false);
    });
    window.matchMedia("(min-width: 820px)").addEventListener("change", (mq) => {
      if (mq.matches) setOpen(false);
    });
  }
</script>

<style>
  .site-head {
    position: sticky;
    top: 0;
    z-index: 100;
    height: 68px;
    background: color-mix(in srgb, var(--color-ink-deep) 85%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-bottom: var(--hairline-dark);
    transition: background-color 240ms var(--ease), border-color 240ms var(--ease);
  }
  /* the clear state: no surface, no rule, no blur — the hero's own ground
     shows through until it has fully passed. An open menu overrides it:
     links need a surface to sit on. */
  .site-head--clear:not(.menu-open) {
    background: transparent;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    border-bottom-color: transparent;
  }
  .head-row {
    height: 68px;
    display: flex;
    align-items: center;
    gap: 32px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--color-sheet);
  }
  /* mark.webp is white-with-cobalt — at home on the dark header at last. */
  .brand img { width: 26px; height: auto; display: block; }
  .wordmark { font-size: 1.125rem; font-weight: 500; letter-spacing: -0.01em; }
  .wordmark i { font-style: italic; font-weight: 500; }

  .nav {
    margin-left: auto;
    display: flex;
    gap: 32px;
  }
  .nav a {
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    color: rgb(245 247 249 / 0.85);
    transition: color 180ms var(--ease);
  }
  .nav a:hover { color: var(--color-cobalt-lift); }

  /* ---------- the mobile menu ---------- */
  .nav-toggle {
    display: none;
    width: 44px; /* touch minimum */
    height: 44px;
    padding: 0;
    background: none;
    border: 0;
    color: var(--color-sheet);
    cursor: pointer;
  }
  .nav-toggle svg { width: 24px; height: 24px; display: block; margin-inline: auto; }
  .nav-toggle .nt-x { display: none; }
  .menu-open .nav-toggle .nt-bars { display: none; }
  .menu-open .nav-toggle .nt-x { display: block; }

  .nav-drop {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    flex-direction: column;
    background: var(--color-ink-deep);
    border-bottom: var(--hairline-dark);
    padding: 8px 24px 16px;
  }
  .menu-open .nav-drop { display: flex; }
  .nav-drop a {
    padding: 14px 0;
    font-size: 1.125rem;
    font-weight: 500;
    text-decoration: none;
    color: rgb(245 247 249 / 0.85);
    border-bottom: 1px solid rgb(245 247 249 / 0.08);
    transition: color 180ms var(--ease);
  }
  .nav-drop a:last-child { border-bottom: 0; }
  .nav-drop a:hover { color: var(--color-cobalt-lift); }

  @media (max-width: 819.98px) {
    .nav { display: none; }
    .site-head .btn { margin-left: auto; }
    .nav-toggle { display: block; }
  }
</style>
