---
// B6 — Case study + evidence (id="work").
// Restaged 27 Aug (owner): the section joins the dark run — ink-deep ground,
// copy left, and the live DJ homepage capture (owner-supplied, like the
// hero's WulfTek shot) projected on the right with the hero's own recipe.
// Copy updated to the shipped 12-page site (the configurator claim is gone —
// the built site answers questions instead: consent checker, guides,
// materials in plain terms).
// Gated assets, absent by rule (§8) — no placeholders ever:
//  · W1 WulfTek vignette: omitted entirely until WulfTek's explicit nod.
//    Copy is final in the master build doc §6/B6; drop it in verbatim then.
//  · V1 planner capture: omitted until the 8–12s recording exists
//    (mono strip + bordered video + "Try the full demo" link when it lands).

const movements = [
  {
    head: "What I found",
    body: "Work of a standard that ends up in listed buildings — and a website that said “joinery services”. The gap between the two was the whole brief, and it only became visible in the workshop.",
  },
  {
    head: "What it changed",
    body: "The site had to lead with the making, not the categories: the work photographed in progress, the one credential most joiners can’t claim — approved Accoya manufacturer — moved to the front, and the question that stops people ringing answered on the page. That was one of the real directions Harry saw before any code existed — the same stage the demonstration above walks you through. He pulled it apart, and the site got better for it.",
  },
  {
    head: "What got built",
    body: "A twelve-page site designed from scratch — the consent checker, the heritage guides, the materials in plain terms — and, because I was in there anyway, something else: production was planned on paper. So I built the planner too.",
  },
];
---

<section class="case g-ink" id="work">
  <div class="case-wrap">
    <div class="case-grid">
      <div class="case-copy">
        <p class="t-micro eyebrow">SELECTED WORK</p>
        <h2 class="t-h2">David Jackson &amp;&nbsp;Son</h2>
        <p class="t-mono case-meta">MANUFACTURING · WEBSITE + INTERNAL TOOL + STRATEGY</p>

        <div class="movements" data-rv>
          {movements.map((m) => (
            <div class="movement">
              <h3 class="t-h3">{m.head}</h3>
              <p>{m.body}</p>
            </div>
          ))}
        </div>

        <p class="case-link" data-rv>
          <a class="link" href="/work/david-jackson-son">Read the full case study →</a>
        </p>
      </div>

      <!-- the live homepage, leaning the way the hero's WulfTek panel does:
           perspective → rotateX → skewX, each on its own nested element
           (nested transforms flatten independently — one combined transform
           cannot reproduce the lean) -->
      <div class="case-shot" data-rv>
        <div class="case-shot-tilt">
          <div class="case-shot-skew">
            <img
              src="/images/work-dj-home.webp"
              width={1895}
              height={824}
              loading="lazy"
              decoding="async"
              alt="The David Jackson & Son homepage — “Windows made the way the house was made.”"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .case {
    padding-block: 120px;
    background: var(--color-ink-deep); /* joins the dark run above */
    overflow: hidden; /* the skew's overhang, absorbed by the headroom below,
                         must never widen the page */
  }
  .case-wrap {
    max-width: 1560px; /* the faults/method wrap — must match */
    margin-inline: auto;
    padding-inline: 24px;
  }
  .case-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(40px, 5vw, 88px);
    align-items: center;
  }

  .case-meta { color: rgb(245 247 249 / 0.45); margin-top: 4px; }

  .movements {
    margin-top: 44px;
    display: grid;
    gap: 32px;
  }
  .movement .t-h3 { margin-bottom: 10px; }
  .movement p { font-size: 1rem; max-width: 44em; }

  .case-link { margin-top: 40px; }

  /* ---------- the shot ---------- */
  .case-shot {
    /* shear headroom: skewX throws the panel's lower corners right of its
       static box — hand the projection room instead of clipping it (the
       hero's hard-won rule: masks/clips sized to a static box swallow 3D
       overhang) */
    padding-right: clamp(32px, 4vw, 96px);
  }
  .case-shot-tilt {
    perspective: 1200px;
  }
  .case-shot-skew {
    transform: rotateX(20deg);
  }
  .case-shot-skew img {
    display: block;
    width: 100%;
    height: auto;
    transform: skewX(0.36rad);
    /* the border rides the projected plane — a framed panel, leaning */
    border: 1px solid rgb(245 247 249 / 0.18);
    border-radius: 10px;
    box-shadow:
      0 40px 90px -30px rgb(0 0 0 / 0.6),
      0 12px 30px -12px rgb(0 0 0 / 0.5);
    background: var(--color-ink-deep);
  }

  @media (max-width: 899.98px) {
    .case { padding-block: 96px; }
    .case-grid { grid-template-columns: 1fr; gap: 48px; }
    .movements { gap: 28px; }
    .movement p { max-width: 34em; }
    /* flat below the split, like the hero's panel */
    .case-shot { padding-right: 0; }
    .case-shot-tilt { perspective: none; }
    .case-shot-skew { transform: none; }
    .case-shot-skew img { transform: none; }
  }
</style>
