---
// B6 — Case study + evidence (id="work").
// Restaged 27 Aug (owner, two passes): dark ground, copy left, the live DJ
// homepage capture right — first with the hero's old projection, then
// STRAIGHT (the hero's own lesson caught up with it: a skewed capture
// reads as texture, and this section exists to be proof). The capture now
// sits in a browser frame — dots, the real domain, a LIVE mark — with a
// mono fact strip beneath, and the movements read down a numbered rail
// with the neon cobalt numerals the fault board established.
// Gated assets, absent by rule (§8) — no placeholders ever:
//  · W1 WulfTek vignette: omitted entirely until WulfTek's explicit nod.
//  · V1 planner capture: omitted until the 8–12s recording exists.

const movements = [
  {
    num: "01",
    head: "What I found",
    body: "Work of a standard that ends up in listed buildings — and a website that said “joinery services”. The gap between the two was the whole brief, and it only became visible in the workshop.",
  },
  {
    num: "02",
    head: "What it changed",
    body: "The site had to lead with the making, not the categories: the work photographed in progress, the one credential most joiners can’t claim — approved Accoya manufacturer — moved to the front, and the question that stops people ringing answered on the page. That was one of the real directions Harry saw before any code existed — the same stage the demonstration above walks you through. He pulled it apart, and the site got better for it.",
  },
  {
    num: "03",
    head: "What got built",
    body: "A twelve-page site designed from scratch — the consent checker, the heritage guides, the materials in plain terms — and, because I was in there anyway, something else: production was planned on paper. So I built the planner too.",
  },
];
---

<section class="case g-ink" id="work">
  <div class="case-wrap">
    <div class="case-grid">
      <div class="case-copy">
        <p class="t-micro eyebrow">SELECTED WORK</p>
        <h2 class="t-h2">David Jackson &amp;&nbsp;Son</h2>
        <p class="t-mono case-meta">MANUFACTURING · WEBSITE + INTERNAL TOOL + STRATEGY</p>

        <div class="movements" data-rv>
          {movements.map((m) => (
            <div class="movement">
              <span class="m-num t-mono" aria-hidden="true">{m.num}</span>
              <h3 class="t-h3">{m.head}</h3>
              <p>{m.body}</p>
            </div>
          ))}
        </div>

        <p class="case-link" data-rv>
          <a class="link" href="/work/david-jackson-son">Read the full case study →</a>
        </p>
      </div>

      <!-- the live homepage, straight-on in a browser frame: the same
           chrome fiction the Wrekin Forge pages use, here declaring a
           real, live site -->
      <div class="case-shot" data-rv>
        <figure class="case-frame">
          <div class="case-chrome" aria-hidden="true">
            <span class="case-dots"><i /><i /><i /></span>
            <span class="case-url t-mono">davidjacksonandson.com</span>
            <span class="case-live t-mono">● LIVE</span>
          </div>
          <img
            src="/images/work-dj-home.webp"
            width={1895}
            height={824}
            loading="lazy"
            decoding="async"
            alt="The David Jackson & Son homepage — “Windows made the way the house was made.”"
          />
        </figure>
        <p class="case-facts t-mono" aria-label="What shipped">
          TWELVE PAGES<i>◆</i>CONSENT CHECKER<i>◆</i>HERITAGE GUIDES<i>◆</i>PRODUCTION PLANNER
        </p>
      </div>
    </div>

    <!-- the outcome, moved from the directions stage (27 Aug, owner:
         "loud and proud") — the claim belongs under the delivered proof -->
    <div class="case-outcome" data-rv>
      <p class="outcome-rule" aria-hidden="true"><i>◆</i><span class="t-micro">OUTCOME</span><i>◆</i></p>
      <p class="outcome-line">A site nobody else could&nbsp;have.</p>
    </div>
  </div>
</section>

<style>
  .case {
    padding-block: 120px;
    /* the method section's ground language (owner: keep the ink from
       going monotonous): cobalt washes breathing through ink-deep —
       here the light pools behind the evidence frame on the right, with
       a low answering wash under the copy */
    background:
      radial-gradient(1000px 560px at 78% 34%, rgb(29 78 216 / 0.2), transparent 68%),
      radial-gradient(700px 400px at 50% 88%, rgb(29 78 216 / 0.08), transparent 72%),
      radial-gradient(820px 460px at 10% 12%, rgb(29 78 216 / 0.13), transparent 70%),
      var(--color-ink-deep);
  }
  .case-wrap {
    max-width: 1560px; /* the faults/method wrap — must match */
    margin-inline: auto;
    padding-inline: 24px;
  }
  .case-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(40px, 5vw, 88px);
    align-items: center;
  }

  .case-meta { color: rgb(245 247 249 / 0.5); margin-top: 4px; }

  /* ---------- the movements: a numbered rail ---------- */
  .movements {
    margin-top: 44px;
    display: grid;
    gap: 36px;
  }
  .movement {
    position: relative;
    padding-left: 56px;
  }
  /* the rail: a hairline dropping from each numeral to the next */
  .movement::before {
    content: "";
    position: absolute;
    left: 13px;
    top: 36px;
    bottom: -36px;
    width: 1px;
    background: rgb(245 247 249 / 0.14);
  }
  .movement:last-child::before { display: none; }
  /* neon numerals — the fault board's glowing-figure language */
  .m-num {
    position: absolute;
    left: 0;
    top: 1px;
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-cobalt-lift);
    text-shadow: 0 0 14px rgb(77 124 255 / 0.55);
  }
  .movement .t-h3 { margin-bottom: 10px; }
  /* the readability pass: fuller weight, brighter body, looser leading */
  .movement p {
    font-size: 1.1875rem;
    font-weight: 400;
    line-height: 1.65;
    color: rgb(245 247 249 / 0.78);
    max-width: 44em;
  }

  .case-link { margin-top: 40px; }

  /* ---------- the shot ---------- */
  .case-frame {
    margin: 0;
    border: 1px solid rgb(245 247 249 / 0.16);
    border-radius: 12px;
    overflow: hidden;
    background: rgb(245 247 249 / 0.03);
    box-shadow:
      0 40px 90px -30px rgb(0 0 0 / 0.6),
      0 12px 30px -12px rgb(0 0 0 / 0.5);
    transition: border-color 220ms var(--ease), box-shadow 220ms var(--ease);
  }
  .case-shot:hover .case-frame {
    border-color: rgb(77 124 255 / 0.45);
    box-shadow:
      0 40px 90px -30px rgb(0 0 0 / 0.7),
      0 0 40px -8px rgb(77 124 255 / 0.25);
  }
  .case-chrome {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 11px 16px;
    background: rgb(245 247 249 / 0.05);
    border-bottom: 1px solid rgb(245 247 249 / 0.1);
  }
  .case-dots { display: inline-flex; gap: 6px; }
  .case-dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgb(245 247 249 / 0.18);
  }
  .case-url {
    flex: 1;
    text-align: center;
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    color: rgb(245 247 249 / 0.5);
  }
  .case-live {
    font-size: 0.8125rem;
    letter-spacing: 0.12em;
    color: var(--color-cobalt-lift);
    text-shadow: 0 0 10px rgb(77 124 255 / 0.5);
  }
  .case-frame img {
    display: block;
    width: 100%;
    height: auto;
  }
  /* what shipped, in one mono line under the evidence */
  .case-facts {
    margin-top: 16px;
    text-align: center;
    font-size: 0.875rem;
    letter-spacing: 0.14em;
    color: rgb(245 247 249 / 0.55);
  }
  .case-facts i {
    font-style: normal;
    margin-inline: 12px;
    font-size: 0.5625rem;
    vertical-align: 1px;
    color: rgb(77 124 255 / 0.7);
  }

  /* ---------- the outcome ---------- */
  .case-outcome {
    margin-top: 88px;
    text-align: center;
  }
  .outcome-rule {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .outcome-rule .t-micro {
    font-size: 1.125rem; /* the word is part of the statement, not a caption */
    font-weight: 600;
    color: var(--color-cobalt-lift);
    letter-spacing: 0.4em;
  }
  .outcome-rule i {
    font-style: normal;
    flex: 1;
    position: relative;
    height: 1px;
    background: rgb(245 247 249 / 0.14);
    color: rgb(77 124 255 / 0.8);
    font-size: 0.75rem;
    line-height: 0;
  }
  /* diamond tips on the hairlines, drawn as the glyphs they are */
  .outcome-rule i::before {
    content: "◆";
    position: absolute;
    top: 0.5px;
    translate: 0 -50%;
  }
  .outcome-rule i:first-child::before { left: 0; }
  .outcome-rule i:last-child::before { right: 0; }
  .outcome-line {
    margin-top: 26px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2rem, 3.4vw, 4rem);
    line-height: 1.08;
    letter-spacing: -0.015em;
    color: var(--color-sheet);
  }

  @media (max-width: 899.98px) {
    .case { padding-block: 96px; }
    .case-outcome { margin-top: 64px; }
    .case-grid { grid-template-columns: 1fr; gap: 48px; }
    .movements { gap: 30px; }
    .movement { padding-left: 44px; }
    .movement::before { bottom: -30px; }
    .movement p { max-width: 34em; font-size: 1.0625rem; }
    .case-facts { letter-spacing: 0.1em; }
    .case-facts i { margin-inline: 8px; }
  }
</style>
