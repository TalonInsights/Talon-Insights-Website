---
// B7 — Process (id="process"), restaged 27 Aug (owner) and made to earn
// its keep the same night: the five steps are an undated GANTT — bars
// sized by how long each stage really runs — with each stage's
// description on the right. Three things make it a schedule rather than
// five stripes: a PRICE FIXED milestone stands where the build begins
// (the heading's whole claim, drawn), each bar hangs off the end of the
// one before it by a dropped connector, and hovering either a bar or its
// description lights both (pure CSS :has() — no JS). Bars are still
// signature #3: they draw on first scroll-in via the [data-process]
// hooks in Base (pb-armed / pb-draw, IO + 2.5s failsafe). Geometry lives
// in nth-child CSS — no style attributes under the hashed CSP.

const steps = [
  { num: "01", name: "A CALL", bar: "CALL", body: "Fifteen minutes to see whether it’s worth going further.", chip: "FREE", amber: false },
  { num: "02", name: "TIME ON SITE", bar: "TIME ON SITE", body: "I spend time where you work, at your events, with your customers — and write down how you work and the words they use.", chip: "FREE", amber: false },
  { num: "03", name: "DIRECTIONS", bar: "DIRECTIONS", body: "Two or three real design directions. You pick, and you pull them apart.", chip: "YOU CHOOSE", amber: true },
  { num: "04", name: "BUILD", bar: "BUILD", body: "Milestones against real dates, with the line open for ideas throughout.", chip: "OPEN LINE", amber: false },
  { num: "05", name: "YOURS", bar: "YOURS", body: "Domain, code and content are yours on full payment, plus a warranty period.", chip: "YOU OWN IT", amber: true },
];
---

<section class="process g-ink" id="process">
  <div class="process-wrap">
    {/* "stages of the job" here, "steps to the price" on /pricing — the
        two five-part sections were reading as the same list (owner, 28
        Aug); the vocabulary split is the differentiator. */}
    <h2 class="t-h2">The whole job, stage by stage — on one&nbsp;schedule.</h2>

    <div class="process-grid">
      <!-- the schedule: no dates, just honest proportion — and the one
           milestone that matters, standing exactly where the build begins -->
      <div class="gantt-box">
        <i class="g-mark-line" aria-hidden="true"></i>
        <span class="g-mark-label t-mono" aria-hidden="true"><b>◆</b> PRICE FIXED</span>
        <ol class="gantt" data-process aria-label="The five stages of a project in sequence — bar length shows each stage’s share of the whole, and the price is fixed before the build bar begins">
          {steps.map((step) => (
            <li class="g-row">
              <span class="g-label t-mono"><b>{step.num}</b> {step.bar}</span>
              <span class="g-track" aria-hidden="true">
                <span class="g-bar"><span class="fill"></span></span>
              </span>
            </li>
          ))}
        </ol>
      </div>

      <ol class="step-list">
        {steps.map((step) => (
          <li class="step">
            <p class="t-mono step-name"><b>{step.num}</b> {step.name}</p>
            <p class="step-body">{step.body}</p>
            <span class={`chip t-micro ${step.amber ? "chip-amber" : ""}`}>{step.chip}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .process {
    background: var(--color-ink-deep); /* the dark run continues */
    border-top: 1px solid rgb(245 247 249 / 0.08);
    padding-block: 96px;
  }
  .process-wrap {
    max-width: 1560px; /* matches faults/method/case */
    margin-inline: auto;
    padding-inline: 24px;
  }

  .process-grid {
    margin-top: 56px;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(40px, 5vw, 96px);
    align-items: center;
  }

  /* ---------- the gantt ---------- */
  /* headroom for the milestone label; the box, not the ol, is the
     positioning context so the marker can span every row */
  .gantt-box {
    position: relative;
    padding-top: 42px;
  }
  .gantt {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 30px;
  }
  .g-row {
    display: grid;
    grid-template-columns: 172px minmax(0, 1fr);
    align-items: center;
    gap: 18px;
  }
  .g-label {
    font-size: 0.9375rem;
    letter-spacing: 0.08em;
    color: rgb(245 247 249 / 0.6);
    white-space: nowrap;
    transition: color 180ms ease;
  }
  .g-label b { color: var(--color-sheet); font-weight: 700; }

  /* the milestone: the heading, drawn. x = label column (172) + gap (18)
     + 50% of the track — where the BUILD bar begins. 95 = (172+18)/2. */
  .g-mark-line {
    position: absolute;
    left: calc(95px + 50%);
    top: 32px;
    bottom: 2px;
    width: 0;
    border-left: 1px dashed rgb(77 124 255 / 0.5);
  }
  .g-mark-label {
    position: absolute;
    left: calc(95px + 50%);
    top: 0;
    transform: translateX(-50%);
    white-space: nowrap;
    font-size: 0.9375rem;
    letter-spacing: 0.18em;
    color: var(--color-cobalt-lift);
  }
  .g-mark-label b {
    font-weight: 400;
    text-shadow: 0 0 12px rgb(77 124 255 / 0.7);
  }

  /* the ruled field the bars sit on: a baseline plus faint tenth ticks —
     calendar texture without claiming any calendar */
  .g-track {
    position: relative;
    height: 16px;
    background:
      repeating-linear-gradient(90deg, rgb(245 247 249 / 0.07) 0 1px, transparent 1px 10%),
      linear-gradient(rgb(245 247 249 / 0.05), rgb(245 247 249 / 0.05));
  }

  /* dependency drops: each bar starts where the last one ended, and the
     chart says so — a short connector falls from the junction */
  .g-row + .g-row .g-track::before {
    content: "";
    position: absolute;
    top: -31px;
    height: 31px;
    width: 0;
    border-left: 1px solid rgb(77 124 255 / 0.3);
  }
  .g-row:nth-child(2) .g-track::before { left: 6%; }
  .g-row:nth-child(3) .g-track::before { left: 30%; }
  .g-row:nth-child(4) .g-track::before { left: 50%; }
  .g-row:nth-child(5) .g-track::before { left: 90%; }

  /* bar geometry: offsets and lengths in tenths of the whole engagement.
     The proportions are the argument — a sliver of a call, real time on
     site, directions chosen, the build as the long haul, and ownership
     capping the end. */
  .g-bar {
    position: absolute;
    top: 1px;
    bottom: 1px;
    border-radius: 3px;
    overflow: hidden;
  }
  .g-row:nth-child(1) .g-bar { left: 0%;  width: 6%; }
  .g-row:nth-child(2) .g-bar { left: 6%;  width: 24%; }
  .g-row:nth-child(3) .g-bar { left: 30%; width: 20%; }
  .g-row:nth-child(4) .g-bar { left: 50%; width: 40%; }
  .g-row:nth-child(5) .g-bar { left: 90%; width: 10%; }

  /* the neon: lifted cobalt (the map and fault board's blue) with a glow
     that stays static — the draw is the motion moment, nothing idles */
  .fill {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 3px;
    background: linear-gradient(90deg, var(--color-cobalt-lift), #6E93FF);
    box-shadow:
      0 0 10px rgb(77 124 255 / 0.65),
      0 0 26px rgb(77 124 255 / 0.35);
    transform-origin: left;
    transition: filter 200ms ease, box-shadow 200ms ease;
  }
  :global(.pb-armed) .fill { transform: scaleX(0); }
  :global(.pb-armed.pb-draw) .fill {
    transform: scaleX(1);
    transition: transform 450ms var(--ease), filter 200ms ease, box-shadow 200ms ease;
  }
  /* the schedule fills in sequence, left to right down the rows — the
     delay applies to the draw only, never the hover (style attributes
     are off-limits under the hashed CSP, so the delays live here) */
  .g-row:nth-child(2) .fill { transition-delay: 60ms, 0s, 0s; }
  .g-row:nth-child(3) .fill { transition-delay: 120ms, 0s, 0s; }
  .g-row:nth-child(4) .fill { transition-delay: 180ms, 0s, 0s; }
  .g-row:nth-child(5) .fill { transition-delay: 240ms, 0s, 0s; }

  /* ---------- the descriptions ---------- */
  .step-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 26px;
  }
  .step {
    border-left: 2px solid transparent;
    padding-left: 18px;
    transition: border-color 180ms ease, background-color 180ms ease;
  }
  .step-name { color: rgb(245 247 249 / 0.6); }
  .step-name b { color: var(--color-sheet); font-weight: 700; }
  /* the readability pass: full-size body at a brighter step */
  .step-body {
    margin-top: 6px;
    font-size: 1.0625rem;
    font-weight: 400;
    line-height: 1.6;
    color: rgb(245 247 249 / 0.75);
    max-width: 40em;
  }

  .chip {
    display: inline-block;
    margin-top: 10px;
    padding: 3px 8px;
    border: 1px solid rgb(245 247 249 / 0.22);
    border-radius: 2px;
    color: rgb(245 247 249 / 0.6);
  }
  /* Amber: the two process chips — choice and ownership (§2). */
  .chip-amber {
    color: var(--color-amber);
    border-color: rgb(232 163 61 / 0.4);
  }

  /* ---------- the cross-light: bar ↔ description ---------- */
  /* Hover either side and both light. Pure CSS: the grid watches its own
     children with :has() — browsers without it simply keep the flat
     styling, nothing breaks. */
  .process-grid:has(.g-row:nth-child(1):hover) .step:nth-child(1),
  .process-grid:has(.step:nth-child(1):hover) .step:nth-child(1),
  .process-grid:has(.g-row:nth-child(2):hover) .step:nth-child(2),
  .process-grid:has(.step:nth-child(2):hover) .step:nth-child(2),
  .process-grid:has(.g-row:nth-child(3):hover) .step:nth-child(3),
  .process-grid:has(.step:nth-child(3):hover) .step:nth-child(3),
  .process-grid:has(.g-row:nth-child(4):hover) .step:nth-child(4),
  .process-grid:has(.step:nth-child(4):hover) .step:nth-child(4),
  .process-grid:has(.g-row:nth-child(5):hover) .step:nth-child(5),
  .process-grid:has(.step:nth-child(5):hover) .step:nth-child(5) {
    border-left-color: var(--color-cobalt-lift);
    background: rgb(245 247 249 / 0.04);
  }
  .process-grid:has(.g-row:nth-child(1):hover) .g-row:nth-child(1) .fill,
  .process-grid:has(.step:nth-child(1):hover) .g-row:nth-child(1) .fill,
  .process-grid:has(.g-row:nth-child(2):hover) .g-row:nth-child(2) .fill,
  .process-grid:has(.step:nth-child(2):hover) .g-row:nth-child(2) .fill,
  .process-grid:has(.g-row:nth-child(3):hover) .g-row:nth-child(3) .fill,
  .process-grid:has(.step:nth-child(3):hover) .g-row:nth-child(3) .fill,
  .process-grid:has(.g-row:nth-child(4):hover) .g-row:nth-child(4) .fill,
  .process-grid:has(.step:nth-child(4):hover) .g-row:nth-child(4) .fill,
  .process-grid:has(.g-row:nth-child(5):hover) .g-row:nth-child(5) .fill,
  .process-grid:has(.step:nth-child(5):hover) .g-row:nth-child(5) .fill {
    filter: brightness(1.25);
    box-shadow:
      0 0 14px rgb(77 124 255 / 0.85),
      0 0 34px rgb(77 124 255 / 0.5);
  }
  .process-grid:has(.g-row:nth-child(1):hover) .g-row:nth-child(1) .g-label,
  .process-grid:has(.step:nth-child(1):hover) .g-row:nth-child(1) .g-label,
  .process-grid:has(.g-row:nth-child(2):hover) .g-row:nth-child(2) .g-label,
  .process-grid:has(.step:nth-child(2):hover) .g-row:nth-child(2) .g-label,
  .process-grid:has(.g-row:nth-child(3):hover) .g-row:nth-child(3) .g-label,
  .process-grid:has(.step:nth-child(3):hover) .g-row:nth-child(3) .g-label,
  .process-grid:has(.g-row:nth-child(4):hover) .g-row:nth-child(4) .g-label,
  .process-grid:has(.step:nth-child(4):hover) .g-row:nth-child(4) .g-label,
  .process-grid:has(.g-row:nth-child(5):hover) .g-row:nth-child(5) .g-label,
  .process-grid:has(.step:nth-child(5):hover) .g-row:nth-child(5) .g-label {
    color: var(--color-sheet);
  }

  /* Below 1024 the chart stacks above the descriptions; the label column
     narrows and the milestone re-centres on the narrower geometry. */
  @media (max-width: 1023.98px) {
    .process { padding-block: 72px; }
    .process-grid { grid-template-columns: 1fr; gap: 48px; }
    .gantt { gap: 22px; }
    .g-row { grid-template-columns: 138px minmax(0, 1fr); gap: 12px; }
    .g-label { font-size: 0.875rem; }
    .g-track { height: 14px; }
    .g-row + .g-row .g-track::before { top: -23px; height: 23px; }
    .g-mark-line, .g-mark-label { left: calc(75px + 50%); }
    .step-body { max-width: 34em; }
  }
</style>
