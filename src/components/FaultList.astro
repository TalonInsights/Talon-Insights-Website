---
// B3 — The fault list. Hand-built (§7). Fault 07 leads, full width and set
// apart; six follow in two columns with the right column dropped 56px for
// the staggered rhythm. Single column below 768px, offset removed.

const faults = [
  { id: "FAULT 01", title: "The bait and switch.", body: "A senior person sells you the job, then a junior or offshore team builds it. You never speak to the seller again." },
  { id: "FAULT 02", title: "Lock-in.", body: "You don’t own your domain, your code or your content. Leaving means starting from nothing — and everybody knows it." },
  { id: "FAULT 03", title: "A pretty site that does nothing.", body: "It looks smart and generates no enquiries, because nobody asked what the business needed first." },
  { id: "FAULT 04", title: "No discovery.", body: "Nobody came to see how you actually work. The quote was written from a ten-minute phone call and a guess." },
  { id: "FAULT 05", title: "Vague quotes, moving numbers.", body: "Everything you assumed was included turns out to be extra, and there’s no written scope to point at." },
  { id: "FAULT 06", title: "Support that vanishes.", body: "It went live, then the emails stopped being answered." },
];
---

<section class="faults g-ink">
  <div class="wrap">
    <p class="t-micro eyebrow">WHY PEOPLE CALL ME</p>
    <h2 class="t-h2">You’ve probably been let down by one of&nbsp;these.</h2>
    <p class="lede">Every one of them is avoidable. Most of them are why I work the way I&nbsp;do.</p>

    <article class="fault-featured" data-rv>
      <p class="t-micro fault-id">FAULT 07</p>
      <h3 class="featured-title">Approval, not involvement.</h3>
      <p class="featured-body">
        You were shown one mockup near the end and asked to sign it off. That’s not being
        involved — that’s being consulted.
      </p>
    </article>

    <div class="fault-grid" data-rv>
      {faults.map((fault, i) => (
        <article class={`fault ${i % 2 === 1 ? "is-right" : ""}`}>
          <p class="t-micro fault-id">{fault.id}</p>
          <p class="fault-body"><strong>{fault.title}</strong> {fault.body}</p>
        </article>
      ))}
    </div>

    <div class="payoff" data-rv>
      <p class="t-mono payoff-claim">ALL SEVEN — DESIGNED OUT</p>
      <a class="payoff-link" href="#process">How every job runs →</a>
    </div>
  </div>
</section>

<style>
  .faults { padding-block: 120px; }
  .lede { max-width: 34em; }

  .fault-featured {
    margin-top: 64px;
    padding-bottom: 48px;
    border-bottom: var(--hairline-dark);
  }
  .fault-id { color: rgb(245 247 249 / 0.45); margin-bottom: 12px; }
  .featured-title { font-size: 1.75rem; font-weight: 500; margin-bottom: 12px; }
  .featured-body { max-width: 38em; font-size: 1.125rem; }

  .fault-grid {
    margin-top: 48px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px 64px;
    padding-bottom: 56px; /* room for the offset column */
  }
  .fault.is-right { position: relative; top: 56px; }
  .fault-body { max-width: 34em; }
  .fault-body strong { color: var(--color-sheet); font-weight: 500; }

  .payoff {
    margin-top: 64px;
    padding-top: 24px;
    border-top: 1px solid rgb(232 163 61 / 0.4); /* amber: the payoff rule, one of six */
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px 32px;
  }
  .payoff-claim { color: var(--color-amber); font-weight: 500; }
  .payoff-link {
    color: var(--color-sheet);
    text-decoration: none;
    transition: color 180ms var(--ease);
  }
  .payoff-link:hover { color: var(--color-amber); }

  @media (max-width: 767.98px) {
    .faults { padding-block: 96px; }
    .fault-grid { grid-template-columns: 1fr; gap: 32px; padding-bottom: 0; }
    .fault.is-right { top: 0; }
  }
</style>
