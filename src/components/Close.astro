---
// B11 — Close (id="book"), merged with B10 (27 Aug, owner): the booking
// form and the coverage map are one section now — form on the left, the
// neon map on the right, on a ground a step DARKER than ink-deep so the
// lifted-amber dots and travel animation read at full strength. The map's
// legend loses the word BASE (the square-vs-dot marker distinction does
// that job); the canvas label says just "Telford" (CoverageMap.tsx).
// Map.astro is unmounted from the page; its component stays in the repo.
import BookingForm from "./BookingForm";
import CoverageMap from "./CoverageMap";
---

<section class="close g-ink" id="book">
  <div class="close-wrap">
    <div class="close-grid">
      <div class="close-left">
        <img class="close-mark" src="/images/mark.webp" alt="" width="158" height="132" />
        <h2 class="t-h2">Book a visit — I’ll come to&nbsp;you.</h2>
        <p class="lede close-lede">
          No jargon, no pressure, and whatever we find is yours to keep — whether or not
          we go ahead.
        </p>

        <div class="close-form">
          <BookingForm client:idle />
        </div>

        <!-- 28 Aug (owner): the booking page fleshes out — what happens
             after the button, in the site's numbered language -->
        <ol class="next-steps" data-rv>
          <li><b>01</b><span>You send this — or just call.</span></li>
          <li><b>02</b><span>I ring back within one working day.</span></li>
          <li><b>03</b><span>We book the visit — free within an hour of Telford.</span></li>
          <li><b>04</b><span>You see real directions before any code is written.</span></li>
        </ol>

        <p class="t-mono close-trust" data-rv>FIXED PRICE<i>◆</i>WRITTEN SCOPE<i>◆</i>YOU OWN EVERYTHING</p>

        <p class="close-call">
          Or call <a class="tel" href="tel:+447742082423">07742 082423</a>
          <span class="t-micro call-note">REPLY WITHIN ONE WORKING DAY</span>
        </p>
      </div>

      <!-- 27 Aug (owner): the WHERE I WORK copy came off — the map, its key
           and an exact statement of what is drawn now stand centred on
           their own. The boundary is the full ONS West Midlands region
           (generate-map.py fetches the EER feature named "West Midlands"),
           so the label names all six counties it contains. -->
      <div class="close-map">
        <div class="coverage-canvas">
          <CoverageMap client:idle />
        </div>

        <div class="map-legend">
          <span class="legend-item"><i class="swatch swatch-base" aria-hidden="true"></i><span class="t-micro">TELFORD</span></span>
          <span class="legend-item"><i class="swatch swatch-city" aria-hidden="true"></i><span class="t-micro">WITHIN AN HOUR</span></span>
        </div>
        <div class="map-caption">
          <span class="t-micro">THE FULL WEST MIDLANDS REGION — SHROPSHIRE · STAFFORDSHIRE · HEREFORDSHIRE · WORCESTERSHIRE · WARWICKSHIRE · WEST MIDLANDS COUNTY</span>
          <span class="t-micro">VISITS — NO CHARGE WITHIN AN HOUR OF TELFORD</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .close {
    padding-block: 120px;
    /* a step darker than --color-ink-deep (#060E1C): the neon map's
       lifted-amber dots and the form's focus states carry the light here.
       NOT #010101 — that value is the fire page's matched pair. */
    background:
      radial-gradient(800px 460px at 18% 18%, rgb(29 78 216 / 0.1), transparent 70%),
      #04080F;
    border-top: var(--hairline-dark);
  }
  .close-wrap {
    max-width: 1560px; /* matches the other dark sections */
    margin-inline: auto;
    padding-inline: 24px;
  }
  .close-grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    gap: clamp(40px, 5vw, 96px);
    align-items: center;
  }

  /* ---------- left: the ask ---------- */
  .close-mark { width: 44px; height: auto; margin-bottom: 24px; }
  .close-lede { margin-top: 8px; max-width: 34em; }

  .close-form { width: 100%; max-width: 640px; margin-top: 40px; }

  /* Form styling lives here (global within the section) because the island
     renders markup only — mechanics in BookingForm.tsx, skin from tokens. */
  .close-form :global(.bform-grid) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .close-form :global(.bfield) { display: flex; flex-direction: column; gap: 6px; }
  .close-form :global(.bloc) {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgb(245 247 249 / 0.65);
    text-align: left;
  }
  .close-form :global(input) {
    background: rgb(245 247 249 / 0.06);
    border: var(--hairline-dark);
    border-radius: 2px;
    padding: 12px 14px;
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--color-sheet);
    transition: border-color 180ms var(--ease);
  }
  .close-form :global(input:hover) { border-color: rgb(245 247 249 / 0.3); }
  /* the full field set (28 Aug): selects and the textarea wear the same
     skin as the inputs; color-scheme keeps native popups dark */
  .close-form { color-scheme: dark; }
  .close-form :global(select),
  .close-form :global(textarea) {
    background: rgb(245 247 249 / 0.06);
    border: var(--hairline-dark);
    border-radius: 2px;
    padding: 12px 14px;
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--color-sheet);
    transition: border-color 180ms var(--ease);
  }
  .close-form :global(select:hover),
  .close-form :global(textarea:hover) { border-color: rgb(245 247 249 / 0.3); }
  .close-form :global(textarea) { resize: vertical; min-height: 120px; }
  .close-form :global(input::placeholder),
  .close-form :global(textarea::placeholder) { color: rgb(245 247 249 / 0.35); }
  .close-form :global(.bfield-full) { grid-column: 1 / -1; }
  .close-form :global(input[aria-invalid="true"]) { border-color: var(--color-breach); }
  .close-form :global(.berr) {
    margin-top: 8px;
    font-size: 0.875rem;
    text-align: left;
    color: #E38B7B; /* breach, lifted for contrast on ink */
  }
  .close-form :global(.bfield .berr) { margin-top: 0; }
  .close-form :global(.bform-submit) { margin-top: 24px; }
  .close-form :global(.form-success) {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: var(--color-amber); /* success state — not part of the at-rest amber budget */
    text-align: left;
    padding-block: 32px;
  }

  /* what happens next: the site's numbered voice, compact */
  .next-steps {
    list-style: none;
    margin: 36px 0 0;
    padding: 24px 0 0;
    border-top: 1px solid rgb(245 247 249 / 0.12);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px 28px;
    max-width: 640px;
  }
  .next-steps li {
    display: flex;
    gap: 12px;
    align-items: baseline;
    font-size: 1rem;
    line-height: 1.5;
    color: rgb(245 247 249 / 0.75);
  }
  .next-steps b {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--color-cobalt-lift);
  }

  .close-trust {
    margin-top: 24px;
    font-size: 0.9375rem;
    letter-spacing: 0.12em;
    color: rgb(245 247 249 / 0.6);
  }
  .close-trust i {
    font-style: normal;
    margin-inline: 10px;
    font-size: 0.625rem;
    vertical-align: 1px;
    color: rgb(77 124 255 / 0.7);
  }

  .close-call { margin-top: 36px; display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 16px; }
  .tel { color: var(--color-sheet); text-decoration: none; font-weight: 500; }
  .tel:hover { text-decoration: underline; }
  .call-note { color: rgb(245 247 249 / 0.45); }

  /* ---------- right: the map, centred ---------- */
  /* Reserves the canvas's space pre-hydration — zero CLS. 640 / 679 is the
     logical frame written by scripts/generate-map.py into map-dots.json;
     update together if the map geometry ever changes. Labels render on the
     canvas itself, so nothing shifts when they arrive. */
  .coverage-canvas { max-width: 600px; margin-inline: auto; }
  .coverage-canvas :global(canvas) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 640 / 679;
  }

  /* legend and caption share one footer under the canvas; TELFORD keeps
     the square marker, the word BASE is gone (27 Aug, owner) */
  .map-legend {
    margin-top: 16px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 28px;
  }
  .legend-item { display: inline-flex; align-items: center; gap: 10px; }
  .legend-item .t-micro { color: rgb(245 247 249 / 0.6); }
  .swatch { flex: none; }
  .swatch-base { width: 10px; height: 10px; background: var(--color-amber-lift); }
  .swatch-city {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-amber-lift);
  }

  .map-caption {
    margin-top: 14px;
    padding-top: 12px;
    border-top: var(--hairline-dark);
    max-width: 600px;
    margin-inline: auto;
    display: grid;
    gap: 6px;
    text-align: center;
  }
  .map-caption .t-micro { color: rgb(245 247 249 / 0.5); line-height: 1.6; }

  @media (max-width: 899.98px) {
    .close { padding-block: 96px; }
    .close-grid { grid-template-columns: 1fr; gap: 56px; }
  }
  @media (max-width: 639.98px) {
    .close-form :global(.bform-grid) { grid-template-columns: 1fr; }
    .next-steps { grid-template-columns: 1fr; }
  }
</style>
