---
// B1 — Hero, restaged 27 Aug 2026 (owner's directive, Linear reference):
// the centred block goes left-aligned and gains the site's first showcase
// shot — the WulfTek Tuning homepage, a real delivered client page, lying
// back at a Linear-style tilt below the copy. The copy itself is still the
// master build's verbatim hero text: chip → H1 → standfirst → CTA pair →
// trust line. Grid and burst remain drawn in CSS from token blues; the
// shot is a real capture (no mockups, §8), self-hosted (CSP allows no
// remote images). No JS, no island: this block is fully static — the tilt
// is a stylesheet transform.
---

<section class="hero">
  <div class="wrap hero-inner">
    <div class="hero-copy">
      <a class="announce" href="#pricing">
        <span class="announce-text">Taking on founding projects at a reduced rate</span>
        <span class="announce-more">Read more
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
      </a>

      <h1 class="t-display">You’re a&nbsp;specialist.<br />Your website&nbsp;isn’t.</h1>

      <p class="standfirst">
        <span class="nowrap-sentence">The reason people choose you already exists.</span>
        <span class="nowrap-sentence">It’s just not on the page.</span>
      </p>

      <div class="ctas">
        <a class="btn btn-primary" href="#method">See how I work</a>
        <a class="btn btn-ghost" href="#work">See the work</a>
      </div>

      <p class="t-micro hero-trust">FIXED PRICE · WRITTEN SCOPE · YOU OWN EVERYTHING</p>
    </div>

    <!-- The showcase: real client work, angled off the page the way the
         reference presents its product. The proof strip directly below
         names the client. -->
    <div class="hero-shot">
      <img
        src="/images/work-wulftek-home.webp"
        width="1910"
        height="1026"
        alt="The WulfTek Tuning homepage — a delivered client site: registration lookup hero with the line ‘What could your car actually do?’"
        decoding="async"
        fetchpriority="high"
      />
    </div>
  </div>
</section>

<style>
  /* Ground: ink-black, the blue burst rising behind the copy block. */
  .hero {
    position: relative;
    background:
      radial-gradient(720px 460px at 30% 24%, rgb(77 124 255 / 0.24), transparent 70%),
      radial-gradient(1100px 700px at 42% 20%, rgb(29 78 216 / 0.15), transparent 72%),
      var(--color-ink-deep);
    padding-top: clamp(88px, 12vh, 140px);
    padding-bottom: 0; /* the shot melts straight into the proof strip */
    overflow: clip;
  }
  /* The fine grid, fading out radially — drawn, not downloaded. */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(245 247 249 / 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgb(245 247 249 / 0.055) 1px, transparent 1px);
    background-size: 56px 56px;
    -webkit-mask-image: radial-gradient(70% 64% at 40% 26%, #000 40%, transparent 78%);
    mask-image: radial-gradient(70% 64% at 40% 26%, #000 40%, transparent 78%);
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    container-type: inline-size;
  }

  /* ---------- the copy block, left-aligned to the reference ---------- */
  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    max-width: 640px;
  }

  .announce {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
    padding: 9px 18px;
    border: 1px solid rgb(245 247 249 / 0.2);
    border-radius: 999px;
    text-decoration: none;
    color: rgb(245 247 249 / 0.65);
    font-size: 0.875rem;
    transition: border-color 180ms var(--ease);
  }
  .announce:hover { border-color: rgb(245 247 249 / 0.45); }
  .announce-more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 500;
    color: var(--color-sheet);
  }
  .announce-more svg { width: 15px; height: 15px; }

  /* The H1 must break exactly once, after "specialist." — at every
     breakpoint. */
  .hero-copy h1 {
    margin-top: 28px;
    max-width: 16ch;
    font-size: min(clamp(2.625rem, 5.2vw, 4.125rem), 9.4cqw);
    color: var(--color-sheet);
  }

  .standfirst {
    margin-top: 20px;
    max-width: 30em;
    color: rgb(245 247 249 / 0.65);
    font-size: 1.1875rem;
    line-height: 1.55;
    font-weight: 350;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  .ctas .btn-ghost {
    color: var(--color-sheet);
    border-color: rgb(245 247 249 / 0.3);
  }
  .ctas .btn-ghost:hover { border-color: var(--color-sheet); }

  .hero-trust {
    margin-top: 32px;
    color: rgb(245 247 249 / 0.45);
  }

  /* ---------- the showcase shot ---------- */
  /* The panel lies back into the page: perspective + a lean to the right,
     top edge away, exactly the reference's staging. The wrapper carries
     the perspective so the shadow tilts with the panel; the bottom fade
     melts it into the proof strip's ink. */
  .hero-shot {
    margin-top: clamp(40px, 6vw, 72px);
    margin-inline: auto;
    width: min(100%, 1040px);
    perspective: 1800px;
    -webkit-mask-image: linear-gradient(180deg, #000 72%, transparent 98%);
    mask-image: linear-gradient(180deg, #000 72%, transparent 98%);
  }
  .hero-shot img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 10px;
    border: 1px solid rgb(245 247 249 / 0.14);
    transform: rotateX(26deg) rotateY(-7deg) rotateZ(3deg);
    transform-origin: 50% 0%;
    box-shadow:
      0 40px 90px -30px rgb(0 0 0 / 0.65),
      0 0 120px -40px rgb(29 78 216 / 0.45);
  }

  /* Small screens: the tilt reads as distortion at phone widths — the
     panel sits flat and full-width instead, fade retained. */
  @media (max-width: 720px) {
    .hero-shot img {
      transform: none;
      border-radius: 8px;
    }
  }
</style>
