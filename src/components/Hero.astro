---
// B1 — Hero, rebuilt 27 Aug 2026 to the owner-supplied centred reference
// (21st "hero-section"): announcement chip → display headline → standfirst
// → CTA pair, over a fine grid with a soft burst. Integrated the house way:
// the reference's bundled nav, Poppins import, remote grid image and mobile
// overlay did not survive — the site header already carries the mark and
// wordmark, the grid and burst are drawn in CSS from token blues (the hero
// is the site's one sanctioned gradient zone, and the CSP allows no remote
// images), and the copy is the master build's verbatim hero text.
//
// Retired with this layout: the delivery-plan panel (signature #1, in git
// history) — and with it the hero's two amber marks and its draw-on-load
// motion moment. No JS, no island: this block is fully static.
---

<section class="hero">
  <div class="wrap hero-inner">
    <a class="announce" href="#pricing">
      <span class="announce-text">Taking on founding projects at a reduced rate</span>
      <span class="announce-more">Read more
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
    </a>

    <h1 class="t-display">You’re a&nbsp;specialist.<br />Your website&nbsp;isn’t.</h1>

    <p class="standfirst">
      <span class="nowrap-sentence">The reason people choose you already exists.</span>
      <span class="nowrap-sentence">It’s just not on the page.</span>
    </p>

    <div class="ctas">
      <a class="btn btn-primary" href="#method">See how I work</a>
      <a class="btn btn-ghost" href="#work">See the work</a>
    </div>

    <p class="t-micro hero-trust">FIXED PRICE · WRITTEN SCOPE · YOU OWN EVERYTHING</p>
  </div>
</section>

<style>
  /* Ground: ink-black (27 Aug — the darker undertone), the blue burst
     glowing out of it. */
  .hero {
    position: relative;
    background:
      radial-gradient(640px 420px at 50% 34%, rgb(77 124 255 / 0.26), transparent 70%),
      radial-gradient(1000px 640px at 50% 26%, rgb(29 78 216 / 0.16), transparent 72%),
      var(--color-ink-deep);
    padding-top: clamp(96px, 14vh, 160px);
    padding-bottom: clamp(96px, 12vw, 176px);
    overflow: clip;
  }
  /* The fine grid, fading out radially — drawn, not downloaded. */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(245 247 249 / 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgb(245 247 249 / 0.055) 1px, transparent 1px);
    background-size: 56px 56px;
    -webkit-mask-image: radial-gradient(72% 82% at 50% 34%, #000 42%, transparent 78%);
    mask-image: radial-gradient(72% 82% at 50% 34%, #000 42%, transparent 78%);
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* ---------- announcement chip ---------- */
  .announce {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: 4px 12px;
    padding: 10px 20px;
    border: 1px solid rgb(245 247 249 / 0.2);
    border-radius: 999px;
    text-decoration: none;
    color: rgb(245 247 249 / 0.65);
    font-size: 0.875rem;
    transition: border-color 180ms var(--ease);
  }
  .announce:hover { border-color: rgb(245 247 249 / 0.45); }
  .announce-more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 500;
    color: var(--color-sheet);
  }
  .announce-more svg { width: 15px; height: 15px; }

  /* The H1 must break exactly once, after "specialist." — at every
     breakpoint. The container cap keeps the longer first line on one line
     where the display clamp alone would wrap it. */
  .hero-inner h1 {
    margin-top: 32px;
    max-width: 16ch;
    font-size: min(clamp(2.75rem, 6vw, 4.5rem), 9.4cqw);
    color: var(--color-sheet);
  }

  .standfirst {
    margin-top: 24px;
    max-width: 30em;
    color: rgb(245 247 249 / 0.65);
    font-size: 1.1875rem;
    line-height: 1.55;
    font-weight: 350;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 32px;
  }
  /* the ghost button, dark-ground variant */
  .ctas .btn-ghost {
    color: var(--color-sheet);
    border-color: rgb(245 247 249 / 0.3);
  }
  .ctas .btn-ghost:hover { border-color: var(--color-sheet); }

  .hero-trust {
    margin-top: 40px;
    color: rgb(245 247 249 / 0.45);
  }
</style>
