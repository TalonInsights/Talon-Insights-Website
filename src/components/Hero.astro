---
// B1 — Hero, restaged 27 Aug 2026 (owner's directive, Linear reference):
// the block gains the site's first showcase
// shot — the WulfTek Tuning homepage, a real delivered client page, lying
// back at a Linear-style tilt below the copy. The copy itself is still the
// master build's verbatim hero text: chip → H1 → standfirst → CTA pair →
// trust line. Grid and burst remain drawn in CSS from token blues; the
// shot is a real capture (no mockups, §8), self-hosted (CSP allows no
// remote images). No JS, no island: this block is fully static. The
// Tailark projection was retired 27 Aug (owner: unreadable = texture);
// the panel is straight-on now, framed, bleeding off the right edge.
---

<section class="hero">
  <div class="wrap hero-inner">
    <div class="hero-grid">
    <div class="hero-copy">
      <h1 class="t-display"><span class="line">You’re a specialist.</span><span class="line">Your website isn’t.</span></h1>

      <p class="standfirst">
        <span class="nowrap-sentence">The reason people choose you already exists.</span>
        <span class="nowrap-sentence">It’s just not on the page.</span>
      </p>

      <!-- 27 Aug (owner's review): "See how I work" / "See the work" were
           four words apart and neither was a contact action - the primary
           now matches the nav's Book a visit, and the proof link stays -->
      <div class="ctas">
        <a class="btn btn-primary" href="/booking">Book a visit</a>
        <a class="btn btn-ghost" href="#work">See the work</a>
      </div>

      <p class="t-micro hero-trust">FIXED PRICE · WRITTEN SCOPE · YOU OWN EVERYTHING</p>
    </div>

    </div>
  </div>

  <!-- The theatre (owner-supplied 21st import, restaged CSS-only; made a
       TOY 28 Aug): the laptop rests open and lit so the headline owns the
       first beat — click the machine and the site swells out of its
       screen into the panel; click the panel and it returns. Keyboard
       reachable; reduced motion shows the panel plainly instead. -->
  <div class="hero-theatre" role="button" tabindex="0" aria-pressed="false" aria-label="Send the website out of the laptop">
    <div class="mb-frame">
      <div class="mb-inner">
        <div class="mb-screen">
          <div class="mb-screen-face">
            <div class="mb-camera"></div>
            <div class="mb-display">
              <img src="/images/work-wulftek-screen.webp" alt="" loading="eager" decoding="async" />
              <div class="mb-glare"></div>
            </div>
          </div>
        </div>
        <div class="mb-body">
          <div class="mb-body-face">
            <div class="mb-trackpad"></div>
            <div class="mb-keyboard">
              {Array.from({ length: 58 }).map(() => <i class="mb-key"></i>)}
              <i class="mb-key mb-key-space"></i>
              {Array.from({ length: 16 }).map(() => <i class="mb-key mb-key-f"></i>)}
            </div>
          </div>
          <span class="mb-foot mb-foot-tl"></span><span class="mb-foot mb-foot-tr"></span>
          <span class="mb-foot mb-foot-bl"></span><span class="mb-foot mb-foot-br"></span>
        </div>
      </div>
      <div class="mb-shadow"></div>
    </div>
  </div>

  <!-- the visible toggle (28 Aug, owner: "add a click here toggle") —
       revealed by the script only where the toy is wired -->
  <button type="button" class="hero-toy-hint" aria-label="View a delivered website">
    <i aria-hidden="true">◆</i><span>CLICK — SEE A SITE I’VE BUILT</span>
  </button>

  <!-- The showcase: real client work, straight-on (27 Aug, owner's review:
       the Tailark projection made the capture read as texture - at hero
       scale nothing on it was legible, and proof has to be readable), then
       CENTRED (same review, next pass): the shot floats in the zone
       bounded by the copy, the right edge, the nav band and the proof
       strip, equidistant within each axis - a framed card, not a bleed.
       It sits at SECTION level, outside the width-capped wrap. The proof
       strip directly below names the client. -->
  <div class="hero-shot">
    <img
      src="/images/work-wulftek-home.webp"
      width="1910"
      height="1026"
      alt="The WulfTek Tuning homepage — a delivered client site: registration lookup hero with the line ‘What could your car actually do?’"
      decoding="async"
      fetchpriority="high"
    />
  </div>
</section>

<style>
  /* Ground: ink-black, the blue burst rising behind the copy block. */
  .hero {
    position: relative;
    background:
      radial-gradient(720px 460px at 26% 34%, rgb(77 124 255 / 0.24), transparent 70%),
      radial-gradient(1100px 700px at 36% 26%, rgb(29 78 216 / 0.15), transparent 72%),
      var(--color-ink-deep);
    /* The header is sticky and, over the hero, surface-less: the hero
       pulls itself up behind it so what shows through the transparency is
       this ink, not the white body. The first 68px of padding are the
       header's own band. */
    margin-top: -68px;
    padding-top: calc(68px + clamp(20px, 4vh, 40px));
    padding-bottom: 0; /* the shot melts straight into the proof strip */
    overflow: clip;
  }
  /* The fine grid, fading out radially — drawn, not downloaded. */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(245 247 249 / 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgb(245 247 249 / 0.055) 1px, transparent 1px);
    background-size: 56px 56px;
    -webkit-mask-image: radial-gradient(70% 70% at 42% 34%, #000 40%, transparent 78%);
    mask-image: radial-gradient(70% 70% at 42% 34%, #000 40%, transparent 78%);
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    container-type: inline-size;
    /* uncapped for the hero only: the copy positions against the true
       free zone left of the panel, not against a viewport-centred column
       — on wide screens the wrap's centring pushed the text into the
       panel */
    max-width: none;
  }

  /* ---------- split stage: copy left, panel anchored bottom-right ---------- */
  /* The panel is no longer a grid column — the wrap's width cap made it a
     postage stamp on wide screens (owner: "way too small for a hero").
     It is absolutely anchored to the section's bottom-right, sized against
     the viewport with a reserve held for the copy, and the hero itself
     carries real height; the copy centres in what remains. */
  .hero-grid {
    display: block;
  }

  .hero-copy {
    container-type: inline-size; /* the H1 sizes itself to this column */
    position: relative;
    z-index: 2; /* above the panel if they ever meet */
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    justify-content: center;
    max-width: 720px;
    /* centred in the zone the panel leaves free. The constants are tied
       to the panel: 1140px = (its 1560px width cap + this 720px column)/2,
       so 50% − 1140px is the free zone's centre once the panel hits its
       cap; below that the viewport term holds a sane offset. */
    margin-left: max(24px, calc(50% - 1140px), min(5vw, 120px));
    min-height: clamp(620px, 84svh, 920px);
    padding-bottom: clamp(24px, 6vh, 72px);
  }

  /* The H1 must break exactly once, after "specialist." — at every
     breakpoint: each line is a hard block that never wraps, and the size
     is capped against the column so the longer line always fits. */
  .hero-copy h1 {
    margin-top: 0;
    font-size: min(clamp(3.25rem, 5.8vw, 5.5rem), 11.1cqw);
    letter-spacing: -0.02em; /* Space Grotesk sets wide - tightened at display size */
    color: var(--color-sheet);
  }
  .hero-copy h1 .line {
    display: block;
    white-space: nowrap;
  }

  .standfirst {
    margin-top: 26px;
    max-width: 30em;
    color: rgb(245 247 249 / 0.68);
    font-family: var(--font-standfirst);
    font-size: clamp(1.25rem, 1.45vw, 1.5625rem);
    line-height: 1.55;
    font-weight: 400;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 32px;
  }
  /* the pair scale up with the rest of the copy */
  .ctas .btn {
    font-size: 1.0625rem;
    padding: 13px 26px;
  }
  .ctas .btn-ghost {
    color: var(--color-sheet);
    border-color: rgb(245 247 249 / 0.3);
  }
  .ctas .btn-ghost:hover { border-color: var(--color-sheet); }

  .hero-trust {
    margin-top: 36px;
    font-size: 0.9375rem;
    color: rgb(245 247 249 / 0.45);
  }

  /* ---------- the showcase shot ---------- */
  /* Straight-on and CENTRED (27 Aug, owner's review, two passes: first the
     projection retired - unreadable is texture, not proof - then the bleed:
     the panel now sits equidistant from the copy and the right edge, and
     from the nav band and the proof strip). The .hero-shot element is the
     ZONE: it spans copy-edge to viewport-edge and nav to strip, and flex-
     centres the framed capture inside a uniform padding. With the aspect
     locked, the binding axis gets exactly the padding; the free axis
     splits its slack symmetrically - both axes stay equidistant. */
  .hero-shot {
    position: absolute;
    /* the copy's own left formula plus the wrap's 24px padding (the copy
       lives inside .wrap; this zone is at section level) plus its 720px
       column: the zone begins exactly where the text column ends - if any
       of those constants change, this changes with them. The 1164 is the
       copy's 1140 plus 24: its 50% resolves against the wrap-padded grid
       (48px narrower than this section), so the section-level mirror
       needs half that back on the constant to pick the same max() branch
       at every width */
    left: calc(max(24px, 50% - 1164px, min(5vw, 120px)) + 24px + 720px);
    right: 0;
    /* the header's 68px band only (the hero pulls itself up behind the
       sticky header) - NOT the hero's breathing clamp: the gap to the nav
       must measure the same as the gap to the strip, and any extra here
       would sit on top of the shared padding below */
    top: 68px;
    bottom: 0; /* the strip's hairline is the zone's floor */
    display: flex;
    align-items: center;
    justify-content: center;
    /* the equidistance: one gap, all four sides */
    padding: clamp(24px, 3vw, 56px);
    /* the zone paints ABOVE the theatre — without this it (and the
       invisible panel img inside it) swallows every click meant for the
       laptop. Found the honest way: el.click() in testing bypasses
       hit-testing, the owner's real mouse does not. */
    pointer-events: none;
  }
  /* the hint pill: hidden until the script wires the toy */
  .hero-toy-hint {
    display: none;
    position: absolute;
    right: calc(min(30vw, 620px) + 75px);
    bottom: calc(38% - 150px);
    translate: 50% 0;
    z-index: 3;
    align-items: center;
    gap: 10px;
    padding: 9px 16px;
    background: rgb(6 14 28 / 0.75);
    border: 1px solid rgb(77 124 255 / 0.4);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    letter-spacing: 0.14em;
    color: var(--color-cobalt-lift);
    cursor: pointer;
    transition: border-color 180ms var(--ease), color 180ms var(--ease);
  }
  .hero-toy-hint:hover { border-color: var(--color-cobalt-lift); color: var(--color-sheet); }
  .hero-toy-hint i { font-style: normal; font-size: 0.625rem; }
  .hero.toy-ready .hero-toy-hint { display: inline-flex; }

  .hero-theatre:focus-visible,
  .hero-toy-hint:focus-visible,
  .hero-shot img:focus-visible {
    outline: 2px solid var(--color-cobalt-lift);
    outline-offset: 6px;
  }

  .hero-shot img {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    pointer-events: none; /* only the OUT state makes it a control */
    border-radius: 12px;
    border: 1px solid rgb(245 247 249 / 0.16);
    box-shadow:
      0 48px 110px -32px rgb(0 0 0 / 0.6),
      0 16px 40px -16px rgb(0 0 0 / 0.5);
    /* held back until the laptop hands over, then expands out of the
       screen's position into its resting pose */
    opacity: 0;
    /* the fixed point of the expansion: solved so that at the starting
       scale the capture's box coincides with the laptop display's landed
       rect. The owner's screen recording proved fixed constants can only
       ever be right at one viewport: the laptop is a FIXED-SIZE prop
       (150×96 at scale 3.1) while the panel scales with the window, so
       the mapping between them changes with every width. The start pose
       is therefore solved AT RUNTIME by the script below, which writes
       --ho-tx/--ho-ty/--ho-s onto this element; the var() fallbacks are
       the 1912×1080 solve (centre-origin parametrisation: displayC −
       panelC = (−119.9, 36.3), s = 0.4264). */
    transform-origin: 50% 50%;
    cursor: pointer;
  }

  /* ---------- the toggle states (28 Aug) ----------
     OUT is the original overture on its original clock, started by the
     click instead of the load: turn 0–2.6s, screen on 2.65s, lit hold,
     swell 4.3s, panel 4.15s. IN rewinds the lot: panel folds back
     0–0.9s, machine returns, screen off at 0.9s, turn back away from
     1.3s — ending exactly on the resting pose, replayable forever. */
  .hero.shot-out .mb-inner { animation: mb-rotate 2.6s ease-in-out both; }
  .hero.shot-out .mb-display img { animation: mb-content 500ms ease-out 2.65s forwards; }
  .hero.shot-out .hero-theatre {
    animation: mb-exit 1100ms var(--ease) 4.3s forwards;
    pointer-events: none;
  }
  .hero.shot-out .hero-shot img {
    animation: shot-arrive 1500ms var(--ease) 4.15s forwards;
    pointer-events: auto;
  }
  .hero.shot-in .hero-shot img {
    animation: shot-depart 900ms var(--ease) forwards;
    pointer-events: none;
  }
  .hero.shot-in .hero-theatre { animation: mb-return 900ms var(--ease) both; }
  .hero.shot-in .mb-display img { animation: mb-content-off 400ms ease-out 900ms both; }
  .hero.shot-in .mb-inner { animation: mb-unrotate 1.6s ease-in-out 1300ms both; }

  /* ---------- the overture ---------- */
  /* The 21st MacBook, translated from its React/Tailwind form to plain
     markup and scoped keyframes — the same nested-3D construction, run
     ONCE: its final keyframes are retimed so the pass ends open, facing
     the viewer (rotateY 360, a whisper of X tilt), the display lights up
     with the WulfTek page, and the whole machine swells toward the
     camera as the real panel arrives beneath it. */
  .hero-theatre {
    position: absolute;
    right: min(30vw, 620px);
    bottom: 38%;
    width: 150px;
    height: 96px;
    scale: 3.1;
    pointer-events: none;
    /* 28 Aug (owner): the overture no longer auto-runs — the hero opens
       STILL so the headline carries the first beat, and the laptop is
       the toggle: click it and the handoff plays; click the panel and it
       returns. No animation at rest. */
    pointer-events: auto;
    cursor: pointer;
  }
  .mb-frame {
    position: absolute;
    inset: 0;
    perspective: 500px;
  }
  .mb-inner {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    /* resting pose: open, FACING AWAY, screen dark — the whole overture
       (turn → light → handoff) is the click's reward (28 Aug, owner) */
    transform: rotateX(-20deg) rotateY(180deg);
  }

  /* screen half */
  .mb-screen {
    position: absolute;
    left: 0; bottom: 0;
    width: 150px; height: 96px;
    border-radius: 7px;
    transform-style: preserve-3d;
    transform-origin: 50% 100%;
    background: linear-gradient(45deg, rgb(0 0 0 / 0.34), rgb(0 0 0 / 0)) left bottom / 300px 300px, #ddd;
    box-shadow: inset 0 3px 7px rgb(255 255 255 / 0.5);
  }
  .mb-screen-face {
    position: absolute;
    left: 0; bottom: 0;
    width: 150px; height: 96px;
    border-radius: 7px;
    transform: translateZ(2px);
    background: linear-gradient(45deg, rgb(0 0 0 / 0.24), rgb(0 0 0 / 0)), #d3d3d3;
  }
  .mb-camera {
    position: absolute;
    left: 50%; top: 4px;
    width: 3px; height: 3px;
    margin-left: -1.5px;
    border-radius: 50%;
    background: #000;
  }
  .mb-display {
    position: relative;
    width: 130px; height: 74px;
    margin: 10px;
    border-radius: 1px;
    background: #000;
    overflow: hidden;
    box-shadow: inset 0 0 2px rgb(0 0 0);
  }
  /* the site on the screen: dark until the pass settles, then lit */
  .mb-display img {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: top;
    opacity: 0; /* dark until the turn settles */
  }
  .mb-glare {
    position: absolute;
    inset: 0;
    background: linear-gradient(-135deg, rgb(255 255 255 / 0) 0%, rgb(255 255 255 / 0.1) 47%, rgb(255 255 255 / 0) 48%) 0 0 / 300px 200px;
  }

  /* body half */
  .mb-body {
    position: absolute;
    left: 0; bottom: 0;
    width: 150px; height: 96px;
    border-radius: 7px;
    transform-style: preserve-3d;
    /* the hinge: BOTTOM edge, same edge the screen folds on — the import
       left this origin implicit and a top-edge guess folds the deck away
       from the viewer, landing it above the lid like a grille (the
       owner's reference video exposed it). Bottom-origin lays the deck
       flat toward the camera, beneath the screen, the pen's true pose. */
    transform-origin: 50% 100%;
    transform: rotateX(-90deg);
    background: linear-gradient(45deg, rgb(0 0 0 / 0.24), rgb(0 0 0 / 0)), #cbcbcb;
  }
  .mb-body-face {
    position: absolute;
    left: 0; bottom: 0;
    width: 150px; height: 96px;
    border-radius: 7px;
    transform-style: preserve-3d;
    transform: translateZ(-2px);
    background: linear-gradient(30deg, rgb(0 0 0 / 0.24), rgb(0 0 0 / 0)), #dfdfdf;
  }
  .mb-trackpad {
    position: absolute;
    left: 50%; top: 50%;
    width: 40px; height: 31px;
    margin: -44px 0 0 -18px;
    border-radius: 4px;
    background: linear-gradient(30deg, rgb(0 0 0 / 0.24), rgb(0 0 0 / 0)), #cdcdcd;
    box-shadow: inset 0 0 3px #888;
  }
  .mb-keyboard {
    position: absolute;
    left: 7px; top: 41px;
    width: 130px; height: 45px;
    border-radius: 4px;
    padding-left: 2px;
    overflow: hidden;
    background: linear-gradient(30deg, rgb(0 0 0 / 0.24), rgb(0 0 0 / 0)), #cdcdcd;
    box-shadow: inset 0 0 3px #777;
  }
  .mb-key {
    float: left;
    width: 6px; height: 6px;
    margin: 1px;
    border-radius: 2px;
    background: #444;
    transform: translateZ(-2px);
    box-shadow: 0 -2px 0 #222;
  }
  .mb-key-space { width: 45px; }
  .mb-key-f { height: 3px; }
  .mb-foot {
    position: absolute;
    width: 5px; height: 5px;
    border-radius: 50%;
    background: #333;
  }
  .mb-foot-tl { left: 20px; top: 20px; }
  .mb-foot-tr { right: 20px; top: 20px; }
  .mb-foot-bl { left: 20px; bottom: 20px; }
  .mb-foot-br { right: 20px; bottom: 20px; }

  .mb-shadow {
    position: absolute;
    left: 40px; top: 160px;
    width: 60px; height: 0;
    transform: rotateX(80deg);
    box-shadow: 0 0 60px 40px rgb(0 0 0 / 0.3);
  }

  /* ---------- the choreography ----------
     OUT plays the import's overture as it always ran — one slow turn
     from facing away, the screen switching on once the turn settles,
     the lit hold, then the machine swelling and dissolving around the
     growing photo. IN is the full rewind. */
  @keyframes mb-rotate {
    0%   { transform: rotateX(-20deg) rotateY(180deg); }
    82%  { transform: rotateX(-20deg) rotateY(360deg); }
    100% { transform: rotateX(-20deg) rotateY(360deg); }
  }
  @keyframes mb-unrotate {
    0%   { transform: rotateX(-20deg) rotateY(360deg); }
    100% { transform: rotateX(-20deg) rotateY(180deg); }
  }
  @keyframes mb-content {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  @keyframes mb-content-off {
    from { opacity: 1; }
    to   { opacity: 0; }
  }
  @keyframes mb-return {
    0%   { opacity: 0; scale: 4.1; }
    100% { opacity: 1; scale: 3.1; }
  }
  /* the machine swells gently and dissolves AROUND the growing photo —
     it no longer needs to carry the expansion itself */
  @keyframes mb-exit {
    0%   { opacity: 1; scale: 3.1; }
    100% { opacity: 0; scale: 4.1; }
  }
  /* the panel starts at the display's own size and position (scale .439
     about the solved origin) AND on the display's own plane: the laptop
     screen is a rotateX(−20°) surface under the frame's 500px perspective
     (×3.1 theatre scale ≈ 1550px in screen space), so a flat start never
     sat exactly on the photo — the panel now begins keystoned to match
     and unfolds to flat as it grows (27 Aug, owner: start exactly where
     the mac screen is). Opacity front-loads harder so the panel is fully
     there before the laptop's swell moves the screen away. */
  @keyframes shot-arrive {
    0%   { opacity: 0; transform: translate(var(--ho-tx, -119.9px), var(--ho-ty, 36.3px)) perspective(1550px) rotateX(-20deg) scale(var(--ho-s, 0.4264)); }
    8%   { opacity: 1; }
    100% { opacity: 1; transform: none; }
  }
  @keyframes shot-depart {
    0%   { opacity: 1; transform: none; }
    88%  { opacity: 1; }
    100% { opacity: 0; transform: translate(var(--ho-tx, -119.9px), var(--ho-ty, 36.3px)) perspective(1550px) rotateX(-20deg) scale(var(--ho-s, 0.4264)); }
  }

  /* No theatre for reduced motion: the panel is simply there. */
  /* (the runtime handoff solver below skips those cases too) */
  @media (prefers-reduced-motion: reduce) {
    .hero-theatre { display: none; }
    .hero-shot img { opacity: 1; animation: none !important; pointer-events: none; cursor: default; }
  }

  /* Small screens: the projection reads as distortion at phone widths —
     the panel sits flat and full-width instead, bottom fade retained. */
  @media (max-width: 860px) {
    .hero-copy { min-height: 0; padding-bottom: 0; margin-left: 0; }
    .hero-theatre { display: none; }
    .hero-shot {
      position: static;
      padding: 0;
      margin: 32px 24px 0;
    }
    .hero-shot img {
      opacity: 1;
      animation: none;
      max-height: clamp(220px, 38vh, 420px);
      border-radius: 8px;
    }
  }
</style>

<script>
  /* The handoff solver — the site's fifth plain script (no island). The
     panel must START exactly on the laptop's lit display, and both rects
     depend on the viewport (the laptop is fixed-size, the panel fluid),
     so the start transform is solved here per-load: apply the laptop's
     landing pose invisibly for one layout pass, measure both rects, then
     iterate translate+scale (the keystone changes the bbox, so measured
     iteration beats algebra) and hand the result to the keyframe via
     custom properties. Runs synchronously before first paint's animation
     start (4.15s away); CSSOM writes are CSP-clean. */
  const solveHandoff = () => {
    const img = document.querySelector<HTMLImageElement>(".hero-shot img");
    const inner = document.querySelector<HTMLElement>(".mb-inner");
    const disp = document.querySelector<HTMLElement>(".mb-display");
    if (!img || !inner || !disp) return;
    if (matchMedia("(max-width: 860px)").matches) return;
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const prevT = inner.style.transform;
    const prevA = inner.style.animation;
    inner.style.animation = "none";
    inner.style.transform = "rotateX(-20deg) rotateY(360deg)"; // the landing pose
    const d = disp.getBoundingClientRect();
    inner.style.animation = prevA;
    inner.style.transform = prevT;
    if (!d.width) return;
    const c0 = img.getBoundingClientRect();
    if (!c0.width) return;
    let s = (d.width / c0.width) * 0.97; // keystone widens the bbox ~3%
    let tx = d.x + d.width / 2 - (c0.x + c0.width / 2);
    let ty = d.y + d.height / 2 - (c0.y + c0.height / 2);
    for (let i = 0; i < 5; i++) {
      img.style.transform = `translate(${tx}px, ${ty}px) perspective(1550px) rotateX(-20deg) scale(${s})`;
      const c = img.getBoundingClientRect();
      tx += d.x + d.width / 2 - (c.x + c.width / 2);
      ty += d.y + d.height / 2 - (c.y + c.height / 2);
      s *= d.width / c.width;
    }
    img.style.transform = "";
    img.style.setProperty("--ho-tx", tx.toFixed(1) + "px");
    img.style.setProperty("--ho-ty", ty.toFixed(1) + "px");
    img.style.setProperty("--ho-s", s.toFixed(4));
  };
  solveHandoff();
  /* layout can shift before the toy is played (font swap, a resize) —
     re-solve on both, and again on every play */
  document.fonts?.ready.then(solveHandoff);
  window.addEventListener("resize", solveHandoff);

  /* The toggle (28 Aug, owner): click the laptop → the handoff plays;
     click the panel → it returns. Same guards as the solver — stacked
     layouts and reduced motion never wire up. */
  const wireToggle = () => {
    const hero = document.querySelector<HTMLElement>(".hero");
    const theatre = document.querySelector<HTMLElement>(".hero-theatre");
    const img = document.querySelector<HTMLImageElement>(".hero-shot img");
    const hint = document.querySelector<HTMLElement>(".hero-toy-hint");
    const hintLabel = hint?.querySelector("span");
    if (!hero || !theatre || !img) return;
    if (matchMedia("(max-width: 860px)").matches) return;
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    hero.classList.add("toy-ready"); // reveals the hint pill
    const out = () => {
      solveHandoff(); // fresh geometry the moment it plays
      hero.classList.remove("shot-in");
      hero.classList.add("shot-out");
      theatre.setAttribute("aria-pressed", "true");
      img.setAttribute("role", "button");
      img.setAttribute("tabindex", "0");
      img.setAttribute("aria-label", "Return the website into the laptop");
      if (hintLabel) hintLabel.textContent = "CLICK THE SITE TO SEND IT BACK";
    };
    const back = () => {
      hero.classList.remove("shot-out");
      hero.classList.add("shot-in");
      theatre.setAttribute("aria-pressed", "false");
      img.removeAttribute("role");
      img.removeAttribute("tabindex");
      img.removeAttribute("aria-label");
      if (hintLabel) hintLabel.textContent = "CLICK — SEE A SITE I’VE BUILT";
    };
    const key = (fn: () => void) => (e: KeyboardEvent) => {
      if (e.key === "Enter" || e.key === " ") { e.preventDefault(); fn(); }
    };
    theatre.addEventListener("click", () => { if (!hero.classList.contains("shot-out")) out(); });
    theatre.addEventListener("keydown", key(() => { if (!hero.classList.contains("shot-out")) out(); }));
    img.addEventListener("click", () => { if (hero.classList.contains("shot-out")) back(); });
    img.addEventListener("keydown", key(() => { if (hero.classList.contains("shot-out")) back(); }));
    hint?.addEventListener("click", () => {
      hero.classList.contains("shot-out") ? back() : out();
    });
  };
  wireToggle();
</script>
