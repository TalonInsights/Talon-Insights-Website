---
// B1 — Hero, restaged 27 Aug 2026 (owner's directive, Linear reference):
// the block gains the site's first showcase
// shot — the WulfTek Tuning homepage, a real delivered client page, lying
// back at a Linear-style tilt below the copy. The copy itself is still the
// master build's verbatim hero text: chip → H1 → standfirst → CTA pair →
// trust line. Grid and burst remain drawn in CSS from token blues; the
// shot is a real capture (no mockups, §8), self-hosted (CSP allows no
// remote images). No JS, no island: this block is fully static — the tilt
// is a stylesheet transform.
---

<section class="hero">
  <div class="wrap hero-inner">
    <div class="hero-grid">
    <div class="hero-copy">
      <h1 class="t-display"><span class="line">You’re a specialist.</span><span class="line">Your website isn’t.</span></h1>

      <p class="standfirst">
        <span class="nowrap-sentence">The reason people choose you already exists.</span>
        <span class="nowrap-sentence">It’s just not on the page.</span>
      </p>

      <div class="ctas">
        <a class="btn btn-primary" href="#method">See how I work</a>
        <a class="btn btn-ghost" href="#work">See the work</a>
      </div>

      <p class="t-micro hero-trust">FIXED PRICE · WRITTEN SCOPE · YOU OWN EVERYTHING</p>
    </div>

    </div>
  </div>

  <!-- The showcase: real client work, angled off the page the way the
       reference presents its product. It sits at SECTION level, outside
       the width-capped wrap, so its absolute anchoring and sizing resolve
       against the full-bleed hero. The proof strip directly below names
       the client. -->
  <div class="hero-shot">
    <div class="hero-shot-tilt">
      <div class="hero-shot-skew">
        <img
          src="/images/work-wulftek-home.webp"
          width="1910"
          height="1026"
          alt="The WulfTek Tuning homepage — a delivered client site: registration lookup hero with the line ‘What could your car actually do?’"
          decoding="async"
          fetchpriority="high"
        />
      </div>
    </div>
  </div>
</section>

<style>
  /* Ground: ink-black, the blue burst rising behind the copy block. */
  .hero {
    position: relative;
    background:
      radial-gradient(720px 460px at 26% 34%, rgb(77 124 255 / 0.24), transparent 70%),
      radial-gradient(1100px 700px at 36% 26%, rgb(29 78 216 / 0.15), transparent 72%),
      var(--color-ink-deep);
    /* The header is sticky and, over the hero, surface-less: the hero
       pulls itself up behind it so what shows through the transparency is
       this ink, not the white body. The first 68px of padding are the
       header's own band. */
    margin-top: -68px;
    padding-top: calc(68px + clamp(20px, 4vh, 40px));
    padding-bottom: 0; /* the shot melts straight into the proof strip */
    overflow: clip;
  }
  /* The fine grid, fading out radially — drawn, not downloaded. */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(245 247 249 / 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgb(245 247 249 / 0.055) 1px, transparent 1px);
    background-size: 56px 56px;
    -webkit-mask-image: radial-gradient(70% 70% at 42% 34%, #000 40%, transparent 78%);
    mask-image: radial-gradient(70% 70% at 42% 34%, #000 40%, transparent 78%);
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    container-type: inline-size;
    /* uncapped for the hero only: the copy positions against the true
       free zone left of the panel, not against a viewport-centred column
       — on wide screens the wrap's centring pushed the text into the
       panel */
    max-width: none;
  }

  /* ---------- split stage: copy left, panel anchored bottom-right ---------- */
  /* The panel is no longer a grid column — the wrap's width cap made it a
     postage stamp on wide screens (owner: "way too small for a hero").
     It is absolutely anchored to the section's bottom-right, sized against
     the viewport with a reserve held for the copy, and the hero itself
     carries real height; the copy centres in what remains. */
  .hero-grid {
    display: block;
  }

  .hero-copy {
    container-type: inline-size; /* the H1 sizes itself to this column */
    position: relative;
    z-index: 2; /* above the panel if they ever meet */
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    justify-content: center;
    max-width: 660px;
    /* centred in the zone the panel leaves free. The constants are tied
       to the panel: 1150px = (its 1640px width cap + this 660px column)/2,
       so 50% − 1150px is the free zone's centre once the panel hits its
       cap; below that the viewport term holds a sane offset. */
    margin-left: max(24px, calc(50% - 1150px), min(5vw, 120px));
    min-height: clamp(620px, 84svh, 920px);
    padding-bottom: clamp(24px, 6vh, 72px);
  }

  /* The H1 must break exactly once, after "specialist." — at every
     breakpoint: each line is a hard block that never wraps, and the size
     is capped against the column so the longer line always fits. */
  .hero-copy h1 {
    margin-top: 0;
    font-size: min(clamp(2.75rem, 5vw, 4.625rem), 10.4cqw);
    color: var(--color-sheet);
  }
  .hero-copy h1 .line {
    display: block;
    white-space: nowrap;
  }

  .standfirst {
    margin-top: 24px;
    max-width: 30em;
    color: rgb(245 247 249 / 0.65);
    font-size: clamp(1.1875rem, 1.3vw, 1.4375rem);
    line-height: 1.55;
    font-weight: 350;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 32px;
  }
  /* the pair scale up with the rest of the copy */
  .ctas .btn {
    font-size: 1.0625rem;
    padding: 13px 26px;
  }
  .ctas .btn-ghost {
    color: var(--color-sheet);
    border-color: rgb(245 247 249 / 0.3);
  }
  .ctas .btn-ghost:hover { border-color: var(--color-sheet); }

  .hero-trust {
    margin-top: 36px;
    font-size: 0.78125rem;
    color: rgb(245 247 249 / 0.45);
  }

  /* ---------- the showcase shot ---------- */
  /* The panel's projection is the owner-supplied Tailark hero's, adopted
     mechanics-only per §7 (its nav, buttons and logo strip did not
     survive; no dependencies came with it): perspective 1200px, then
     rotateX(20deg), then skewX(.36rad) — EACH ON ITS OWN ELEMENT, because
     nested transforms flatten independently and one combined transform
     does not produce the same lean. The panel bleeds off the right edge
     under two mask fades: bottom (into the proof strip) and right. */
  .hero-shot {
    position: absolute;
    right: 0;
    bottom: 0; /* rises from just above the proof strip */
    /* as wide as the screen allows while holding a 660px reserve for the
       copy column — on a large monitor this is roughly double the grid
       column it replaces */
    /* wider than the panel needs: the tilt's left padding below is shear
       headroom, so the width formula hands that space back */
    width: clamp(640px, calc(100% - 480px), 1640px);
    /* NO overflow clip here: the projection's lean lives in the corners
       that rotateX and the skew push outside the box — clipping them
       flattens the whole panel back to a rectangle. The masks below and
       the section's own overflow handle every edge. */
    /* two fades intersected: the bottom melts into the proof strip, and
       the left melts into the hero so the panel has no hard entry edge
       where it passes behind the copy */
    -webkit-mask-image:
      linear-gradient(180deg, #000 55%, transparent 98%),
      linear-gradient(90deg, transparent 0%, #000 22%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(180deg, #000 55%, transparent 98%),
      linear-gradient(90deg, transparent 0%, #000 22%);
    mask-composite: intersect;
  }
  .hero-shot-tilt {
    perspective: 1200px;
    /* the reference's pl-56: room INSIDE the masked box for the corner
       the skew throws left — without it the fades eat the sheared
       corners and the projection reads as a flat rectangle */
    padding-left: clamp(6rem, 11vw, 15rem);
    margin-right: clamp(-16rem, -10vw, -4rem);
    -webkit-mask-image: linear-gradient(90deg, #000 55%, transparent 100%);
    mask-image: linear-gradient(90deg, #000 55%, transparent 100%);
  }
  .hero-shot-skew { transform: rotateX(20deg); }
  .hero-shot-skew > div,
  .hero-shot img { display: block; }
  .hero-shot img {
    width: 100%;
    height: auto;
    border-radius: 10px;
    border: 1px solid rgb(245 247 249 / 0.16);
    transform: skewX(0.36rad);
    box-shadow: 0 40px 90px -30px rgb(0 0 0 / 0.65);
  }

  /* Small screens: the projection reads as distortion at phone widths —
     the panel sits flat and full-width instead, bottom fade retained. */
  @media (max-width: 860px) {
    .hero-copy { min-height: 0; padding-bottom: 0; margin-left: 0; }
    .hero-shot {
      position: static;
      width: auto;
      margin: 32px 24px 0;
      max-height: clamp(220px, 38vh, 420px);
    }
    .hero-shot-tilt {
      margin-right: 0;
      padding-left: 0;
      -webkit-mask-image: none;
      mask-image: none;
    }
    .hero-shot-skew { transform: none; }
    .hero-shot img { transform: none; border-radius: 8px; }
  }
</style>
