---
// B1 — Hero, restaged 27 Aug 2026 (owner's directive, Linear reference):
// the block gains the site's first showcase
// shot — the WulfTek Tuning homepage, a real delivered client page, lying
// back at a Linear-style tilt below the copy. The copy itself is still the
// master build's verbatim hero text: chip → H1 → standfirst → CTA pair →
// trust line. Grid and burst remain drawn in CSS from token blues; the
// shot is a real capture (no mockups, §8), self-hosted (CSP allows no
// remote images). No JS, no island: this block is fully static — the tilt
// is a stylesheet transform.
---

<section class="hero">
  <div class="wrap hero-inner">
    <div class="hero-grid">
    <div class="hero-copy">
      <h1 class="t-display"><span class="line">You’re a specialist.</span><span class="line">Your website isn’t.</span></h1>

      <p class="standfirst">
        <span class="nowrap-sentence">The reason people choose you already exists.</span>
        <span class="nowrap-sentence">It’s just not on the page.</span>
      </p>

      <div class="ctas">
        <a class="btn btn-primary" href="#method">See how I work</a>
        <a class="btn btn-ghost" href="#work">See the work</a>
      </div>

      <p class="t-micro hero-trust">FIXED PRICE · WRITTEN SCOPE · YOU OWN EVERYTHING</p>
    </div>

    </div>
  </div>

  <!-- The overture (owner-supplied 21st import, restaged CSS-only): a 3D
       laptop tumbles through its open-close pass, lands open facing the
       viewer with the WulfTek page lit on its screen, then swells and
       hands off to the real panel below, which expands into place. Pure
       CSS keyframes, chained by delays; reduced motion skips straight to
       the panel. -->
  <div class="hero-theatre" aria-hidden="true">
    <div class="mb-frame">
      <div class="mb-inner">
        <div class="mb-screen">
          <div class="mb-screen-face">
            <div class="mb-camera"></div>
            <div class="mb-display">
              <img src="/images/work-wulftek-home.webp" alt="" loading="eager" decoding="async" />
              <div class="mb-glare"></div>
            </div>
          </div>
        </div>
        <div class="mb-body">
          <div class="mb-body-face">
            <div class="mb-trackpad"></div>
            <div class="mb-keyboard">
              {Array.from({ length: 58 }).map(() => <i class="mb-key"></i>)}
              <i class="mb-key mb-key-space"></i>
              {Array.from({ length: 16 }).map(() => <i class="mb-key mb-key-f"></i>)}
            </div>
          </div>
          <span class="mb-foot mb-foot-tl"></span><span class="mb-foot mb-foot-tr"></span>
          <span class="mb-foot mb-foot-bl"></span><span class="mb-foot mb-foot-br"></span>
        </div>
      </div>
      <div class="mb-shadow"></div>
    </div>
  </div>

  <!-- The showcase: real client work, angled off the page the way the
       reference presents its product. It sits at SECTION level, outside
       the width-capped wrap, so its absolute anchoring and sizing resolve
       against the full-bleed hero. The proof strip directly below names
       the client. -->
  <div class="hero-shot">
    <div class="hero-shot-tilt">
      <div class="hero-shot-skew">
        <img
          src="/images/work-wulftek-home.webp"
          width="1910"
          height="1026"
          alt="The WulfTek Tuning homepage — a delivered client site: registration lookup hero with the line ‘What could your car actually do?’"
          decoding="async"
          fetchpriority="high"
        />
      </div>
    </div>
  </div>
</section>

<style>
  /* Ground: ink-black, the blue burst rising behind the copy block. */
  .hero {
    position: relative;
    background:
      radial-gradient(720px 460px at 26% 34%, rgb(77 124 255 / 0.24), transparent 70%),
      radial-gradient(1100px 700px at 36% 26%, rgb(29 78 216 / 0.15), transparent 72%),
      var(--color-ink-deep);
    /* The header is sticky and, over the hero, surface-less: the hero
       pulls itself up behind it so what shows through the transparency is
       this ink, not the white body. The first 68px of padding are the
       header's own band. */
    margin-top: -68px;
    padding-top: calc(68px + clamp(20px, 4vh, 40px));
    padding-bottom: 0; /* the shot melts straight into the proof strip */
    overflow: clip;
  }
  /* The fine grid, fading out radially — drawn, not downloaded. */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(245 247 249 / 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgb(245 247 249 / 0.055) 1px, transparent 1px);
    background-size: 56px 56px;
    -webkit-mask-image: radial-gradient(70% 70% at 42% 34%, #000 40%, transparent 78%);
    mask-image: radial-gradient(70% 70% at 42% 34%, #000 40%, transparent 78%);
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    container-type: inline-size;
    /* uncapped for the hero only: the copy positions against the true
       free zone left of the panel, not against a viewport-centred column
       — on wide screens the wrap's centring pushed the text into the
       panel */
    max-width: none;
  }

  /* ---------- split stage: copy left, panel anchored bottom-right ---------- */
  /* The panel is no longer a grid column — the wrap's width cap made it a
     postage stamp on wide screens (owner: "way too small for a hero").
     It is absolutely anchored to the section's bottom-right, sized against
     the viewport with a reserve held for the copy, and the hero itself
     carries real height; the copy centres in what remains. */
  .hero-grid {
    display: block;
  }

  .hero-copy {
    container-type: inline-size; /* the H1 sizes itself to this column */
    position: relative;
    z-index: 2; /* above the panel if they ever meet */
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    justify-content: center;
    max-width: 720px;
    /* centred in the zone the panel leaves free. The constants are tied
       to the panel: 1180px = (its 1640px width cap + this 720px column)/2,
       so 50% − 1150px is the free zone's centre once the panel hits its
       cap; below that the viewport term holds a sane offset. */
    margin-left: max(24px, calc(50% - 1180px), min(5vw, 120px));
    min-height: clamp(620px, 84svh, 920px);
    padding-bottom: clamp(24px, 6vh, 72px);
  }

  /* The H1 must break exactly once, after "specialist." — at every
     breakpoint: each line is a hard block that never wraps, and the size
     is capped against the column so the longer line always fits. */
  .hero-copy h1 {
    margin-top: 0;
    font-size: min(clamp(3.25rem, 5.8vw, 5.5rem), 11.1cqw);
    letter-spacing: -0.015em; /* Clash sets a little looser than Bricolage */
    color: var(--color-sheet);
  }
  .hero-copy h1 .line {
    display: block;
    white-space: nowrap;
  }

  .standfirst {
    margin-top: 26px;
    max-width: 30em;
    color: rgb(245 247 249 / 0.68);
    font-family: var(--font-standfirst);
    font-size: clamp(1.25rem, 1.45vw, 1.5625rem);
    line-height: 1.55;
    font-weight: 400;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 32px;
  }
  /* the pair scale up with the rest of the copy */
  .ctas .btn {
    font-size: 1.0625rem;
    padding: 13px 26px;
  }
  .ctas .btn-ghost {
    color: var(--color-sheet);
    border-color: rgb(245 247 249 / 0.3);
  }
  .ctas .btn-ghost:hover { border-color: var(--color-sheet); }

  .hero-trust {
    margin-top: 36px;
    font-size: 0.78125rem;
    color: rgb(245 247 249 / 0.45);
  }

  /* ---------- the showcase shot ---------- */
  /* The panel's projection is the owner-supplied Tailark hero's, adopted
     mechanics-only per §7 (its nav, buttons and logo strip did not
     survive; no dependencies came with it): perspective 1200px, then
     rotateX(20deg), then skewX(.36rad) — EACH ON ITS OWN ELEMENT, because
     nested transforms flatten independently and one combined transform
     does not produce the same lean. The panel bleeds off the right edge
     under two mask fades: bottom (into the proof strip) and right. */
  .hero-shot {
    position: absolute;
    right: 0;
    bottom: 0; /* rises from just above the proof strip */
    /* held back until the laptop hands over, then expands out of the
       screen's position into its resting pose */
    opacity: 0;
    transform-origin: 62% 58%;
    animation: shot-arrive 900ms var(--ease) 5.15s forwards;
    /* as wide as the screen allows while holding a 660px reserve for the
       copy column — on a large monitor this is roughly double the grid
       column it replaces */
    /* wider than the panel needs: the tilt's left padding below is shear
       headroom, so the width formula hands that space back */
    width: clamp(640px, calc(100% - 480px), 1640px);
    /* NO overflow clip here: the projection's lean lives in the corners
       that rotateX and the skew push outside the box — clipping them
       flattens the whole panel back to a rectangle. The masks below and
       the section's own overflow handle every edge. */
    /* two fades intersected: the bottom melts into the proof strip, and
       the left melts into the hero so the panel has no hard entry edge
       where it passes behind the copy */
    -webkit-mask-image:
      linear-gradient(180deg, #000 55%, transparent 98%),
      linear-gradient(90deg, transparent 0%, #000 22%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(180deg, #000 55%, transparent 98%),
      linear-gradient(90deg, transparent 0%, #000 22%);
    mask-composite: intersect;
  }
  .hero-shot-tilt {
    perspective: 1200px;
    /* the reference's pl-56: room INSIDE the masked box for the corner
       the skew throws left — without it the fades eat the sheared
       corners and the projection reads as a flat rectangle */
    padding-left: clamp(6rem, 11vw, 15rem);
    margin-right: clamp(-16rem, -10vw, -4rem);
    -webkit-mask-image: linear-gradient(90deg, #000 55%, transparent 100%);
    mask-image: linear-gradient(90deg, #000 55%, transparent 100%);
  }
  .hero-shot-skew { transform: rotateX(20deg); }
  .hero-shot-skew > div,
  .hero-shot img { display: block; }
  .hero-shot img {
    width: 100%;
    height: auto;
    border-radius: 10px;
    border: 1px solid rgb(245 247 249 / 0.16);
    transform: skewX(0.36rad);
    box-shadow: 0 40px 90px -30px rgb(0 0 0 / 0.65);
  }

  /* ---------- the overture ---------- */
  /* The 21st MacBook, translated from its React/Tailwind form to plain
     markup and scoped keyframes — the same nested-3D construction, run
     ONCE: its final keyframes are retimed so the pass ends open, facing
     the viewer (rotateY 360, a whisper of X tilt), the display lights up
     with the WulfTek page, and the whole machine swells toward the
     camera as the real panel arrives beneath it. */
  .hero-theatre {
    position: absolute;
    right: min(30vw, 620px);
    bottom: 38%;
    width: 150px;
    height: 96px;
    scale: 3.1;
    pointer-events: none;
    animation: mb-exit 800ms var(--ease) 5.05s forwards;
  }
  .mb-frame {
    position: absolute;
    inset: 0;
    perspective: 500px;
  }
  .mb-inner {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform: rotateX(-20deg);
    animation: mb-rotate 4.6s ease-in-out both;
  }

  /* screen half */
  .mb-screen {
    position: absolute;
    left: 0; bottom: 0;
    width: 150px; height: 96px;
    border-radius: 7px;
    transform-style: preserve-3d;
    transform-origin: 50% 100%;
    background: linear-gradient(45deg, rgb(0 0 0 / 0.34), rgb(0 0 0 / 0)) left bottom / 300px 300px, #ddd;
    box-shadow: inset 0 3px 7px rgb(255 255 255 / 0.5);
    animation: mb-lid 4.6s ease-in-out both;
  }
  .mb-screen-face {
    position: absolute;
    left: 0; bottom: 0;
    width: 150px; height: 96px;
    border-radius: 7px;
    transform: translateZ(2px);
    background: linear-gradient(45deg, rgb(0 0 0 / 0.24), rgb(0 0 0 / 0)), #d3d3d3;
  }
  .mb-camera {
    position: absolute;
    left: 50%; top: 4px;
    width: 3px; height: 3px;
    margin-left: -1.5px;
    border-radius: 50%;
    background: #000;
  }
  .mb-display {
    position: relative;
    width: 130px; height: 74px;
    margin: 10px;
    border-radius: 1px;
    background: #000;
    overflow: hidden;
    box-shadow: inset 0 0 2px rgb(0 0 0);
  }
  /* the site on the screen: dark until the pass settles, then lit */
  .mb-display img {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: top;
    opacity: 0;
    animation: mb-content 700ms ease-out 3.55s forwards;
  }
  .mb-glare {
    position: absolute;
    inset: 0;
    background: linear-gradient(-135deg, rgb(255 255 255 / 0) 0%, rgb(255 255 255 / 0.1) 47%, rgb(255 255 255 / 0) 48%) 0 0 / 300px 200px;
    animation: mb-glare 4.6s ease-in-out both;
  }

  /* body half */
  .mb-body {
    position: absolute;
    left: 0; bottom: 0;
    width: 150px; height: 96px;
    border-radius: 7px;
    transform-style: preserve-3d;
    /* the hinge: BOTTOM edge, same edge the screen folds on — the import
       left this origin implicit and a top-edge guess folds the deck away
       from the viewer, landing it above the lid like a grille (the
       owner's reference video exposed it). Bottom-origin lays the deck
       flat toward the camera, beneath the screen, the pen's true pose. */
    transform-origin: 50% 100%;
    transform: rotateX(-90deg);
    background: linear-gradient(45deg, rgb(0 0 0 / 0.24), rgb(0 0 0 / 0)), #cbcbcb;
  }
  .mb-body-face {
    position: absolute;
    left: 0; bottom: 0;
    width: 150px; height: 96px;
    border-radius: 7px;
    transform-style: preserve-3d;
    transform: translateZ(-2px);
    background: linear-gradient(30deg, rgb(0 0 0 / 0.24), rgb(0 0 0 / 0)), #dfdfdf;
    animation: mb-deck 4.6s ease-in-out both;
  }
  .mb-trackpad {
    position: absolute;
    left: 50%; top: 50%;
    width: 40px; height: 31px;
    margin: -44px 0 0 -18px;
    border-radius: 4px;
    background: linear-gradient(30deg, rgb(0 0 0 / 0.24), rgb(0 0 0 / 0)), #cdcdcd;
    box-shadow: inset 0 0 3px #888;
  }
  .mb-keyboard {
    position: absolute;
    left: 7px; top: 41px;
    width: 130px; height: 45px;
    border-radius: 4px;
    padding-left: 2px;
    overflow: hidden;
    background: linear-gradient(30deg, rgb(0 0 0 / 0.24), rgb(0 0 0 / 0)), #cdcdcd;
    box-shadow: inset 0 0 3px #777;
  }
  .mb-key {
    float: left;
    width: 6px; height: 6px;
    margin: 1px;
    border-radius: 2px;
    background: #444;
    transform: translateZ(-2px);
    box-shadow: 0 -2px 0 #222;
    animation: mb-keys 4.6s ease-in-out both;
  }
  .mb-key-space { width: 45px; }
  .mb-key-f { height: 3px; }
  .mb-foot {
    position: absolute;
    width: 5px; height: 5px;
    border-radius: 50%;
    background: #333;
  }
  .mb-foot-tl { left: 20px; top: 20px; }
  .mb-foot-tr { right: 20px; top: 20px; }
  .mb-foot-bl { left: 20px; bottom: 20px; }
  .mb-foot-br { right: 20px; bottom: 20px; }

  .mb-shadow {
    position: absolute;
    left: 40px; top: 160px;
    width: 60px; height: 0;
    transform: rotateX(80deg);
    box-shadow: 0 0 60px 40px rgb(0 0 0 / 0.3);
    animation: mb-shadow 4.6s ease-in-out both;
  }

  /* ---------- the choreography (the import's keyframes, retimed to
       land open and facing the viewer) ---------- */
  @keyframes mb-rotate {
    0%   { transform: rotateX(-20deg) rotateY(0deg); }
    5%   { transform: rotateX(-20deg) rotateY(-20deg); }
    20%  { transform: rotateX(30deg) rotateY(200deg); }
    25%  { transform: rotateX(-60deg) rotateY(150deg); }
    60%  { transform: rotateX(-20deg) rotateY(130deg); }
    65%  { transform: rotateX(-20deg) rotateY(120deg); }
    /* the tail is the import's, VERBATIM: the pen's -20deg landing is its
       face-on pose, screen up with the keyboard deck showing beneath —
       flattening it further (tried at -6 and -12) hides the deck, turns
       the machine into a bezelled tablet, and walks the pose through the
       band where the deck's far key row peeks above the lid */
    80%  { transform: rotateX(-20deg) rotateY(375deg); }
    85%  { transform: rotateX(-20deg) rotateY(357deg); }
    87%  { transform: rotateX(-20deg) rotateY(360deg); }
    100% { transform: rotateX(-20deg) rotateY(360deg); }
  }
  @keyframes mb-lid {
    0%   { transform: rotateX(0deg); background-position: left bottom; }
    5%   { transform: rotateX(50deg); background-position: left bottom; }
    20%  { transform: rotateX(-90deg); background-position: -150px top; }
    25%  { transform: rotateX(15deg); background-position: left bottom; }
    30%  { transform: rotateX(-5deg); background-position: right top; }
    38%  { transform: rotateX(5deg); background-position: right top; }
    48%  { transform: rotateX(0deg); background-position: right top; }
    100% { transform: rotateX(0deg); background-position: right center; }
  }
  @keyframes mb-deck {
    0%, 50%, 100% { background-color: #dfdfdf; }
    25% { background-color: #bbb; }
  }
  @keyframes mb-glare {
    0%   { background-position: -20px 0; }
    5%   { background-position: -40px 0; }
    20%  { background-position: 200px 0; }
    50%  { background-position: -200px 0; }
    80%  { background-position: 0 0; }
    100% { background-position: -20px 0; }
  }
  @keyframes mb-keys {
    0%   { box-shadow: 0 -2px 0 #222; }
    5%   { box-shadow: 1px -1px 0 #222; }
    20%, 60% { box-shadow: -1px 1px 0 #222; }
    80%, 100% { box-shadow: 0 -2px 0 #222; }
  }
  @keyframes mb-shadow {
    0%   { transform: rotateX(80deg); box-shadow: 0 0 60px 40px rgb(0 0 0 / 0.3); }
    20%  { transform: rotateX(30deg) rotateY(-20deg) rotateZ(-20deg); box-shadow: 0 0 50px 30px rgb(0 0 0 / 0.3); }
    25%  { transform: rotateX(80deg) rotateY(-20deg) rotateZ(50deg); box-shadow: 0 0 35px 15px rgb(0 0 0 / 0.1); }
    60%  { transform: rotateX(80deg) rotateZ(-50deg) translateX(30px); box-shadow: 0 0 60px 40px rgb(0 0 0 / 0.3); }
    100% { transform: rotateX(80deg); box-shadow: 0 0 60px 40px rgb(0 0 0 / 0.3); }
  }
  @keyframes mb-content {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  /* the machine swells toward the camera and yields */
  @keyframes mb-exit {
    0%   { opacity: 1; scale: 3.1; }
    100% { opacity: 0; scale: 5.4; }
  }
  /* ...as the real panel expands out of its position */
  @keyframes shot-arrive {
    0%   { opacity: 0; scale: 0.42; }
    100% { opacity: 1; scale: 1; }
  }

  /* No theatre for reduced motion: the panel is simply there. */
  @media (prefers-reduced-motion: reduce) {
    .hero-theatre { display: none; }
    .hero-shot { opacity: 1; animation: none; }
  }

  /* Small screens: the projection reads as distortion at phone widths —
     the panel sits flat and full-width instead, bottom fade retained. */
  @media (max-width: 860px) {
    .hero-copy { min-height: 0; padding-bottom: 0; margin-left: 0; }
    .hero-theatre { display: none; }
    .hero-shot {
      position: static;
      width: auto;
      margin: 32px 24px 0;
      max-height: clamp(220px, 38vh, 420px);
      opacity: 1;
      animation: none;
    }
    .hero-shot-tilt {
      margin-right: 0;
      padding-left: 0;
      -webkit-mask-image: none;
      mask-image: none;
    }
    .hero-shot-skew { transform: none; }
    .hero-shot img { transform: none; border-radius: 8px; }
  }
</style>
