---
import "../styles/theme.css";

interface Props {
  path?: string;
  noindex?: boolean;
  schema?: object;
  title: string;
  description: string;
  /* per-page share card (28 Aug, owner: a link photo for each page) —
     public/ path to a 1200×630 image; the lockup card is the default */
  ogImage?: string;
  ogAlt?: string;
}
const {
  title,
  description,
  path = "/",
  noindex = false,
  schema,
  ogImage = "/og-card.png",
  ogAlt = "Talon Insights — the falcon-feather mark on ink",
} = Astro.props;
const pageUrl = "https://taloninsights.co.uk" + path;
const ogImageUrl = "https://taloninsights.co.uk" + ogImage;

// §1 revised 27 Aug (owner: "fix the fonts… deploy sitewide") — the site
// speaks the high-tech tri-stack from the design database: Space Grotesk
// (display), Inter (body/UI), JetBrains Mono (labels + data). Clash
// Display / General Sans / Bricolage / Instrument retired from the site
// voice (self-hosted woff2 files remain in public/fonts, unreferenced).
// Martian Mono + Oswald + Fraunces still load ONLY for the Wrekin Forge
// direction comps/pages, which render their own type by design (§6/B5).
const fontsHref =
  "https://fonts.googleapis.com/css2" +
  "?family=Space+Grotesk:wght@300..700" + // full variable range: the About label's proximity effect drives the wght axis
  "&family=Inter:ital,wght@0,400..700;1,400..700" +
  "&family=JetBrains+Mono:ital,wght@0,400..700;1,400..700" +
  "&family=Martian+Mono:wght@400..700" +
  "&family=Oswald:wght@500;600" +
  "&family=Fraunces:ital,opsz,wght@0,9..144,400..600;1,9..144,400..600" +
  "&display=swap";
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0B1F3A" />
    <meta name="color-scheme" content="light" />
    <meta name="author" content="Talon Herring" />
    <meta name="google-site-verification" content="2SyksDOt0vYVoEiM5YYcrNkn3MnqeEzlxkikjGohcOU" />

    <meta property="og:site_name" content="Talon Insights" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontsHref} />
    <script>
      /* Retired-anchor safety net (28 Aug): #pricing was a homepage
         section until B8 withdrew; stale cached pages and old bookmarks
         still point at it. Fragments never reach the server, so the
         redirect has to live here. Only retired anchors are mapped —
         live section hashes pass untouched. */
      const retired: Record<string, string> = { "#pricing": "/pricing" };
      const dest = retired[location.hash];
      /* one attempt per session: browsers that cached the old permanent
         /pricing→/#pricing redirect would otherwise ping-pong forever */
      if (dest && !sessionStorage.getItem("ti-anchor-redirect")) {
        sessionStorage.setItem("ti-anchor-redirect", "1");
        location.replace(dest);
      }
    </script>
  </head>
  <body>
    <slot />

    <script>
      // §5 — the page's quiet motion layer. Two rules govern everything here:
      // reveals run once, and reduced-motion gets final frames with nothing
      // animated. Elements above the fold when this runs are never hidden.
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (!reduce && "IntersectionObserver" in window) {
        // Scroll reveals: opacity + 14px, threshold .15, once.
        const reveals = Array.from(document.querySelectorAll("[data-rv]"));
        const fold = window.innerHeight * 0.9;
        const armed = [];
        let anyFired = false;
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              anyFired = true;
              entry.target.classList.add("is-in");
              io.unobserve(entry.target);
            }
          },
          { threshold: 0.15 },
        );
        for (const el of reveals) {
          if (el.getBoundingClientRect().top <= fold) continue;
          el.classList.add("rv");
          armed.push(el);
          io.observe(el);
        }

        // Orchestrated moment 2 of 3: the process bars draw on first
        // scroll-in (threshold .3), once. Armed only here so no-JS and
        // reduced-motion render the bars complete. (Moments 1 and 3 — the
        // hero plan bars and the coverage-map travel — manage themselves.)
        const process = document.querySelector("[data-process]");
        if (process) {
          process.classList.add("pb-armed");
          const pio = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                anyFired = true;
                process.classList.add("pb-draw");
                pio.disconnect();
              }
            },
            { threshold: 0.3 },
          );
          pio.observe(process);
        }

        // Failsafe: if the observers stay silent (a browser that never
        // composites, an embedder that suspends IO), reveal everything at
        // final state. Content must never be left invisible.
        window.setTimeout(() => {
          if (anyFired) return;
          io.disconnect();
          for (const el of armed) el.classList.add("is-in");
          if (process) process.classList.add("pb-draw");
        }, 2500);
      }
    </script>
  </body>
</html>
