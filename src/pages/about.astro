---
// /about — the real page (28 Aug, owner: "complete and sophisticated",
// then "more rustic and authentic… reflect the personal element").
// Same scheme, different material: the photographs hang as matted PRINTS
// (sheet-white mattes, tape corners, a degree or two off square,
// straightening on touch), the story reads as a LETTER (Fraunces — already
// in the site head for the heritage demo — with a drop cap), and the
// rules are dashed, hand-ruled lines rather than machine hairlines.
// Space Grotesk keeps the headings so the page is still unmistakably this
// site. Copy unchanged from the first build; the visit story remains the
// rehomed pre-restage B4 prose. noindex stays dropped; /about is in the
// sitemap.
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const ways = [
  { key: "ON SITE", value: "Time where you work, at your events, with your customers" },
  { key: "THE WORD SURVEY", value: "The phrases your customers use that nobody’s competing for" },
  { key: "DIRECTIONS FIRST", value: "Real options before any code — chosen by you" },
  { key: "OPEN LINE", value: "Message me during the build; ideas fold in as they come" },
];
---

<Base
  title="About — Talon Insights"
  description="Who you’d be hiring: one person who runs the project and builds it — a qualified Associate Project Manager who ships full-stack, working from Telford."
  path="/about"
>
  <Header />
  <main>
    <!-- ---------- the introduction ---------- -->
    <section class="ab-hero g-ink">
      <div class="ab-wrap">
        <div class="ab-hero-grid">
          <div class="ab-hero-copy">
            <p class="t-micro eyebrow">ABOUT</p>
            <h1 class="ab-h1">One person. Both halves of the&nbsp;job.</h1>
            <p class="ab-body">
              Most developers can’t run a project to time and budget. Most project managers
              can’t build. I do both — and it’s just me, which is the point: the person you
              meet on site is the person who designs, builds, and answers the phone.
            </p>
            <p class="ab-body">
              Talon Insights exists because the businesses worth building for are
              specialists — and their websites almost never say so. Finding what the page
              should say takes time in the room where the work happens. So that’s where
              every job starts.
            </p>
          </div>
          <div class="ab-photo ab-tilt-l" data-rv>
            <figure class="ab-print">
              <span class="ab-tape ab-tape-l" aria-hidden="true"></span>
              <span class="ab-tape ab-tape-r" aria-hidden="true"></span>
              <img
                src="/images/about-meeting.webp"
                width="1443" height="941"
                alt="Talon Herring in a first meeting — armchair, notebook open, client across the table."
                fetchpriority="high"
              />
              <figcaption class="ab-note">The first visit — notebook first.</figcaption>
            </figure>
          </div>
        </div>
      </div>
    </section>

    <!-- ---------- where it comes from ---------- -->
    <section class="ab-story g-ink">
      <div class="ab-wrap">
        <p class="t-micro eyebrow" data-rv>WHERE IT COMES FROM</p>
        <h2 class="t-h2 ab-h2" data-rv>The difference never comes out in a&nbsp;questionnaire.</h2>
        <div class="ab-story-body" data-rv>
          <p class="ab-letter-open">
            Before I design anything, I turn up. I’ve stood in David Jackson’s workshop
            watching timber become something that ends up in listed buildings. I’ve been
            to events with WulfTek to hear what their customers actually say about them —
            not what the website says.
          </p>
          <p>
            That’s where the difference lives. It comes out on the third visit, in
            something said offhand — a phrase a customer uses, a step in the process
            nobody thought was worth mentioning, the thing the owner apologises for that
            is actually the whole reason people come back.
          </p>
          <p>
            Then we design from it. You see real directions before any code, you tell me
            what’s wrong with them, and you can message me the moment you have a better
            idea — all the way through. It’s just me, so there’s nobody in&nbsp;between.
          </p>
        </div>
      </div>
    </section>

    <!-- ---------- the way of working ---------- -->
    <section class="ab-split g-ink">
      <div class="ab-wrap">
        <div class="ab-split-grid">
          <div class="ab-photo ab-tilt-r" data-rv>
            <figure class="ab-print">
              <span class="ab-tape ab-tape-l" aria-hidden="true"></span>
              <span class="ab-tape ab-tape-r" aria-hidden="true"></span>
              <img
                src="/images/about-window.webp"
                width="1600" height="900"
                loading="lazy" decoding="async"
                alt="Reading back through the visit notes — notebook against the laptop, Telford outside the window."
              />
              <figcaption class="ab-note">The notes do the designing. Telford, out the window.</figcaption>
            </figure>
          </div>
          <div class="ab-split-copy" data-rv>
            <p class="t-micro eyebrow">HOW I WORK</p>
            <h2 class="t-h2 ab-h2">The notebook fills before the laptop&nbsp;opens.</h2>
            <div class="ab-rows">
              {ways.map((row) => (
                <div class="ab-row">
                  <span class="t-mono ab-row-key">{row.key}</span>
                  <span class="ab-row-value">{row.value}</span>
                </div>
              ))}
            </div>
            <a class="ab-link" href="/#method">See the approach in full →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ---------- the build side ---------- -->
    <section class="ab-split g-ink">
      <div class="ab-wrap">
        <div class="ab-split-grid ab-split-rev">
          <div class="ab-split-copy" data-rv>
            <p class="t-micro eyebrow">THE BUILD SIDE</p>
            <h2 class="t-h2 ab-h2">Then it gets built — properly, and to the&nbsp;plan.</h2>
            <p class="ab-body">
              The project management is formally trained, not improvised: I’m a qualified
              Associate Project Manager with four years of running projects where scope
              and deadlines were not negotiable. Your build gets milestones against real
              dates, a written scope, and a price fixed before it starts.
            </p>
            <p class="ab-body">
              The building is full-stack — Supabase, Stripe, Three.js, shipped through
              GitHub and Vercel — and when it’s done, the domain, the code and the
              content are yours.
            </p>
            <a class="ab-link" href="/#process">See the five steps →</a>
          </div>
          <div class="ab-photo ab-tilt-l" data-rv>
            <figure class="ab-print">
              <span class="ab-tape ab-tape-l" aria-hidden="true"></span>
              <span class="ab-tape ab-tape-r" aria-hidden="true"></span>
              <img
                src="/images/about-studio.webp"
                width="1600" height="900"
                loading="lazy" decoding="async"
                alt="At the desk, building — the quiet half of the job."
              />
              <figcaption class="ab-note">The quiet half — designed, then shipped.</figcaption>
            </figure>
          </div>
        </div>

        <p class="ab-facts t-mono" data-rv>
          QUALIFIED ASSOCIATE PROJECT MANAGER<i>◆</i>FOUR YEARS ON HARD DEADLINES<i>◆</i>FULL-STACK, SHIPPED<i>◆</i>TELFORD — AN HOUR FROM EVERYWHERE ON THE MAP
        </p>
      </div>
    </section>

    <!-- ---------- the ask ---------- -->
    <section class="ab-close g-ink">
      <div class="ab-wrap">
        <h2 class="t-h2 ab-h2">Let’s find what makes you&nbsp;different.</h2>
        <p class="ab-close-lede">
          The first visit is free within an hour of Telford — and whatever we find is
          yours to keep, whether or not we go ahead.
        </p>
        <div class="ab-ctas">
          <a class="btn btn-primary" href="/booking">Book a visit</a>
          <a class="btn btn-ghost ab-ghost" href="/#work">See the work</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .ab-wrap {
    max-width: 1560px;
    margin-inline: auto;
    padding-inline: 24px;
  }
  .ab-h2 { color: var(--color-sheet); }

  /* ---------- shared voice ---------- */
  /* the running text goes to Fraunces — the letter voice, not the panel
     voice; the scheme's colours are untouched */
  .ab-body {
    margin-top: 20px;
    font-family: "Fraunces", Georgia, serif;
    font-size: 1.25rem;
    line-height: 1.7;
    color: rgb(245 247 249 / 0.8);
    max-width: 38em;
  }
  .ab-link {
    display: inline-block;
    margin-top: 26px;
    font-family: "Fraunces", Georgia, serif;
    font-style: italic;
    font-size: 1.125rem;
    color: var(--color-cobalt-lift);
    text-decoration: none;
    border-bottom: 1px dashed rgb(77 124 255 / 0.45);
    padding-bottom: 2px;
    transition: color 180ms var(--ease), border-color 180ms var(--ease);
  }
  .ab-link:hover { color: var(--color-sheet); border-color: rgb(245 247 249 / 0.5); }

  /* ---------- the prints ---------- */
  /* photographs hang as matted prints: a sheet-white matte, tape at the
     corners, a degree or two off square — straightening when touched */
  .ab-photo { display: flex; justify-content: center; }
  .ab-print {
    position: relative;
    margin: 0;
    background: var(--color-sheet);
    padding: 14px 14px 12px;
    box-shadow:
      0 24px 60px -18px rgb(0 0 0 / 0.65),
      0 6px 18px -6px rgb(0 0 0 / 0.5);
    transition: rotate 320ms var(--ease), box-shadow 320ms var(--ease);
  }
  .ab-tilt-l .ab-print { rotate: -1.6deg; }
  .ab-tilt-r .ab-print { rotate: 1.3deg; }
  .ab-photo:hover .ab-print {
    rotate: 0deg;
    box-shadow:
      0 30px 70px -18px rgb(0 0 0 / 0.7),
      0 6px 18px -6px rgb(0 0 0 / 0.5);
  }
  .ab-print img { display: block; width: 100%; height: auto; }
  .ab-tape {
    position: absolute;
    top: -12px;
    width: 74px;
    height: 26px;
    background: rgb(245 247 249 / 0.22);
    border-inline: 1px solid rgb(245 247 249 / 0.12);
    backdrop-filter: blur(1px);
  }
  .ab-tape-l { left: 8%; rotate: -6deg; }
  .ab-tape-r { right: 8%; rotate: 5deg; }
  /* the caption is written on the matte, not printed under glass */
  .ab-note {
    padding: 10px 4px 2px;
    font-family: "Fraunces", Georgia, serif;
    font-style: italic;
    font-size: 1.0625rem;
    text-align: center;
    color: var(--color-ink);
  }

  /* ---------- the introduction ---------- */
  .ab-hero {
    padding-block: 150px 110px;
    background:
      radial-gradient(900px 520px at 80% 24%, rgb(29 78 216 / 0.2), transparent 68%),
      radial-gradient(800px 440px at 8% 84%, rgb(29 78 216 / 0.1), transparent 70%),
      var(--color-ink-deep);
  }
  .ab-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    gap: clamp(40px, 5vw, 96px);
    align-items: center;
  }
  .ab-h1 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.5rem, 3.4vw, 4.25rem);
    line-height: 1.06;
    letter-spacing: -0.02em;
    color: var(--color-sheet);
  }
  .ab-hero-copy .ab-body:first-of-type { margin-top: 28px; }

  /* ---------- the story: a letter ---------- */
  .ab-story {
    padding-block: 110px;
    background:
      radial-gradient(700px 400px at 50% 0%, rgb(29 78 216 / 0.08), transparent 72%),
      var(--color-ink-deep);
    border-top: 1px dashed rgb(245 247 249 / 0.14);
  }
  .ab-story-body {
    margin-top: 30px;
    max-width: 42em;
  }
  .ab-story-body p {
    font-family: "Fraunces", Georgia, serif;
    font-size: 1.3125rem;
    line-height: 1.75;
    color: rgb(245 247 249 / 0.82);
  }
  .ab-story-body p + p { margin-top: 20px; }
  /* the letter opens with a drop cap — Fraunces at its most personal */
  .ab-letter-open::first-letter {
    font-family: "Fraunces", Georgia, serif;
    font-weight: 600;
    font-size: 3.4em;
    line-height: 0.82;
    float: left;
    padding: 6px 12px 0 0;
    color: var(--color-cobalt-lift);
  }

  /* ---------- the splits ---------- */
  .ab-split {
    padding-block: 110px;
    background:
      radial-gradient(900px 500px at 16% 30%, rgb(29 78 216 / 0.12), transparent 70%),
      var(--color-ink-deep);
    border-top: 1px dashed rgb(245 247 249 / 0.14);
  }
  .ab-split + .ab-split {
    background:
      radial-gradient(900px 500px at 84% 30%, rgb(29 78 216 / 0.12), transparent 70%),
      var(--color-ink-deep);
  }
  .ab-split-grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    gap: clamp(40px, 5vw, 96px);
    align-items: center;
  }
  .ab-rows { margin-top: 28px; max-width: 40em; }
  .ab-row {
    padding-block: 14px;
    border-top: 1px dashed rgb(245 247 249 / 0.18);
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: 8px 20px;
    align-items: baseline;
  }
  .ab-row:last-child { border-bottom: 1px dashed rgb(245 247 249 / 0.18); }
  .ab-row-key { color: var(--color-cobalt-lift); font-weight: 700; letter-spacing: 0.08em; }
  .ab-row-value {
    font-family: "Fraunces", Georgia, serif;
    font-size: 1.1875rem;
    line-height: 1.6;
    color: rgb(245 247 249 / 0.82);
  }

  .ab-facts {
    margin-top: 72px;
    padding-top: 24px;
    border-top: 1px dashed rgb(245 247 249 / 0.18);
    text-align: center;
    font-size: 0.9375rem;
    letter-spacing: 0.12em;
    line-height: 2;
    color: rgb(245 247 249 / 0.6);
  }
  .ab-facts i {
    font-style: normal;
    margin-inline: 12px;
    font-size: 0.625rem;
    vertical-align: 1px;
    color: rgb(77 124 255 / 0.7);
  }

  /* ---------- the ask ---------- */
  .ab-close {
    padding-block: 120px;
    text-align: center;
    background:
      radial-gradient(800px 460px at 50% 20%, rgb(29 78 216 / 0.1), transparent 70%),
      #04080F; /* flows into the footer's ground */
    border-top: 1px dashed rgb(245 247 249 / 0.16);
  }
  .ab-close-lede {
    margin-inline: auto;
    margin-top: 14px;
    max-width: 34em;
    font-family: "Fraunces", Georgia, serif;
    font-style: italic;
    font-size: 1.3125rem;
    line-height: 1.65;
    color: rgb(245 247 249 / 0.75);
  }
  .ab-ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; margin-top: 36px; }
  .ab-ghost { color: var(--color-sheet); border-color: rgb(245 247 249 / 0.3); }
  .ab-ghost:hover { border-color: var(--color-sheet); }

  /* ---------- responsive ---------- */
  @media (max-width: 899.98px) {
    .ab-hero { padding-block: 120px 88px; }
    .ab-story, .ab-split { padding-block: 88px; }
    .ab-hero-grid, .ab-split-grid { grid-template-columns: 1fr; gap: 48px; }
    .ab-split-rev .ab-photo { order: 2; }
    .ab-row { grid-template-columns: 1fr; gap: 4px; }
    .ab-facts { margin-top: 56px; line-height: 2.2; }
    .ab-close { padding-block: 96px; }
    .ab-tilt-l .ab-print, .ab-tilt-r .ab-print { rotate: 0deg; }
  }
</style>
