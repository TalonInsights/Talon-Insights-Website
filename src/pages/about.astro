---
// /about — fourth take (28 Aug, owner: "pull an about page from 21st dev
// and implement the colour scheme — freedom over everything else").
// This IS the 21st import: ruixen.ui "About Page" (demo 8581), adopted
// faithfully — the rounded hero banner, the two-tone split headline with
// its chip CTA, the About header pair, and the three-card row (big image
// left; a dark media card with gradient fade + outline button, and an
// image card with overlay text, both scaling on hover). Translated from
// Next/shadcn/framer to plain Astro + scoped CSS per §7 (zero deps: the
// hover springs are CSS transitions, the Buttons are hand-rolled). Only
// the palette changed: ink-deep ground, sheet type, cobalt accents, the
// deep close black for the dark card. Photography is the owner's shoot.
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Base
  title="About — Talon Insights"
  description="Who you’d be hiring: one person who runs the project and builds it — a qualified Associate Project Manager who ships full-stack, working from Telford."
  path="/about"
  schema={{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "AboutPage",
        "@id": "https://taloninsights.co.uk/about#page",
        url: "https://taloninsights.co.uk/about",
        name: "About — Talon Insights",
        about: { "@id": "https://taloninsights.co.uk/#business" },
      },
      {
        "@type": "Person",
        "@id": "https://taloninsights.co.uk/about#talon",
        name: "Talon Herring",
        jobTitle: "Founder — websites & software",
        worksFor: { "@id": "https://taloninsights.co.uk/#business" },
        address: { "@type": "PostalAddress", addressLocality: "Telford", addressRegion: "Shropshire", addressCountry: "GB" },
        knowsAbout: [
          "Web design", "Custom software", "Project management",
          "Supabase", "Stripe", "Three.js",
        ],
      },
    ],
  }}
>
  <Header />
  <main class="au">

    <!-- ---------------- HERO ---------------- -->
    <section class="au-hero">
      <div class="au-wrap">
        <div class="au-about-head au-page-open">
          <p class="au-h2">About</p><!-- label, not a heading: the h1 lives below -->
          <p>
            Before anything gets designed, I turn up — time in your workshop watching
            the work happen, at your events hearing what customers actually say. The
            difference never comes out in a questionnaire; it comes out on the third
            visit, in something said offhand. Then we design from it.
          </p>
        </div>

        <img
          class="au-banner"
          src="/images/about-meeting.webp"
          width="1443" height="941"
          alt="Talon Herring in a first meeting — armchair, notebook open, client across the table."
          fetchpriority="high"
        />

        <div class="au-hero-grid">
          <h1 class="au-headline">
            Talon Insights is <span class="au-accent">one person</span>{" "}
            <span class="au-dim">— the project manager and the builder in the same chair.</span>
          </h1>
          <div class="au-hero-side">
            <p>
              Most developers can’t run a project to time and budget. Most project
              managers can’t build. I do both — and the person you meet on site is the
              person who designs, builds, and answers the phone.
            </p>
            <a class="au-chip" href="/booking">
              <span>Book a visit</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ---------------- ABOUT ---------------- -->
    <section class="au-about">
      <div class="au-wrap">
        <!-- ---------------- THE THREE-CARD ROW ---------------- -->
        <div class="au-cards">
          <!-- left big image -->
          <div class="au-cards-left">
            <img
              src="/images/about-window.webp"
              width="1600" height="900"
              loading="lazy" decoding="async"
              alt="Reading back through the visit notes — notebook against the laptop, Telford outside the window."
            />
          </div>

          <!-- right two cards -->
          <div class="au-cards-right">
            <!-- dark media card -->
            <article class="au-card au-card-dark">
              <div class="au-card-media">
                <img
                  src="/images/about-studio.webp"
                  width="1600" height="900"
                  loading="lazy" decoding="async"
                  alt="At the desk, building — the quiet half of the job."
                />
                <div class="au-fade" aria-hidden="true"></div>
              </div>
              <div class="au-card-body">
                <h3>The build side</h3>
                <p>
                  A qualified Associate Project Manager who ships full-stack — Supabase,
                  Stripe, Three.js — with milestones against real dates, a written scope,
                  and a price fixed before the build starts.
                </p>
                <a class="au-outline" href="/#process">See the five steps</a>
              </div>
            </article>

            <!-- overlay image card -->
            <article class="au-card au-card-overlay">
              <img
                src="/images/talon-portrait.webp"
                width="640" height="360"
                loading="lazy" decoding="async"
                alt="Talon Herring at a client table, notebook open, pen in hand."
              />
              <div class="au-overlay">
                <h3>On site first</h3>
                <p>
                  Notebook and pen before a laptop — from Telford, everywhere on the
                  coverage map is within an hour, and the first visit is free.
                </p>
              </div>
            </article>
          </div>
        </div>
      </div>
    </section>

    <!-- ---------------- THE JOURNEY ---------------- -->
    <!-- why Talon Insights exists — the same header-pair + card language
         as the rest of the import, laid as four connected steps -->
    <section class="au-journey">
      <div class="au-wrap">
        <div class="au-about-head">
          <h2 class="au-h2">Why Talon Insights&nbsp;exists</h2>
          <p>
            It wasn’t a business plan first. It was a pattern that kept repeating —
            noticed from inside other people’s projects — until building the answer
            was the only honest response.
          </p>
        </div>

        <ol class="au-steps">
          <li class="au-step">
            <span class="au-step-n">01</span>
            <h3>The project years</h3>
            <p>
              Four years running projects where scope and deadlines were not
              negotiable taught me what delivery actually takes — the plan, the
              milestones, the phone call before the surprise.
            </p>
          </li>
          <li class="au-step">
            <span class="au-step-n">02</span>
            <h3>The pattern</h3>
            <p>
              Everywhere I looked, good businesses were being let down the same seven
              ways — sold by one person, built by another, locked in, and left with a
              pretty site that did nothing.
            </p>
          </li>
          <li class="au-step">
            <span class="au-step-n">03</span>
            <h3>The discovery</h3>
            <p>
              Standing in a joinery workshop, listening at a tuner’s events, it
              clicked: the reason people choose a specialist already exists — it just
              never survives the handoffs between the people building the website.
            </p>
          </li>
        </ol>

        <!-- the arrival — full width, because it's the point -->
        <div class="au-step-final au-card">
          <div class="au-final-lead">
            <span class="au-step-n au-step-n-final">04</span>
            <div>
              <h3>Talon Insights</h3>
              <p>
                So I removed the handoffs. One person who finds the difference on
                site, designs from it, builds it, and answers the phone — with
                everything yours at the end.
              </p>
            </div>
          </div>
          <a class="au-chip au-final-chip" href="/booking">
            <span>Start your own chapter</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  /* the import's design, the site's colours — flat ink ground */
  .au { background: var(--color-ink-deep); }
  .au-wrap {
    max-width: 1560px; /* widened to the site's full measure (owner) */
    margin-inline: auto;
    padding-inline: 24px;
  }

  /* ---------------- hero ---------------- */
  .au-hero { padding-block: 132px 64px; }
  .au-page-open { margin-bottom: 48px; }
  .au-banner {
    display: block;
    width: 100%;
    height: clamp(260px, 36vw, 560px);
    object-fit: cover;
    border-radius: 12px;
  }
  .au-hero-grid {
    margin-top: 40px;
    display: grid;
    gap: 24px;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 768px) {
    .au-hero-grid { grid-template-columns: 7fr 5fr; gap: clamp(48px, 5vw, 96px); }
  }
  .au-headline {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.75rem, 2.4vw, 2.5rem);
    line-height: 1.35;
    color: var(--color-sheet);
  }
  .au-accent { color: var(--color-cobalt-lift); }
  .au-dim { color: rgb(245 247 249 / 0.55); }
  .au-hero-side { display: flex; flex-direction: column; gap: 24px; align-items: flex-start; }
  .au-hero-side p {
    font-size: 1.125rem;
    line-height: 1.65;
    color: rgb(245 247 249 / 0.65);
  }
  /* the import's small secondary chip button */
  .au-chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 8px 6px 8px 14px;
    border-radius: 8px;
    background: rgb(245 247 249 / 0.1);
    color: var(--color-sheet);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 180ms var(--ease);
  }
  .au-chip:hover { background: rgb(245 247 249 / 0.16); }
  .au-chip svg { width: 16px; height: 16px; }

  /* ---------------- about ---------------- */
  .au-about { padding-block: 24px 120px; }
  .au-about-head {
    display: grid;
    gap: 24px;
    text-align: center;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 768px) {
    .au-about-head { grid-template-columns: 5fr 7fr; gap: clamp(48px, 5vw, 96px); text-align: left; }
  }
  .au-h2 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.25rem, 3.2vw, 3rem);
    color: var(--color-sheet);
  }
  /* :not(.au-h2): the About label is a p now (heading-order fix) and
     this paragraph rule out-specified .au-h2, shrinking it to lede size */
  .au-about-head p:not(.au-h2) {
    font-size: 1.375rem; /* the page opener earns lede size (owner) */
    line-height: 1.65;
    color: rgb(245 247 249 / 0.72);
  }

  /* ---------------- the three-card row ---------------- */
  .au-cards {
    margin-top: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  @media (min-width: 768px) {
    .au-cards { flex-direction: row; }
    .au-cards-left, .au-cards-right { flex: 1; }
  }
  .au-cards-left img {
    display: block;
    width: 100%;
    height: 300px;
    object-fit: cover;
    /* the landscape source in a portrait column: bias the crop to the
       right where the subject sits, or cover() centres him half out of
       frame — 82% keeps him whole with the lake still reading behind */
    object-position: 82% center;
    border-radius: 12px;
  }
  @media (min-width: 640px) { .au-cards-left img { height: 400px; } }
  @media (min-width: 768px) { .au-cards-left img { height: 100%; } }

  .au-cards-right { display: flex; flex-direction: column; gap: 24px; }

  /* both cards scale gently on hover — the import's spring, as CSS */
  .au-card {
    position: relative;
    overflow: hidden;
    border-radius: 12px;
    transition: transform 320ms cubic-bezier(0.34, 1.3, 0.64, 1);
  }
  .au-card:hover { transform: scale(1.03); }

  /* dark media card: image with a fade into the card's own black */
  .au-card-dark { background: #04080F; color: var(--color-sheet); }
  .au-card-media {
    position: relative;
    height: 240px;
    overflow: hidden;
  }
  @media (min-width: 768px) { .au-card-media { height: 230px; } }
  .au-card-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms var(--ease);
  }
  .au-card-dark:hover .au-card-media img { transform: scale(1.05); }
  .au-fade {
    position: absolute;
    inset: auto 0 0 0;
    height: 128px;
    background: linear-gradient(to top, #04080F, rgb(4 8 15 / 0.7), transparent);
  }
  .au-card-body { padding: 24px; }
  .au-card-body h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--color-sheet);
  }
  .au-card-body p {
    margin-top: 8px;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: rgb(245 247 249 / 0.6);
  }
  /* the import's outline button */
  .au-outline {
    display: inline-block;
    margin-top: 16px;
    padding: 8px 16px;
    border: 1px solid var(--color-sheet);
    border-radius: 8px;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-sheet);
    text-decoration: none;
    transition: background-color 180ms var(--ease), color 180ms var(--ease);
  }
  .au-outline:hover { background: var(--color-sheet); color: var(--color-ink); }

  /* overlay image card */
  .au-card-overlay img {
    display: block;
    width: 100%;
    min-height: 220px;
    object-fit: cover;
  }
  @media (min-width: 640px) { .au-card-overlay img { min-height: 240px; } }
  .au-overlay {
    position: absolute;
    inset: auto 0 0 0;
    padding: 24px;
    background: linear-gradient(to top, rgb(4 8 15 / 0.85), rgb(4 8 15 / 0.4), transparent);
    color: var(--color-sheet);
  }
  .au-overlay h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
  }
  .au-overlay p {
    margin-top: 8px;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: rgb(245 247 249 / 0.85);
  }

  /* ---------------- the journey ---------------- */
  .au-journey { padding-block: 0 120px; }
  .au-steps {
    list-style: none;
    margin: 64px 0 0;
    padding: 0;
    position: relative;
    display: grid;
    gap: 24px;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 900px) {
    .au-steps { grid-template-columns: repeat(3, 1fr); }
    /* the connecting line the steps sit on */
    .au-steps::before {
      content: "";
      position: absolute;
      top: 46px;
      left: 24px;
      right: 24px;
      height: 1px;
      background: rgb(245 247 249 / 0.14);
    }
  }
  .au-step {
    position: relative;
    padding: 24px;
    border-radius: 12px;
    background: rgb(245 247 249 / 0.03);
    transition: transform 320ms cubic-bezier(0.34, 1.3, 0.64, 1), background-color 220ms var(--ease);
  }
  .au-step:hover { transform: scale(1.03); background: rgb(245 247 249 / 0.06); }
  .au-step-n {
    display: inline-grid;
    place-items: center;
    position: relative;
    z-index: 1;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--color-ink-deep);
    border: 1px solid rgb(77 124 255 / 0.5);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--color-cobalt-lift);
  }
  /* the arrival panel: full width beneath the three, cobalt-washed */
  .au-step-final {
    margin-top: 24px;
    padding: clamp(28px, 3vw, 44px);
    background: rgb(29 78 216 / 0.12);
    border: 1px solid rgb(77 124 255 / 0.35);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px 40px;
    flex-wrap: wrap;
  }
  .au-final-lead {
    display: flex;
    align-items: flex-start;
    gap: 24px;
    min-width: 0;
    flex: 1 1 480px;
  }
  .au-step-n-final {
    width: 56px;
    height: 56px;
    font-size: 1.0625rem;
    background: var(--color-cobalt);
    border-color: var(--color-cobalt);
    color: #fff;
    flex: none;
  }
  .au-step-final h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.375rem, 1.8vw, 1.875rem);
    color: var(--color-sheet);
  }
  .au-step-final p {
    margin-top: 10px;
    font-size: 1.125rem;
    line-height: 1.65;
    color: rgb(245 247 249 / 0.75);
    max-width: 52em;
  }
  .au-final-chip { flex: none; }
  .au-step h3 {
    margin-top: 18px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1875rem;
    color: var(--color-sheet);
  }
  .au-step p {
    margin-top: 8px;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: rgb(245 247 249 / 0.6);
  }
</style>
