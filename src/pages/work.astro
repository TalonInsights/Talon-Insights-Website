  .wk-ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; margin-top: 36px; }
  .wk-ghost { color: var(--color-sheet); border-color: rgb(245 247 249 / 0.3); }
  .wk-ghost:hover { border-color: var(--color-sheet); }
  .wk-reply { margin-top: 20px; font-size: 0.9375rem; letter-spacing: 0.12em; color: rgb(245 247 249 / 0.45); }

  @media (max-width: 899.98px) {
    .wk-hero { padding-block: 110px 64px; }
    .wk-case, .wk-pattern { padding-block: 64px; }
    .wk-story { margin-top: 48px; }
  }
</style>

<script>
  /* Import #12's mechanic, hand-rolled: pointer drag (and keyboard
     arrows) drive --pos, which clips the before layer and places the
     divider. One handler wires every slider on the page. */
  document.querySelectorAll<HTMLElement>("[data-compare]").forEach((el) => {
    let dragging = false;
    const set = (clientX: number) => {
      const r = el.getBoundingClientRect();
      const pct = Math.max(0, Math.min(100, ((clientX - r.left) / r.width) * 100));
      el.style.setProperty("--pos", pct + "%");
      el.setAttribute("aria-valuenow", String(Math.round(pct)));
    };
    el.addEventListener("pointerdown", (e) => {
      dragging = true;
      el.setPointerCapture(e.pointerId);
      set(e.clientX);
    });
    el.addEventListener("pointermove", (e) => { if (dragging) set(e.clientX); });
    el.addEventListener("pointerup", () => { dragging = false; });
    el.addEventListener("pointercancel", () => { dragging = false; });
    el.addEventListener("keydown", (e) => {
      const now = Number(el.getAttribute("aria-valuenow") || 50);
      if (e.key === "ArrowLeft" || e.key === "ArrowRight") {
        e.preventDefault();
        const next = Math.max(0, Math.min(100, now + (e.key === "ArrowRight" ? 5 : -5)));
        el.style.setProperty("--pos", next + "%");
        el.setAttribute("aria-valuenow", String(next));
      }
    });
  });
</script>
