  /* ---------------- pattern + honest + close ---------------- */
  .wk-h2c {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.875rem, 2.6vw, 3rem);
    line-height: 1.12;
    letter-spacing: -0.015em;
    color: var(--color-sheet);
    text-align: center;
    margin-inline: auto;
    max-width: 24em;
  }
  .wk-pattern {
    padding-block: 96px;
    border-top: 1px solid rgb(245 247 249 / 0.1);
  }
  .wk-prose { margin-top: 28px; }
  .wk-prose p {
