  /* ---------------- the slider (import #12, recoloured) ---------------- */
  .wk-compare {
    position: relative;
    aspect-ratio: 1880 / 930;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgb(245 247 249 / 0.16);
    cursor: ew-resize;
    user-select: none;
    touch-action: none;
    --pos: 50%;
