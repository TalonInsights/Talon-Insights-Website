  .wk-wrap {
    max-width: 1560px;
    margin-inline: auto;
    padding-inline: 24px;
  }

  /* ---------------- hero ---------------- */
  .wk-hero { padding-block: 150px 88px; text-align: center; }
  .wk-h1 {
    margin-top: 14px;
    margin-inline: auto;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.5rem, 3.8vw, 4.75rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-sheet);
    max-width: 18em;
  }
  .wk-lede {
    margin: 26px auto 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.375rem, 1.7vw, 1.875rem);
    line-height: 1.5;
    letter-spacing: -0.01em;
    color: rgb(245 247 249 / 0.55);
    max-width: 34em;
  }
  .wk-lede em { font-style: normal; color: var(--color-cobalt-lift); }
  .wk-lede strong { font-weight: 600; color: var(--color-sheet); }

  /* ---------------- case sections ---------------- */
  .wk-case {
    padding-block: 88px;
    border-top: 1px solid rgb(245 247 249 / 0.1);
  }
  .wk-meta {
    text-align: center;
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: rgb(245 247 249 / 0.6);
    margin-bottom: 40px;
