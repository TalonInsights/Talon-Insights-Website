---
// /process — the five steps as a proper page (28 Aug, owner: "make it a
// proper html page, not a hashtag"). The homepage's B7 gantt component
// mounts here unchanged — same schedule, same milestone, same cross-
// light — under a page head, with the ask beneath. Links that pointed
// at /#process (pricing, about, footer) now land here.
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Process from "../components/Process.astro";
import Footer from "../components/Footer.astro";
---

<Base
  title="Process — Talon Insights"
  description="The five steps from first call to handover: free visits, directions before code, one fixed written price before the build starts, and everything yours at the end."
  path="/process"
  schema={{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebPage",
        "@id": "https://taloninsights.co.uk/process#page",
        url: "https://taloninsights.co.uk/process",
        name: "Process — Talon Insights",
        about: { "@id": "https://taloninsights.co.uk/#business" },
      },
      {
        "@type": "HowTo",
        "@id": "https://taloninsights.co.uk/process#steps",
        name: "The five steps from first call to handover",
        description:
          "How a Talon Insights project runs: a free call, free time on site, real design directions, a build against milestones, and everything yours at the end — with the price fixed before the build starts.",
        step: [
          { "@type": "HowToStep", position: 1, name: "A call", text: "Fifteen minutes to see whether it’s worth going further. Free." },
          { "@type": "HowToStep", position: 2, name: "Time on site", text: "Time spent where you work, at your events, with your customers — writing down how you work and the words they use. Free." },
          { "@type": "HowToStep", position: 3, name: "Directions", text: "Two or three real design directions. You pick, and you pull them apart." },
          { "@type": "HowToStep", position: 4, name: "Build", text: "Milestones against real dates, with the line open for ideas throughout. The price is fixed in writing before this stage begins." },
          { "@type": "HowToStep", position: 5, name: "Yours", text: "Domain, code and content are yours on full payment, plus a warranty period." },
        ],
      },
      {
        "@type": "BreadcrumbList",
        "@id": "https://taloninsights.co.uk/process#crumbs",
        itemListElement: [
          { "@type": "ListItem", position: 1, name: "Home", item: "https://taloninsights.co.uk/" },
          { "@type": "ListItem", position: 2, name: "Process", item: "https://taloninsights.co.uk/process" },
        ],
      },
    ],
  }}
>
  <Header />
  <main class="pc">
    <header class="pc-head">
      <div class="pc-wrap">
        <p class="t-micro eyebrow">PROCESS</p>
        <h1 class="pc-h1">Five steps, no surprises.</h1>
        <p class="pc-lede">
          The whole engagement on one schedule — <em>undated on purpose</em>, because
          the proportions are the promise. <strong>The price is fixed before the
          build bar begins.</strong>
        </p>
      </div>
    </header>

    <Process />

    <section class="pc-close">
      <div class="pc-wrap">
        <div class="pc-ctas">
          <a class="btn btn-primary" href="/booking">Book a visit</a>
          <a class="btn btn-ghost pc-ghost" href="/pricing">See the pricing</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .pc { background: var(--color-ink-deep); }
  .pc-wrap {
    max-width: 1560px;
    margin-inline: auto;
    padding-inline: 24px;
  }
  .pc-head { padding-top: 140px; }
  .pc-h1 {
    margin-top: 14px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.5rem, 3.4vw, 4.25rem);
    line-height: 1.06;
    letter-spacing: -0.02em;
    color: var(--color-sheet);
  }
  .pc-lede {
    margin-top: 22px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.375rem, 1.6vw, 1.75rem);
    line-height: 1.55;
    letter-spacing: -0.01em;
    color: rgb(245 247 249 / 0.55);
    max-width: 34em;
  }
  .pc-lede em { font-style: normal; color: var(--color-cobalt-lift); }
  .pc-lede strong { font-weight: 600; color: var(--color-sheet); }

  /* the mounted section brings its own border-top; ease the seam */
  .pc-head { padding-bottom: 56px; }

  .pc-close { padding-block: 8px 120px; }
  .pc-ctas { display: flex; flex-wrap: wrap; gap: 14px; }
  .pc-ghost { color: var(--color-sheet); border-color: rgb(245 247 249 / 0.3); }
  .pc-ghost:hover { border-color: var(--color-sheet); }
</style>
