---
// The homepage — Master Build v3.5, block by block:
// Header · B1 Hero · B2 Proof · B3 Faults · B4 Method · B5 Services ·
// B6 Case study · B7 Process · B10 merged into B11 (27 Aug, owner: map
// joins the booking close — form left, map right) · B8 Pricing (withdrawn 27 Aug, owner:
// undercuts the bespoke positioning — component kept for a future
// portrayal) · B9 About · B10 Map ·
// B11 Close · Footer.
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import ProofStrip from "../components/ProofStrip.astro";
import FaultList from "../components/FaultList.astro";
import Method from "../components/Method.astro";
import Services from "../components/Services.astro";
import CaseStudy from "../components/CaseStudy.astro";
import Process from "../components/Process.astro";
import About from "../components/About.astro";
import Close from "../components/Close.astro";
import Footer from "../components/Footer.astro";
---

<Base
  title="Talon Insights — Websites & Software, Telford"
  description="You're a specialist. Your website isn't. Websites and software built from repeated in-person visits to West Midlands businesses — designed with you, owned by you outright."
  schema={{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "ProfessionalService",
        "@id": "https://taloninsights.co.uk/#business",
        name: "Talon Insights",
        description:
          "Websites and custom software for specialist businesses, built from repeated in-person visits — one person, start to finish.",
        url: "https://taloninsights.co.uk/",
        telephone: "+447742082423",
        email: "taloninsights@gmail.com",
        image: "https://taloninsights.co.uk/og-card.png",
        founder: { "@type": "Person", name: "Talon Herring" },
        address: {
          "@type": "PostalAddress",
          addressLocality: "Telford",
          addressRegion: "Shropshire",
          addressCountry: "GB",
        },
        areaServed: [
          "Telford", "Shrewsbury", "Wolverhampton", "Birmingham",
          "Stafford", "Worcester", "Shropshire", "West Midlands",
        ],
      },
      {
        "@type": "WebSite",
        "@id": "https://taloninsights.co.uk/#website",
        url: "https://taloninsights.co.uk/",
        name: "Talon Insights",
        publisher: { "@id": "https://taloninsights.co.uk/#business" },
      },
    ],
  }}
>
  <Header />
  <main>
    <Hero />
    <ProofStrip />
    <FaultList />
    <Method />
    <Services />
    <CaseStudy />
    <Process />
    <About />
    <Close />
  </main>
  <Footer />
</Base>
