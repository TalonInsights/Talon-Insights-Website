---
// /pricing — the portrayal review B8's withdrawal promised (28 Aug,
// owner: "add a new webpage called pricing"). The homepage table was
// pulled for undercutting the bespoke positioning; this page keeps the
// spec's numbers but frames them the way the service works: the price
// comes from the visit, gets fixed in writing before the build, and the
// figures below are honest starting anchors, not a menu. Built in the
// approved subpage language (the about page's import look): flat ink,
// wide measure, rounded cards, statement text, three-tone ledes.
// Plan data verbatim from the withdrawn Pricing.astro (spec §6/B8).
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const plans = [
  {
    name: "Websites",
    label: "FROM",
    price: "£3,000",
    per: "",
    features: [
      "Designed with you, from real visits",
      "Directions before code",
      "The Word Survey included",
      "You own domain, code and content",
    ],
    struck: "Templates and page builders",
  },
  {
    name: "Custom software",
    label: "FROM",
    price: "£6,000",
    per: "",
    features: [
      "Built round your actual workflow",
      "Real database, proper sign-in",
      "Warranty after launch",
    ],
    struck: "Licences you rent forever",
  },
  {
    name: "Local SEO",
    label: "FROM",
    price: "£450",
    per: "/mo",
    features: [
      "Google Business Profile done right",
      "Local citations and content",
      "Honest monthly reporting",
    ],
    struck: "Lock-in contracts",
  },
  {
    name: "Research & strategy",
    label: "PRICED",
    price: "Per job",
    per: "",
    features: [
      "Competitor and market analysis",
      "Modelling with stated assumptions",
      "Written up to act on",
    ],
    struck: "Opinion dressed as data",
  },
];

const how = [
  { n: "01", h: "The call and the visits", p: "Fifteen minutes to see whether it’s worth going further, then time where you work. All of it free — the price is built from what I learn there." },
  { n: "02", h: "The directions", p: "Two or three real design directions before any code. You pick one and pull it apart — so the quote describes the thing you actually chose." },
  { n: "03", h: "The price, fixed", p: "A written scope with one figure and milestones against real dates — before the build starts. If it isn’t in writing, you don’t pay it." },
];
---

<Base
  title="Pricing — Talon Insights"
  description="How Talon Insights pricing works: free visits, directions before code, then one fixed written price before the build starts. Websites from £3,000, software from £6,000."
  path="/pricing"
  schema={{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebPage",
        "@id": "https://taloninsights.co.uk/pricing#page",
        url: "https://taloninsights.co.uk/pricing",
        name: "Pricing — Talon Insights",
        about: { "@id": "https://taloninsights.co.uk/#business" },
      },
      {
        "@type": "OfferCatalog",
        "@id": "https://taloninsights.co.uk/pricing#offers",
        name: "Talon Insights services",
        itemListElement: [
          { "@type": "Offer", name: "Websites", price: "3000", priceCurrency: "GBP", description: "Starting price — every job is quoted fixed, in writing, from the visit." },
          { "@type": "Offer", name: "Custom software", price: "6000", priceCurrency: "GBP", description: "Starting price — internal tools built round the workflow, fixed quote in writing." },
          { "@type": "Offer", name: "Local SEO", price: "450", priceCurrency: "GBP", description: "Starting monthly price — no lock-in contracts." },
          { "@type": "Offer", name: "Research & strategy", description: "Priced per engagement." },
        ],
      },
    ],
  }}
>
  <Header />
  <main class="pr">
    <div class="pr-wrap">

      <!-- ---------------- head ---------------- -->
      <header class="pr-head">
        <p class="t-micro eyebrow">PRICING</p>
        <h1 class="pr-h1">You know the price before the build&nbsp;starts.</h1>
        <p class="pr-lede">
          Nothing here is a menu. <em>Every job is priced from the visit</em> — then
          fixed in writing before a line of code.
          <strong>The figures below are honest starting points.</strong>
        </p>
      </header>

      <!-- ---------------- how the price happens ---------------- -->
      <ol class="pr-how">
        {how.map((step) => (
          <li class="pr-how-step">
            <span class="pr-how-n">{step.n}</span>
            <h2>{step.h}</h2>
            <p>{step.p}</p>
          </li>
        ))}
      </ol>

      <!-- ---------------- the anchors ---------------- -->
      <div class="pr-plans">
        {plans.map((plan) => (
          <article class="pr-plan">
            <h3>{plan.name}</h3>
            <p class="pr-price">
              <span class="t-mono pr-price-label">{plan.label}</span>
              <span class="pr-price-fig">{plan.price}</span>
              {plan.per && <span class="pr-price-per t-mono">{plan.per}</span>}
            </p>
            <ul>
              {plan.features.map((f) => (
                <li><i aria-hidden="true">◆</i>{f}</li>
              ))}
            </ul>
            <p class="pr-struck">{plan.struck}</p>
          </article>
        ))}
      </div>

      <!-- ---------------- always included ---------------- -->
      <div class="pr-always">
        <p class="t-mono pr-trust">FIXED PRICE<i>◆</i>WRITTEN SCOPE<i>◆</i>YOU OWN EVERYTHING</p>
        <p class="pr-always-line">
          Every job, whatever the size: a warranty after launch, the line open for
          ideas all the way through, and the domain, code and content yours on
          full&nbsp;payment.
        </p>
        <div class="pr-ctas">
          <a class="btn btn-primary" href="/booking">Book a visit</a>
          <a class="btn btn-ghost pr-ghost" href="/process">See the five steps</a>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .pr { background: var(--color-ink-deep); }
  .pr-wrap {
    max-width: 1560px;
    margin-inline: auto;
    padding-inline: 24px;
  }

  /* ---------------- head ---------------- */
  .pr-head { padding-top: 140px; max-width: 60em; }
  .pr-h1 {
    margin-top: 14px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.5rem, 3.4vw, 4.25rem);
    line-height: 1.06;
    letter-spacing: -0.02em;
    color: var(--color-sheet);
  }
  /* the three-tone lede voice from /about */
  .pr-lede {
    margin-top: 22px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.375rem, 1.6vw, 1.75rem);
    line-height: 1.55;
    letter-spacing: -0.01em;
    color: rgb(245 247 249 / 0.55);
    max-width: 34em;
  }
  .pr-lede em { font-style: normal; color: var(--color-cobalt-lift); }
  .pr-lede strong { font-weight: 600; color: var(--color-sheet); }

  /* ---------------- how ---------------- */
  .pr-how {
    list-style: none;
    margin: 72px 0 0;
    padding: 0;
    position: relative;
    display: grid;
    gap: 24px;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 900px) {
    .pr-how { grid-template-columns: repeat(3, 1fr); }
    .pr-how::before {
      content: "";
      position: absolute;
      top: 46px;
      left: 24px;
      right: 24px;
      height: 1px;
      background: rgb(245 247 249 / 0.14);
    }
  }
  .pr-how-step {
    position: relative;
    padding: 24px;
    border-radius: 12px;
    background: rgb(245 247 249 / 0.03);
    transition: transform 320ms cubic-bezier(0.34, 1.3, 0.64, 1), background-color 220ms var(--ease);
  }
  .pr-how-step:hover { transform: scale(1.03); background: rgb(245 247 249 / 0.06); }
  .pr-how-n {
    display: inline-grid;
    place-items: center;
    position: relative;
    z-index: 1;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--color-ink-deep);
    border: 1px solid rgb(77 124 255 / 0.5);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--color-cobalt-lift);
  }
  .pr-how-step:last-child .pr-how-n {
    background: var(--color-cobalt);
    border-color: var(--color-cobalt);
    color: #fff;
  }
  .pr-how-step h2 {
    margin-top: 18px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.375rem;
    color: var(--color-sheet);
  }
  .pr-how-step p {
    margin-top: 10px;
    font-size: 1.125rem;
    line-height: 1.65;
    color: rgb(245 247 249 / 0.72);
  }

  /* ---------------- the anchors ---------------- */
  .pr-plans {
    margin-top: 88px;
    display: grid;
    gap: 24px;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  @media (max-width: 1199.98px) { .pr-plans { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 639.98px) { .pr-plans { grid-template-columns: 1fr; } }
  .pr-plan {
    display: flex;
    flex-direction: column;
    padding: 28px;
    border-radius: 12px;
    background: rgb(245 247 249 / 0.03);
    border: 1px solid rgb(245 247 249 / 0.1);
    transition: transform 320ms cubic-bezier(0.34, 1.3, 0.64, 1), border-color 220ms var(--ease);
  }
  .pr-plan:hover { transform: scale(1.03); border-color: rgb(77 124 255 / 0.45); }
  .pr-plan h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.375rem;
    color: var(--color-sheet);
  }
  .pr-price {
    margin-top: 14px;
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .pr-price-label {
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--color-cobalt-lift);
  }
  .pr-price-fig {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 2rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-sheet);
  }
  .pr-price-per { font-size: 1rem; color: rgb(245 247 249 / 0.55); }
  .pr-plan ul {
    list-style: none;
    margin: 20px 0 0;
    padding: 18px 0 0;
    border-top: 1px solid rgb(245 247 249 / 0.1);
    display: grid;
    gap: 10px;
    flex: 1;
  }
  .pr-plan li {
    display: flex;
    gap: 10px;
    align-items: baseline;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: rgb(245 247 249 / 0.75);
  }
  .pr-plan li i {
    font-style: normal;
    font-size: 0.5625rem;
    color: rgb(77 124 255 / 0.8);
  }
  .pr-struck {
    margin-top: 18px;
    font-size: 1rem;
    color: rgb(245 247 249 / 0.4);
    text-decoration: line-through;
  }

  /* ---------------- always ---------------- */
  .pr-always {
    margin-block: 96px 0;
    padding: clamp(32px, 4vw, 56px);
    border-radius: 12px;
    background: rgb(29 78 216 / 0.12);
    border: 1px solid rgb(77 124 255 / 0.35);
    text-align: center;
  }
  .pr-trust {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: rgb(245 247 249 / 0.8);
  }
  .pr-trust i {
    font-style: normal;
    margin-inline: 12px;
    font-size: 0.625rem;
    vertical-align: 1px;
    color: rgb(77 124 255 / 0.8);
  }
  .pr-always-line {
    margin: 16px auto 0;
    max-width: 44em;
    font-size: 1.25rem;
    line-height: 1.65;
    color: rgb(245 247 249 / 0.78);
  }
  .pr-ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; margin-top: 32px; }
  .pr-ghost { color: var(--color-sheet); border-color: rgb(245 247 249 / 0.3); }
  .pr-ghost:hover { border-color: var(--color-sheet); }

  .pr-wrap { padding-bottom: 120px; }

  @media (max-width: 899.98px) {
    .pr-head { padding-top: 110px; }
    .pr-how { margin-top: 56px; }
    .pr-plans { margin-top: 64px; }
    .pr-always { margin-top: 72px; }
  }
</style>
