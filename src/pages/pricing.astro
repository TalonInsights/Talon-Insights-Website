<script>
  /* Import #11's scroll choreography, hand-rolled: within the tall deck
     section, progress maps each card (after the first) from off-screen
     right to its shingled stack position — 64px per index, the import's
     own offset. Plain script; the stacked fallback above never runs it. */
  const scroller = document.querySelector<HTMLElement>(".pz-deck-scroll");
  const deckCards = Array.from(document.querySelectorAll<HTMLElement>(".pz-card"));
  if (
    scroller && deckCards.length &&
    matchMedia("(min-width: 900px)").matches &&
    !matchMedia("(prefers-reduced-motion: reduce)").matches
  ) {
    const n = deckCards.length;
    const deck = document.querySelector<HTMLElement>(".pz-deck");
    const cue = document.querySelector<HTMLElement>(".pz-deck-cue");
    let ticking = false;
    const paint = () => {
      ticking = false;
      const rect = scroller.getBoundingClientRect();
      const total = rect.height - window.innerHeight;
      const progress = Math.min(1, Math.max(0, -rect.top / total));
      const w = deckCards[0].offsetWidth;
      /* centre the FINAL composition: one card + the shingled rails sit
         symmetric in the viewport (owner) */
      const stackW = w + 64 * (n - 1);
      if (deck) deck.style.paddingLeft = Math.max(24, (window.innerWidth - stackW) / 2) + "px";
      deckCards.forEach((card, i) => {
        if (i === 0) return;
        const start = i / n;
        const end = start + 1 / n;
        const t = Math.min(1, Math.max(0, (progress - start) / (end - start)));
        const from = window.innerWidth;
        const to = -(w * i) + 64 * i;
        card.style.transform = `translateX(${from + (to - from) * t}px)`;
      });
      /* the cue teaches the gesture, then leaves once the deck is dealt */
      cue?.classList.toggle("is-done", progress > 0.92);
    };
    window.addEventListener("scroll", () => {
      if (!ticking) { ticking = true; requestAnimationFrame(paint); }
    }, { passive: true });
    window.addEventListener("resize", paint);
    paint();
  }
</script>
