---
// /pricing — full rebuild to the owner's long-form copy (28 Aug), styling
// pulled from 21st per instruction: import #11 is youcefbnm's Process
// Timeline (demo 1943) — the scroll-pinned horizontal card deck — carrying
// Section 02, its indigo language recoloured to the scheme's cobalt; the
// money grid and the questions wear the approved ruixen card language;
// the accordion is native <details> (zero-dep, accessible) in the same
// skin. Colours are the site's only: ink-deep, the deep close black,
// sheet, cobalt/cobalt-lift. The deck's scroll choreography is a plain
// hashed script (no framer, per §7); stacked + static under 900px and
// reduced motion. Copy verbatim from the owner's document, including the
// recommended range line (flagged for their veto).
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const steps = [
  { n: "01", key: "THE CALL", h: "A call. Free.", p: "Fifteen minutes. What you do, what’s wrong with the site you’ve got, what you’re hoping changes. If it’s obviously not a fit, I’ll say so on that call rather than waste a visit." },
  { n: "02", key: "ON SITE", h: "Time on site. Free.", p: "I come to you. How the work gets done, what your customers say about you, the words they use. Usually more than one visit, because the useful things surface late." },
  { n: "03", key: "THE SCOPE", h: "A written scope. Free.", p: "Everything the job includes, in plain English, on paper. Pages, functionality, who provides what, how long it takes. You read it. You disagree with parts of it. We change them." },
  { n: "04", key: "THE PRICE", h: "A fixed price against that scope.", p: "One number, in writing, attached to a specific document. Not a range. Not an estimate. Not “starting from.”" },
  { n: "05", key: "YOURS TO KEEP", h: "You decide.", p: "The scope is yours to keep either way. If you take it to somebody else and get it built cheaper, that’s a legitimate outcome and I’d rather that than talk you into something." },
];

const money = [
  { h: "The visits", p: "Time on site, more than once. This is the part nobody else does and it’s the reason the site ends up being about you rather than about your category." },
  { h: "The Word Survey", p: "The phrases your customers actually use, including the ones nobody in your area is competing for. Listed in your scope, built into the site from day one." },
  { h: "Real directions", p: "Two or three genuinely different designs before a line of code is written. You choose. You pull them apart. We go again if neither is right." },
  { h: "The build", p: "Designed and coded from scratch. Fast, accessible, works properly on a phone, and built so search engines can find it." },
  { h: "The open line", p: "Message me during the build, whenever, with whatever. There’s nobody in between — you get the person doing the work." },
  { h: "Ownership", p: "Domain, code, content and accounts are yours on final payment. If you leave, you take everything. There is no version of working with me that leaves you stuck." },
];

const faqs = [
  { q: "Isn’t “no upfront price” just a way of charging more?", a: "The opposite, usually. Firms that quote blind price defensively — they pad the number to cover what they haven’t seen. I’ve seen the job before I price it, so there’s nothing to pad against." },
  { q: "What if the scope is wrong?", a: "Then we fix it before it’s signed, which is why you read it and argue with it. That’s the entire purpose of putting it in writing rather than describing it on a call." },
  { q: "What if I don’t like the designs?", a: "You see two or three, and if none is right we go again. The directions stage exists so that “I don’t like it” happens in week two rather than week eight." },
  { q: "Do you take deposits?", a: "Yes — a deposit on signing, then payments against milestones, with the balance on handover. All of it stated in the scope before you commit to anything." },
  { q: "What if I go elsewhere after the visits?", a: "Then you go elsewhere, and you keep the written scope. It cost you nothing and it’s a genuinely useful document to hand to whoever you use instead. I’d rather be the person who was straight with you than the person who tied you in." },
  { q: "Is this going to be expensive?", a: "It’s more than a template and less than an agency, because there’s no account manager, no office and no junior doing the work. What you’re paying for is the visits and the person building it being the same person you met." },
];
---

<Base
  title="Pricing — Talon Insights"
  description="Why nobody can honestly price your website upfront — and how you still get one fixed number, in writing, before anything is built. Free visits, a written scope, no moving figures."
  path="/pricing"
  ogImage="/og-pricing.png"
  ogAlt="One number, in writing — the price is fixed before the build starts."
  schema={{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebPage",
        "@id": "https://taloninsights.co.uk/pricing#page",
        url: "https://taloninsights.co.uk/pricing",
        name: "Pricing — Talon Insights",
        about: { "@id": "https://taloninsights.co.uk/#business" },
      },
      {
        "@type": "FAQPage",
        "@id": "https://taloninsights.co.uk/pricing#faq",
        mainEntity: faqs.map((f) => ({
          "@type": "Question",
          name: f.q,
          acceptedAnswer: { "@type": "Answer", text: f.a },
        })),
      },
      {
        "@type": "BreadcrumbList",
        "@id": "https://taloninsights.co.uk/pricing#crumbs",
        itemListElement: [
          { "@type": "ListItem", position: 1, name: "Home", item: "https://taloninsights.co.uk/" },
          { "@type": "ListItem", position: 2, name: "Pricing", item: "https://taloninsights.co.uk/pricing" },
        ],
      },
    ],
  }}
>
  <Header />
  <main class="pz">

    <!-- ---------------- HERO ---------------- -->
    <section class="pz-hero">
      <div class="pz-wrap">
        <p class="t-micro eyebrow">PRICING</p>
        <h1 class="pz-h1">
          I can’t price your website today.
          <span class="pz-dim">Neither can anyone else.</span>
        </h1>
        <p class="pz-lede">
          They just don’t tell you that. A number given before anyone has seen how you
          work is <em>a guess dressed as a quote</em> — and guesses get corrected
          later, <strong>upwards.</strong>
        </p>
      </div>
    </section>

    <!-- ---------------- 01 · THE ARGUMENT ---------------- -->
    <section class="pz-argument">
      <div class="pz-wrap">
        <h2 class="pz-h2">Only template agencies can price a website&nbsp;upfront.</h2>
        <p class="pz-pull">That isn’t a criticism of them. It’s arithmetic.</p>
        <div class="pz-prose pz-prose-grid">
          <p>
            If every site is the same site with different colours, the price is knowable
            in advance, because the work is knowable in advance. Three hundred pounds, or
            three thousand, for the same theme with your logo on it. Fair enough — and if
            that’s what you want, there are plenty of people who’ll do it well.
          </p>
          <p>
            But you’re not buying a theme. You’re buying a site built from how your
            business actually works: what you make, who chooses you and why, the words
            your customers use, the things you do that nobody else in your area does.
            None of that is visible from a price list. Most of it isn’t visible from a
            phone call.
          </p>
          <p>
            So a firm quoting you before they’ve been to see you is doing one of two
            things. Either they’re selling you something standard, or they’re guessing —
            and a guess that turns out low doesn’t get absorbed. It gets recovered, in
            extras, in change requests, in the things you assumed were included.
          </p>
          <p class="pz-prose-land">
            I’d rather find out what the job is, then tell you what it costs, and then
            not&nbsp;move.
          </p>
        </div>
      </div>
    </section>

    <!-- ---------------- 02 · HOW IT ACTUALLY WORKS — the deck ---------------- -->
    <section class="pz-deck-scroll" id="deck">
      <div class="pz-deck-sticky">
        <div class="pz-wrap">
          <h2 class="pz-h2 pz-deck-h">
            You’ll have a number before anything is built.
            <span class="pz-dim">It just isn’t the first thing.</span>
          </h2>
        </div>
        <p class="pz-deck-cue t-mono" aria-hidden="true">KEEP SCROLLING<i>◆</i>EACH STEP STACKS ON THE LAST</p>
        <div class="pz-deck" aria-label="The five steps to a fixed price">
          {steps.map((s2) => (
            <article class="pz-card">
              <div class="pz-card-rail">
                <span class="pz-card-n">{s2.n}</span>
                <span class="pz-card-key t-mono">{s2.key}</span>
              </div>
              <div class="pz-card-body">
                <h3>{s2.h}</h3>
                <p>{s2.p}</p>
              </div>
            </article>
          ))}
        </div>
        <div class="pz-wrap">
          <p class="pz-deck-note">
            Everything up to step 04 costs nothing, and there’s no obligation at the end
            of it. The first time money is mentioned, you already know exactly what
            you’d be&nbsp;buying.
          </p>
          <p class="pz-deck-note pz-deck-note-sub">
            These are the steps to the number, not the whole job — the build itself,
            from design directions to handover, runs on its own schedule on
            the <a class="pz-inline-link" href="/process">process page</a>.
          </p>
        </div>
      </div>
    </section>

    <!-- ---------------- 03 · FIXED MEANS FIXED ---------------- -->
    <section class="pz-fixed">
      <div class="pz-wrap">
        <h2 class="pz-h2">Fixed means&nbsp;fixed.</h2>
        <div class="pz-prose">
          <p>
            The number attached to your scope is the number you pay. It doesn’t move
            because the job took longer than I thought, because something turned out
            harder than it looked, or because I underestimated. That risk is mine —
            that’s what pricing after the visits buys me, and it’s why I can carry it.
          </p>
        </div>
        <p class="pz-pull pz-pull-big">One thing changes the price: <em>you</em> changing the&nbsp;scope.</p>
        <div class="pz-prose pz-prose-grid">
          <p>
            If you decide halfway through that you want an online shop, or a booking
            system, or four more pages, that’s a different job to the one we agreed. It
            goes through a written variation: what’s being added, what it costs, what it
            does to the timeline. You sign it or you don’t. Nothing gets added quietly
            and appears on an invoice later.
          </p>
          <p>
            New ideas during the build are welcome — that’s the whole point of the open
            line, and most of the best things on the sites I’ve built arrived that way.
            Wanting them is not the same as being charged for them without being asked.
          </p>
        </div>
      </div>
    </section>

    <!-- ---------------- 04 · WHERE THE MONEY GOES ---------------- -->
    <section class="pz-money">
      <div class="pz-wrap">
        <h2 class="pz-h2">Where the money&nbsp;goes.</h2>
        <div class="pz-money-grid">
          {money.map((m) => (
            <article class="pz-money-card">
              <h3><i aria-hidden="true">◆</i>{m.h}</h3>
              <p>{m.p}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ---------------- 05 · WHAT I'LL TELL YOU EARLY ---------------- -->
    <section class="pz-early">
      <div class="pz-wrap">
        <div class="pz-early-panel">
          <h2 class="pz-h2">If you want a rough idea before committing to visits, ask on the&nbsp;call.</h2>
          <div class="pz-prose pz-prose-onpanel">
            <p>
              I won’t quote a number I can’t stand behind. But I will tell you, on that
              first fifteen minutes, whether what you’re describing is a small job or a
              large one, and roughly what range that puts you in — with the honest caveat
              that it’s a range, not a price, and it exists to save us both a wasted
              afternoon.
            </p>
            <p>
              What I won’t do is send you a figure by email an hour after we’ve spoken
              and call it a quote.
            </p>
          </div>
          <p class="pz-range t-mono">
            MOST WEBSITES I BUILD LAND BETWEEN £3,000 AND £8,000 · CUSTOM SOFTWARE STARTS HIGHER
          </p>
        </div>
      </div>
    </section>

    <!-- ---------------- 06 · AFTER LAUNCH ---------------- -->
    <section class="pz-after">
      <div class="pz-wrap">
        <h2 class="pz-h2">After&nbsp;launch.</h2>
        <div class="pz-after-grid">
          <div class="pz-prose">
            <p>
              Some clients want nothing further — the site is theirs, it works, that’s
              the end of it. That’s a perfectly good outcome and I don’t sell
              against&nbsp;it.
            </p>
            <p>
              Ongoing changes to the site itself are quoted job by job, or covered by
              the retainer if that’s how we’ve set it up. Either way, in writing, before
              the&nbsp;work.
            </p>
          </div>
          <div class="pz-prose">
            <p>
              Others want the territory maintained: the words kept current, the Google
              Business Profile looked after, new content as the business changes. That’s
              a monthly arrangement, priced against what’s actually being done,
              cancellable with a month’s notice. No twelve-month tie-in, ever —
              <a class="pz-inline-link" href="/#faults">Fault 02 exists for a reason</a>.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ---------------- 07 · FOUNDING PROJECTS ---------------- -->
    <section class="pz-founding" id="founding">
      <div class="pz-wrap">
        <div class="pz-founding-panel">
          <div>
            <h2 class="pz-h2">A reduced rate, for a&nbsp;reason.</h2>
            <div class="pz-prose pz-prose-onpanel">
              <p>
                Talon Insights is new. I’m taking on a small number of projects at a
                reduced rate in exchange for a written case study and a review — same
                scope, same standard, same fixed price guarantee.
              </p>
              <p>
                That’s a straightforward trade and I’d rather name it than dress it up:
                you get the work for less, I get proof that the work exists. When the
                case studies are written, the rate goes back&nbsp;up.
              </p>
            </div>
          </div>
          {/* [The /founding-projects link returns when that page is built —
              this panel is itself the explanation, so no link for now.] */}
        </div>
      </div>
    </section>

    <!-- ---------------- 08 · QUESTIONS ---------------- -->
    <section class="pz-faq">
      <div class="pz-wrap">
        <h2 class="pz-h2">Questions.</h2>
        <div class="pz-faq-list">
          {faqs.map((f) => (
            <details class="pz-q">
              <summary>
                <span>{f.q}</span>
                <i aria-hidden="true">+</i>
              </summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ---------------- CLOSE ---------------- -->
    <section class="pz-close">
      <div class="pz-wrap">
        <h2 class="pz-h2">Find out what it&nbsp;costs.</h2>
        <p class="pz-close-body">
          Start with fifteen minutes on the phone. If it sounds like a fit, I’ll come to
          you — and you’ll have a written scope and a fixed price before you’ve
          spent&nbsp;anything.
        </p>
        <div class="pz-ctas">
          <a class="btn btn-primary" href="/booking">Book a visit</a>
          <a class="btn btn-ghost pz-ghost" href="tel:+447742082423">Or call 07742 082423</a>
        </div>
        <p class="t-mono pz-reply">REPLY WITHIN ONE WORKING DAY</p>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .pz { background: var(--color-ink-deep); }
  .pz-wrap {
    max-width: 1560px;
    margin-inline: auto;
    padding-inline: 24px;
  }
  .pz-h2 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.875rem, 2.6vw, 3rem);
    line-height: 1.12;
    letter-spacing: -0.015em;
    color: var(--color-sheet);
    max-width: 24em;
    /* the whole page reads down a centred spine (owner) */
    margin-inline: auto;
    text-align: center;
  }
  .pz-dim { color: rgb(245 247 249 / 0.5); }

  /* the shared prose voice — statement-sized */
  .pz-prose p {
    margin-top: 20px;
    font-size: 1.25rem;
    line-height: 1.7;
    color: rgb(245 247 249 / 0.75);
    max-width: 42em;
    margin-inline: auto; /* blocks ride the centre spine; text stays left */
  }
  .pz-prose-land { color: var(--color-sheet) !important; font-weight: 500; }
  /* full-width variant (owner): paragraphs pair up across the wrap
     instead of queuing down a narrow column */
  .pz-prose-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px clamp(40px, 5vw, 96px);
    margin-top: 12px;
  }
  .pz-prose-grid p { margin-inline: 0; max-width: none; }
  @media (max-width: 899.98px) {
    .pz-prose-grid { grid-template-columns: 1fr; }
  }
  .pz-pull {
    margin-top: 26px;
    margin-inline: auto;
    text-align: center;
    max-width: 30em;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.25rem, 1.6vw, 1.75rem);
    color: var(--color-cobalt-lift);
  }
  .pz-pull-big {
    font-size: clamp(1.5rem, 2vw, 2.25rem);
    margin-block: 44px 8px;
    color: var(--color-sheet);
  }
  .pz-pull-big em { font-style: normal; color: var(--color-cobalt-lift); }
  .pz-inline-link {
    color: var(--color-cobalt-lift);
    text-decoration: none;
    border-bottom: 1px solid rgb(77 124 255 / 0.45);
    transition: color 180ms var(--ease), border-color 180ms var(--ease);
  }
  .pz-inline-link:hover { color: var(--color-sheet); border-color: rgb(245 247 249 / 0.5); }

  /* ---------------- hero ---------------- */
  .pz-hero { padding-block: 150px 96px; text-align: center; }
  .pz-h1 {
    margin-top: 14px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.5rem, 3.8vw, 4.75rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-sheet);
    max-width: 20em;
    margin-inline: auto;
  }
  .pz-h1 .pz-dim { display: block; }
  .pz-lede {
    margin-top: 26px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.375rem, 1.7vw, 1.875rem);
    line-height: 1.5;
    letter-spacing: -0.01em;
    color: rgb(245 247 249 / 0.55);
    max-width: 38em;
    margin-inline: auto;
  }
  .pz-lede em { font-style: normal; color: var(--color-cobalt-lift); }
  .pz-lede strong { font-weight: 600; color: var(--color-sheet); }

  /* ---------------- the argument ---------------- */
  .pz-argument {
    padding-block: 96px;
    border-top: 1px solid rgb(245 247 249 / 0.1);
  }

  /* ---------------- the deck (21st import #11, recoloured) ----------------
     The import's mechanic: a tall scroll region with a sticky viewport;
     card 0 stands, cards 1..n slide in from the right edge as scroll
     progresses, stacking with a 64px shingle. Its indigo radial ground
     and gradient cards arrive recoloured to the scheme's cobalt. */
  .pz-deck-scroll {
    position: relative;
    height: 420vh; /* 5 cards: 1 standing + 4 travelling */
    background: radial-gradient(30% 80% at 0% 70%,
      #1D4ED8 0%, #16368F 22.92%, #0B1F3A 42.71%, var(--color-ink-deep) 88.54%);
  }
  .pz-deck-sticky {
    position: sticky;
    top: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 40px;
    overflow: hidden;
    padding-block: 96px 64px;
  }
  .pz-deck-h { max-width: 20em; }
  .pz-deck-cue {
    text-align: center;
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: rgb(245 247 249 / 0.6);
    transition: opacity 400ms var(--ease);
  }
  .pz-deck-cue i {
    font-style: normal;
    margin-inline: 10px;
    color: rgb(77 124 255 / 0.8);
  }
  .pz-deck-cue.is-done { opacity: 0; }
  .pz-deck {
    display: flex;
    flex-wrap: nowrap;
    align-items: stretch;
    padding-left: max(24px, calc((100% - 1512px) / 2 + 24px));
  }
  .pz-card {
    display: flex;
    min-width: min(60%, 980px);
    max-width: min(60%, 980px);
    border: 1px solid rgb(245 247 249 / 0.16);
    border-radius: 4px;
    backdrop-filter: blur(12px);
    background: linear-gradient(135deg, rgb(6 14 28 / 0.7) 40%, #1D4ED8 120%);
    color: var(--color-sheet);
    will-change: transform;
  }
  .pz-card-rail {
    padding: 24px 20px;
    border-right: 1px solid rgb(245 247 249 / 0.16);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  /* the key runs down the rail, so a collapsed sliver still says what
     it is (owner: the stack needed explaining) */
  .pz-card-key {
    writing-mode: vertical-rl;
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: rgb(245 247 249 / 0.55);
    white-space: nowrap;
  }
  .pz-card-n {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-cobalt);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.9375rem;
    color: #fff;
  }
  .pz-card-body { padding: 24px 28px 28px; display: flex; flex-direction: column; gap: 14px; }
  .pz-card-body h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.375rem, 1.9vw, 2rem);
    line-height: 1.2;
  }
  .pz-card-body p {
    font-size: 1.1875rem;
    line-height: 1.65;
    color: rgb(245 247 249 / 0.8);
    max-width: 34em;
  }
  .pz-deck-note {
    font-size: 1.25rem;
    line-height: 1.65;
    color: rgb(245 247 249 / 0.8);
    max-width: 52em;
    margin-inline: auto;
    text-align: center;
  }
  /* the disambiguator: steps-to-the-number here, stages-of-the-job on
     /process — quieter than the note above it */
  .pz-deck-note-sub {
    margin-top: 12px;
    font-size: 1.0625rem;
    color: rgb(245 247 249 / 0.55);
  }

  /* ---------------- fixed / money / early / after ---------------- */
  .pz-fixed { padding-block: 110px 96px; }
  .pz-money { padding-block: 0 96px; }
  .pz-money-grid {
    margin-top: 44px;
    display: grid;
    gap: 24px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  @media (max-width: 1099.98px) { .pz-money-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 639.98px) { .pz-money-grid { grid-template-columns: 1fr; } }
  .pz-money-card {
    padding: 26px;
    border-radius: 12px;
    background: rgb(245 247 249 / 0.03);
    border: 1px solid rgb(245 247 249 / 0.1);
    transition: transform 320ms cubic-bezier(0.34, 1.3, 0.64, 1), border-color 220ms var(--ease);
  }
  .pz-money-card:hover { transform: scale(1.03); border-color: rgb(77 124 255 / 0.45); }
  .pz-money-card h3 {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.375rem;
    color: var(--color-sheet);
  }
  .pz-money-card h3 i { font-style: normal; font-size: 0.625rem; color: rgb(77 124 255 / 0.8); }
  .pz-money-card p {
    margin-top: 10px;
    font-size: 1.125rem;
